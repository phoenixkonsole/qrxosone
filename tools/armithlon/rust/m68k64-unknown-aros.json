{
  "llvm-target": "m68k64-unknown-aros",
  "arch": "m68k",
  "cpu": "M68040",
  "data-layout": "E-m:e-p:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-n8:16:32:64-a:0:16-S64",
  "target-endian": "big",
  "target-pointer-width": 64,
  "target-c-int-width": 32,
  "max-atomic-width": 64,
  "os": "aros",
  "vendor": "unknown",
  "env": "",
  "linker-flavor": "gnu-cc",
  "linker": "/opt/qrx-os-one/aros64/tc/bin/clang",
  "pre-link-args": { "gnu-cc": ["--sysroot", "/opt/qrx-os-one/aros64/build-qrx/bin/native-m68k64/AROS/Development"] },
  "executables": true,
  "dynamic-linking": false,
  "position-independent-executables": false,
  "static-position-independent-executables": false,
  "relocation-model": "static",
  "has-thread-local": false,
  "panic-strategy": "unwind",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "singlethread": false,
  "target-family": ["unix"],
  "metadata": {
    "description": "QRX OS One 64: 64-bit AROS on the 68100EC64 (long mode, LP64, no FPU)",
    "tier": 3,
    "host_tools": false,
    "std": false
  }
}
