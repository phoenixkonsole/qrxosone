+namespace {
+// m68k64 varargs: every argument takes an 8-byte stack slot, small ones at its high address.
+class M68k64ABIInfo : public DefaultABIInfo {
+public:
+  using DefaultABIInfo::DefaultABIInfo;
+  RValue EmitVAArg(CodeGenFunction &CGF, Address VAListAddr, QualType Ty,
+                   AggValueSlot Slot) const override {
+    return emitVoidPtrVAArg(CGF, VAListAddr, Ty, /*IsIndirect=*/false,
+                            getContext().getTypeInfoInChars(Ty),
+                            CharUnits::fromQuantity(8),
+                            /*AllowHigherAlign=*/true, Slot);
+  }
+};
+class M68k64TargetCodeGenInfo : public TargetCodeGenInfo {
+public:
+  M68k64TargetCodeGenInfo(CodeGenTypes &CGT)
+      : TargetCodeGenInfo(std::make_unique<M68k64ABIInfo>(CGT)) {}
+};
+} // namespace
+
 std::unique_ptr<TargetCodeGenInfo>
 CodeGen::createM68kTargetCodeGenInfo(CodeGenModule &CGM) {
+  if (CGM.getTriple().getArch() == llvm::Triple::m68k64)
+    return std::make_unique<M68k64TargetCodeGenInfo>(CGM.getTypes());
   return std::make_unique<M68kTargetCodeGenInfo>(CGM.getTypes());
 }
