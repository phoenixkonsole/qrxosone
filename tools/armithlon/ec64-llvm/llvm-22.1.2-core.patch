+  AROSTargetInfo(const llvm::Triple &Triple, const TargetOptions &Opts)
+      : OSTargetInfo<Target>(Triple, Opts) {
+      this->WCharType = TargetInfo::UnsignedInt;
+      this->WIntType = TargetInfo::UnsignedInt;
