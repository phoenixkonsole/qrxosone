+namespace __locale {
+
+// QRX OS One 64 (AROS): the "C" locale is the only one; a locale_t is a token for it, and switching
+// to it changes nothing. The *_l functions come from no_locale/ (they ignore the locale).
+struct __aros_locale {};
+using locale_t = __aros_locale*;
+inline __aros_locale __aros_c_locale;
+
+struct __locale_guard {
+  _LIBCPP_HIDE_FROM_ABI __locale_guard(locale_t&) {}
+  __locale_guard(__locale_guard const&)            = delete;
+  __locale_guard& operator=(__locale_guard const&) = delete;
+};
+
+#define _LIBCPP_COLLATE_MASK (1 << 0)
+#define _LIBCPP_CTYPE_MASK (1 << 1)
+#define _LIBCPP_MONETARY_MASK (1 << 2)
+#define _LIBCPP_NUMERIC_MASK (1 << 3)
+#define _LIBCPP_TIME_MASK (1 << 4)
+#define _LIBCPP_MESSAGES_MASK (1 << 5)
+#define _LIBCPP_ALL_MASK 0x3f
+#define _LIBCPP_LC_ALL LC_ALL
+
+using __locale_t _LIBCPP_NODEBUG = locale_t;
+
+#if defined(_LIBCPP_BUILDING_LIBRARY)
+using __lconv_t _LIBCPP_NODEBUG = std::lconv;
+
+inline _LIBCPP_HIDE_FROM_ABI __locale_t __newlocale(int, const char* __name, __locale_t) {
+  // only "C" and "POSIX" (and "", the environment's, which is "C" here)
+  if (__name && (!__name[0] || !std::strcmp(__name, "C") || !std::strcmp(__name, "POSIX")))
+    return &__aros_c_locale;
+  return nullptr;
+}
+
+inline _LIBCPP_HIDE_FROM_ABI void __freelocale(__locale_t) {}
+
+inline _LIBCPP_HIDE_FROM_ABI char* __setlocale(int __category, char const* __locale) {
+  return ::setlocale(__category, __locale);
+}
+
+inline _LIBCPP_HIDE_FROM_ABI __lconv_t* __localeconv(__locale_t& __loc) {
+  __locale_guard __current(__loc);
+  return std::localeconv();
+}
