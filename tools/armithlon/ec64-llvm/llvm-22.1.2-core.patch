+    _LIBUNWIND_ABORT("m68k64 has no floating point registers");
+  }
+  bool        validVectorRegister(int) const { return false; }
+  v128        getVectorRegister(int) const {
+    _LIBUNWIND_ABORT("m68k64 has no vector registers");
+  }
+  void        setVectorRegister(int, v128) {
+    _LIBUNWIND_ABORT("m68k64 has no vector registers");
+  }
+  static const char *getRegisterName(int num);
+  void        jumpto();
+  static constexpr int lastDwarfRegNum() {
+    return _LIBUNWIND_HIGHEST_DWARF_REGISTER_M68K64;
+  }
+  static int  getArch() { return REGISTERS_M68K64; }
+
+  uint64_t  getSP() const         { return _registers.__a[7]; }
+  void      setSP(uint64_t value) { _registers.__a[7] = value; }
+  uint64_t  getIP() const         { return _registers.__pc; }
+  void      setIP(uint64_t value) { _registers.__pc = value; }
+
+private:
+  // Layout shared with __unw_getcontext and jumpto (UnwindRegistersSave/Restore.S):
+  // d0-d7 at 0, a0-a7 at 64, pc at 128.
+  struct m68k64_thread_state_t {
+    uint64_t __d[8];
+    uint64_t __a[8];
+    uint64_t __pc;
+  };
+
+  m68k64_thread_state_t _registers;
+};
+
+inline Registers_m68k64::Registers_m68k64(const void *registers) {
+  static_assert((check_fit<Registers_m68k64, unw_context_t>::does_fit),
+                "m68k64 registers do not fit into unw_context_t");
+  memcpy(&_registers, static_cast<const uint8_t *>(registers),
+         sizeof(_registers));
+}
+
+inline Registers_m68k64::Registers_m68k64() {
+  memset(&_registers, 0, sizeof(_registers));
+}
+
+inline bool Registers_m68k64::validRegister(int regNum) const {
+  if (regNum == UNW_REG_IP || regNum == UNW_REG_SP)
+    return true;
+  if (regNum >= UNW_M68K64_D0 && regNum <= UNW_M68K64_A7)
+    return true;
+  return regNum == UNW_M68K64_PC;
+}
+
+inline uint64_t Registers_m68k64::getRegister(int regNum) const {
+  if (regNum >= UNW_M68K64_D0 && regNum <= UNW_M68K64_D7)
+    return _registers.__d[regNum - UNW_M68K64_D0];
+  if (regNum >= UNW_M68K64_A0 && regNum <= UNW_M68K64_A7)
+    return _registers.__a[regNum - UNW_M68K64_A0];
+  switch (regNum) {
+  case UNW_REG_IP:
+  case UNW_M68K64_PC:
+    return _registers.__pc;
+  case UNW_REG_SP:
+    return _registers.__a[7];
+  }
+  _LIBUNWIND_ABORT("unsupported m68k64 register");
+}
+
+inline void Registers_m68k64::setRegister(int regNum, uint64_t value) {
+  if (regNum >= UNW_M68K64_D0 && regNum <= UNW_M68K64_D7) {
+    _registers.__d[regNum - UNW_M68K64_D0] = value;
+    return;
+  }
+  if (regNum >= UNW_M68K64_A0 && regNum <= UNW_M68K64_A7) {
+    _registers.__a[regNum - UNW_M68K64_A0] = value;
+    return;
+  }
+  switch (regNum) {
+  case UNW_REG_IP:
+  case UNW_M68K64_PC:
+    _registers.__pc = value;
+    return;
+  case UNW_REG_SP:
+    _registers.__a[7] = value;
+    return;
+  }
+  _LIBUNWIND_ABORT("unsupported m68k64 register");
+}
+
+inline const char *Registers_m68k64::getRegisterName(int regNum) {
+  static const char *const names[16] = {"d0", "d1", "d2", "d3", "d4", "d5", "d6", "d7",
+                                        "a0", "a1", "a2", "a3", "a4", "a5", "a6", "sp"};
+  if (regNum >= UNW_M68K64_D0 && regNum <= UNW_M68K64_A7)
+    return names[regNum];
+  if (regNum == UNW_REG_IP || regNum == UNW_M68K64_PC)
+    return "pc";
+  if (regNum == UNW_REG_SP)
+    return "sp";
+  return "unknown register";
+}
