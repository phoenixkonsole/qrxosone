--- a/lld/ELF/Arch/M68k64.cpp
+++ b/lld/ELF/Arch/M68k64.cpp
@@ -0,0 +1,83 @@
+//===- M68k64.cpp - QRX 68100EC64 ----------------------------------------===//
+//
+// Static linking for the m68k64 target: ELF64, big endian, EM_68K. There is no GOT, PLT or TLS
+// support yet. R_68K64_64 is ours: the 68000 family has no 64-bit relocation.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Symbols.h"
+#include "Target.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/Support/Endian.h"
+
+using namespace llvm;
+using namespace llvm::support::endian;
+using namespace llvm::ELF;
+using namespace lld;
+using namespace lld::elf;
+
+namespace {
+constexpr uint32_t R_68K64_64 = 240;
+
+class M68k64 final : public TargetInfo {
+public:
+  M68k64(Ctx &ctx) : TargetInfo(ctx) {
+    symbolicRel = RelType(R_68K64_64);
+    defaultImageBase = 0x10000;
+    defaultMaxPageSize = 0x1000;
+    defaultCommonPageSize = 0x1000;
+  }
+  RelExpr getRelExpr(RelType type, const Symbol &s,
+                     const uint8_t *loc) const override;
+  void relocate(uint8_t *loc, const Relocation &rel,
+                uint64_t val) const override;
+};
+} // namespace
+
+RelExpr M68k64::getRelExpr(RelType type, const Symbol &s,
+                           const uint8_t *loc) const {
+  switch (uint32_t(type)) {
+  case R_68K64_64:
+  case R_68K_32:
+  case R_68K_16:
+  case R_68K_8:
+    return R_ABS;
+  case R_68K_PC32:
+  case R_68K_PC16:
+  case R_68K_PC8:
+    return R_PC;
+  case R_68K_NONE:
+    return R_NONE;
+  default:
+    Err(ctx) << getErrorLoc(ctx, loc) << "unknown relocation (" << type.v
+             << ") against symbol " << &s;
+    return R_NONE;
+  }
+}
+
+void M68k64::relocate(uint8_t *loc, const Relocation &rel, uint64_t val) const {
+  switch (uint32_t(rel.type)) {
+  case R_68K64_64:
+    write64be(loc, val);
+    break;
+  case R_68K_32:
+  case R_68K_PC32:
+    checkInt(ctx, loc, val, 32, rel);
+    write32be(loc, val);
+    break;
+  case R_68K_16:
+  case R_68K_PC16:
+    checkInt(ctx, loc, val, 16, rel);
+    write16be(loc, val);
+    break;
+  case R_68K_8:
+  case R_68K_PC8:
+    checkInt(ctx, loc, val, 8, rel);
+    *loc = val;
+    break;
+  default:
+    llvm_unreachable("unknown relocation");
+  }
+}
