+// QRX 68100EC64 long mode: LP64, natural alignment.
+class LLVM_LIBRARY_VISIBILITY M68k64TargetInfo : public M68kTargetInfo {
+public:
+  M68k64TargetInfo(const llvm::Triple &Triple, const TargetOptions &Opts)
+      : M68kTargetInfo(Triple, Opts) {
+    PointerWidth = PointerAlign = LongWidth = LongAlign = 64;
+    LongLongAlign = DoubleAlign = 64;
+    IntAlign = FloatAlign = 32;
+    SuitableAlign = 64;
+    LongDoubleWidth = LongDoubleAlign = 64;
+    LongDoubleFormat = &llvm::APFloat::IEEEdouble();
+    SizeType = UnsignedLong;
+    PtrDiffType = SignedLong;
+    IntPtrType = SignedLong;
+    Int64Type = SignedLong;
+    IntMaxType = SignedLong;
+    MaxAtomicPromoteWidth = MaxAtomicInlineWidth = 64;
+  }
+  // _BitInt(N): LLVM legalizes wide integers generically (libc++'s <bitset>, fmt use it)
+  bool hasBitIntType() const override { return true; }
+  void getTargetDefines(const LangOptions &Opts, MacroBuilder &Builder) const override {
+    // Not __m68k__ or __mc68000: code that tests those expects the 32-bit m68k ABI
+    // (AROS picks its register call convention by them).
+    Builder.defineMacro("__m68k64__");
+    Builder.defineMacro("__mc68100ec64__");
+    Builder.defineMacro("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_1");
+    Builder.defineMacro("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_2");
+    Builder.defineMacro("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_4");
+    Builder.defineMacro("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_8");
+    Builder.defineMacro("_LP64");
+    Builder.defineMacro("__LP64__");
+  }
 };
 
