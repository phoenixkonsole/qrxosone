diff --git a/arch/m68k64-native/kernel/intr.c b/arch/m68k64-native/kernel/intr.c
new file mode 100644
index 00000000..a20f5d55
--- /dev/null
+++ b/arch/m68k64-native/kernel/intr.c
@@ -0,0 +1,240 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Exceptions and interrupts of the 68100EC64 in long mode, see docs/armithlon/68100ec64.md
+    in QRX OS One. All 256 vectors go to one entry, which reads the vector number from the
+    frame, builds a struct ExceptionContext on the supervisor stack and calls cpu_Exception().
+*/
+
+#include <inttypes.h>
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+#include <aros/m68k64/cpucontext.h>
+#include <hardware/intbits.h>
+#include <stddef.h>
+#include <string.h>
+
+#include "kernel_base.h"
+
+#include <proto/exec.h>
+#include <proto/kernel.h>
+
+#include "kernel_cpu.h"
+#include "kernel_intern.h"
+#include "kernel_debug.h"
+#include "kernel_interrupts.h"
+#include "kernel_intr.h"
+#include "kernel_syscall.h"
+#include "kernel_scheduler.h"
+
+#define D(x)
+#define DIRQ(x)
+
+/* The frame period of the core timer: 50 Hz, the VBlank rate exec schedules by */
+#define M68K64_TIMER_US         20000
+
+void ictl_enable_irq(uint8_t irq, struct KernelBase *KernelBase)
+{
+}
+
+void ictl_disable_irq(uint8_t irq, struct KernelBase *KernelBase)
+{
+}
+
+/*
+    The exception entry. On entry SP is the supervisor stack and holds the frame:
+        0 SR, 2 format and vector offset, 4 reserved, 8 PC, and for format 1 16 the fault address.
+    struct ExceptionContext (272 bytes) goes below it:
+        0 d[16], 128 a[16] (a[7] at 184), 256 pc, 264 sr, 266 Flags, 268 reserved
+    'reserved' keeps the size of the frame, so the exit puts the stack back where it was.
+
+    Privileged instructions llvm-mc does not know yet are written as words:
+        $007C $0700     ori.w #$0700,sr     mask interrupts while the kernel runs
+        $4E7A $8800     movec usp,a0
+        $4E7B $8800     movec a0,usp
+*/
+asm (
+    "   .text\n"
+    "   .globl  __m68k64_exception\n"
+    "   .type   __m68k64_exception,@function\n"
+    "   .p2align 2\n"
+    "__m68k64_exception:\n"
+    "   .short  0x007C, 0x0700\n"
+    "   suba.q  #272, %sp\n"
+    "   movem.q %d0-%d7, (0,%sp)\n"
+    "   movem.q %a0-%a6, (128,%sp)\n"
+    "   moveq   #16, %d1\n"
+    "   move.w  (274,%sp), %d0\n"
+    "   lsr.w   #8, %d0\n"
+    "   lsr.w   #4, %d0\n"
+    "   cmpi.w  #1, %d0\n"
+    "   bne     1f\n"
+    "   moveq   #24, %d1\n"
+    "1: move.l  %d1, (268,%sp)\n"
+    "   move.w  (272,%sp), %d0\n"
+    "   move.w  %d0, (264,%sp)\n"
+    "   move.w  #0, (266,%sp)\n"
+    "   move.q  (280,%sp), %a0\n"
+    "   move.q  %a0, (256,%sp)\n"
+    "   btst    #13, %d0\n"
+    "   bne     2f\n"
+    "   .short  0x4E7A, 0x8800\n"
+    "   bra     3f\n"
+    "2: lea     (272,%sp), %a0\n"
+    "   adda.q  %d1, %a0\n"
+    "3: move.q  %a0, (184,%sp)\n"
+    "   moveq   #0, %d0\n"
+    "   move.w  (274,%sp), %d0\n"
+    "   and.l   #4095, %d0\n"
+    "   lsr.l   #2, %d0\n"
+    "   move.q  %sp, %a0\n"
+    "   move.q  %d0, -(%sp)\n"
+    "   move.q  %a0, -(%sp)\n"
+    "   jsr     (cpu_Exception,%pc)\n"
+    "   adda.q  #16, %sp\n"
+    /* Back to user state: the frame goes where it came from, the user stack into USP */
+    "   move.w  (264,%sp), %d0\n"
+    "   btst    #13, %d0\n"
+    "   bne     4f\n"
+    "   move.q  (184,%sp), %a0\n"
+    "   .short  0x4E7B, 0x8800\n"
+    "   lea     (272,%sp), %a0\n"
+    "   move.l  (268,%sp), %d1\n"
+    "   adda.q  %d1, %a0\n"
+    "   suba.q  #16, %a0\n"
+    "   move.q  %a0, (184,%sp)\n"
+    "   bra     5f\n"
+    /* Back to supervisor state: the frame goes just below the stack the context names */
+    "4: move.q  (184,%sp), %a0\n"
+    "   suba.q  #16, %a0\n"
+    "   move.q  %a0, (184,%sp)\n"
+    "5: move.w  %d0, (0,%a0)\n"
+    "   move.w  #0, (2,%a0)\n"
+    "   move.l  #0, (4,%a0)\n"
+    "   move.q  (256,%sp), %a1\n"
+    "   move.q  %a1, (8,%a0)\n"
+    "   movem.q (0,%sp), %d0-%d7\n"
+    "   movem.q (128,%sp), %a0-%a6\n"
+    "   move.q  (184,%sp), %sp\n"
+    "   rte\n"
+    "   .size   __m68k64_exception, .-__m68k64_exception\n"
+);
+
+extern void __m68k64_exception(void);
+
+/* 256 vectors of 8 bytes, 8-byte aligned, as VBR wants them */
+static void *cpu_Vectors[EXCEPTIONS_COUNT] __attribute__((aligned(8)));
+
+void cpu_SetupVectors(void)
+{
+    void *table = cpu_Vectors;
+    int i;
+
+    for (i = 0; i < EXCEPTIONS_COUNT; i++)
+        cpu_Vectors[i] = (void *)__m68k64_exception;
+
+    /* movec a0,vbr: $4E7B $8801 */
+    asm volatile (
+        "   move.q  %0, %%a0\n"
+        "   .short  0x4E7B, 0x8801\n"
+        : : "a"(table) : "a0", "memory");
+}
+
+void cpu_StartTimer(void)
+{
+    unsigned long period = M68K64_TIMER_US;
+
+    /* movec d0,$80C: $4E7B $080C */
+    asm volatile (
+        "   move.q  %0, %%d0\n"
+        "   .short  0x4E7B, 0x080C\n"
+        : : "d"(period) : "d0");
+}
+
+static void cpu_Syscall(regs_t *regs)
+{
+    unsigned long sc = regs->d[0];
+
+    switch (sc)
+    {
+    case SC_CLI:
+        regs->sr |= 0x0700;
+        break;
+
+    case SC_STI:
+        regs->sr &= ~0x0700;
+        break;
+
+    case SC_SUPERSTATE:
+        regs->sr |= SR_SUPERVISOR | 0x0700;
+        break;
+
+    case SC_ISSUPERSTATE:
+        regs->d[0] = (regs->sr & SR_SUPERVISOR) ? 1 : 0;
+        break;
+
+    case SC_GETCPUNUMBER:
+        regs->d[0] = GetCPUNumber();
+        break;
+
+    case SC_CACHECLEARE:
+    case SC_REBOOT:
+        /* No caches to clear on the reference core; a reboot is not there yet */
+        break;
+
+    default:
+        /* Task switches happen only on the way back to a task in user state */
+        if (!(regs->sr & SR_SUPERVISOR))
+            core_SysCall(sc, regs);
+        break;
+    }
+}
+
+void cpu_Exception(regs_t *regs, unsigned long vector)
+{
+    struct KernelBase *KernelBase = (struct KernelBase *)TLS_GET(KernelBase);
+
+    switch (vector)
+    {
+    case M68K64_VEC_IRQ(M68K64_IRQ_TIMER):
+        DIRQ(bug("[Kernel] timer\n"));
+        if (KernelBase)
+            krnRunIRQHandlers(KernelBase, IRQ_TIMER);
+        if (SysBase && (IDNESTCOUNT_GET < 0))
+            core_Cause(INTB_VERTB, 1L << INTB_VERTB);
+        if (!(regs->sr & SR_SUPERVISOR))
+            core_ExitInterrupt(regs);
+        break;
+
+    case M68K64_VEC_IRQ(M68K64_IRQ_IPI):
+        DIRQ(bug("[Kernel] signal from another core\n"));
+        if (KernelBase)
+            krnRunIRQHandlers(KernelBase, IRQ_IPI);
+        if (!(regs->sr & SR_SUPERVISOR))
+            core_ExitInterrupt(regs);
+        break;
+
+    case M68K64_VEC_TRAP(0):
+        cpu_Syscall(regs);
+        break;
+
+    default:
+        if (vector >= M68K64_VEC_IRQ(1) && vector <= M68K64_VEC_IRQ(7))
+        {
+            if (KernelBase)
+                krnRunIRQHandlers(KernelBase, vector - M68K64_VEC_IRQ(0));
+            if (!(regs->sr & SR_SUPERVISOR))
+                core_ExitInterrupt(regs);
+            break;
+        }
+
+        /* A fault. There is no exception handler mechanism for traps yet. */
+        bug("[Kernel] exception %lu at pc 0x%016lx, sr 0x%04x\n", vector,
+            (unsigned long)regs->pc, regs->sr);
+        bug("[Kernel] d0 %016lx d1 %016lx a0 %016lx a7 %016lx\n",
+            (unsigned long)regs->d[0], (unsigned long)regs->d[1],
+            (unsigned long)regs->a[0], (unsigned long)regs->a[7]);
+        for (;;)
+            asm volatile (".short 0x4E72, 0x2700");     /* stop #$2700 */
+    }
+}
diff --git a/arch/m68k64-native/kernel/issuper.c b/arch/m68k64-native/kernel/issuper.c
new file mode 100644
index 00000000..71205bd5
--- /dev/null
+++ b/arch/m68k64-native/kernel/issuper.c
@@ -0,0 +1,34 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    KrnIsSuper on the 68100EC64. MOVE from SR is privileged in long mode, so the kernel answers
+    through TRAP #0. See rom/kernel/issuper.c for documentation.
+*/
+
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+
+#include <kernel_base.h>
+#include <kernel_syscall.h>
+
+#include <proto/kernel.h>
+
+AROS_LH0I(int, KrnIsSuper,
+         struct KernelBase *, KernelBase, 13, Kernel)
+{
+    AROS_LIBFUNC_INIT
+
+    register unsigned long res;
+
+    asm volatile (
+        "   moveq   %[sc], %%d0\n"
+        "   trap    #0\n"
+        "   move.q  %%d0, %[res]\n"
+        : [res] "=d"(res)
+        : [sc] "i"(SC_ISSUPERSTATE)
+        : "d0", "d1", "a0", "a1", "memory", "cc");
+
+    return res;
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/arch/m68k64-native/kernel/kernel_arch.h b/arch/m68k64-native/kernel/kernel_arch.h
new file mode 100644
index 00000000..e1735115
--- /dev/null
+++ b/arch/m68k64-native/kernel/kernel_arch.h
@@ -0,0 +1,23 @@
+/*
+ * Machine-specific definitions.
+ *
+ * This file needs to be replaced for every machine. Hosted ports
+ * may share the same file in arch/all-$(ARCH)/kernel/kernel_arch.h
+ *
+ * This file is just a sample providing necessary minimum.
+ */
+#include "kernel_cpu.h"
+
+/* Number of IRQs used in the machine. Needed by kernel_base.h */
+#define IRQ_COUNT 8
+
+/* The interrupt levels of the 68100EC64 are the IRQ numbers */
+#define IRQ_TIMER   5
+#define IRQ_IPI     6
+
+/*
+ * Interrupt controller functions.
+ */
+
+extern void ictl_enable_irq(uint8_t irq, struct KernelBase *KernelBase);
+extern void ictl_disable_irq(uint8_t irq, struct KernelBase *KernelBase);
