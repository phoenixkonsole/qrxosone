+#define POLLWRNORM  POLLOUT
+#define POLLWRBAND  0x0100
+
+__BEGIN_DECLS
+
+int poll(struct pollfd *fds, nfds_t nfds, int timeout);
+
+__END_DECLS
+
+#endif /* _POSIXC_POLL_H_ */
