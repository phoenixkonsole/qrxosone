diff --git a/arch/m68k64-native/qrx/ec64gfx/vesagfx_support.c b/arch/m68k64-native/qrx/ec64gfx/vesagfx_support.c
new file mode 100644
index 00000000..6aff3d8d
--- /dev/null
+++ b/arch/m68k64-native/qrx/ec64gfx/vesagfx_support.c
@@ -0,0 +1,192 @@
+/*
+    Copyright (C) 1995-2025, The AROS Development Team. All rights reserved.
+
+    Desc: VESA Gfx hardware support functions
+*/
+
+#define DEBUG 0
+
+#include <aros/asmcall.h>
+#include <aros/debug.h>
+#include <aros/macros.h>
+#include <exec/memory.h>
+#include <proto/exec.h>
+#include <proto/utility.h>
+#include <proto/oop.h>
+#include <utility/hooks.h>
+#include <utility/tagitem.h>
+#include <oop/oop.h>
+
+#include "vesagfx_intern.h"
+#include "vesagfx_hidd.h"
+
+/* The 68100EC64 board (qrx_ec64_board.h): the framebuffer is guest RAM that the board shows. */
+#define BOARD(off)      (*(volatile ULONG *)(0xFFFFFFFF00000000UL + (off)))
+#define BOARD_Q(off)    (*(volatile UQUAD *)(0xFFFFFFFF00000000UL + (off)))
+#define FB_ADDR   0x100
+#define FB_WIDTH  0x108
+#define FB_HEIGHT 0x10C
+#define FB_STRIDE 0x110
+#define FB_FORMAT 0x114
+#define FB_ENABLE 0x118
+#define FB_FRAMES 0x11C
+#define FB_XRGB32 5
+
+BOOL initVesaGfxHW(struct HWData *data)
+{
+    if (BOARD_Q(0) != 0x5152584543363442UL) {
+        bug("[EC64Gfx] no 68100EC64 board\n");
+        return FALSE;
+    }
+    data->width = 1024; data->height = 768;
+    data->bitsperpixel = 32; data->depth = 24; data->bytesperpixel = 4;
+    data->bytesperline = data->width * 4;
+    /* a big endian 32-bit word 0x00RRGGBB: AROS shifts count from the most significant bit */
+    data->redmask = 0x00ff0000; data->greenmask = 0x0000ff00; data->bluemask = 0x000000ff;
+    data->redshift = 8; data->greenshift = 16; data->blueshift = 24;
+    data->palettewidth = 8;
+    data->fbsize = data->bytesperline * data->height;
+    data->framebuffer = AllocMem(data->fbsize, MEMF_PUBLIC | MEMF_CLEAR);
+    if (!data->framebuffer)
+        return FALSE;
+    BOARD_Q(FB_ADDR) = (UQUAD)(IPTR)data->framebuffer;
+    BOARD(FB_WIDTH) = data->width;
+    BOARD(FB_HEIGHT) = data->height;
+    BOARD(FB_STRIDE) = data->bytesperline;
+    BOARD(FB_FORMAT) = FB_XRGB32;
+    D(bug("[EC64Gfx] framebuffer %dx%d at 0x%p\n", data->width, data->height, data->framebuffer));
+    return TRUE;
+}
+
+/* A full-size 32-bit bitmap at offset 0,0 is shown by pointing the board at its own pixels: every
+ * drawing is on the screen at once, also from code that writes the bitmap without UpdateRect, and
+ * nothing has to be copied. Other bitmaps go through the copy into the framebuffer. */
+void ec64ShowBitmap(struct HWData *hwdata, struct VESAGfxBitMapData *data, BOOL visible)
+{
+    if (visible && data->VideoData && data->bytesperpix == 4 && !data->xoffset && !data->yoffset &&
+        data->width >= hwdata->width && data->height >= hwdata->height)
+    {
+        hwdata->direct = data->VideoData;
+        BOARD_Q(FB_ADDR) = (UQUAD)(IPTR)data->VideoData;
+        BOARD(FB_STRIDE) = data->bytesperline;
+    }
+    else
+    {
+        if (!visible && hwdata->direct != data->VideoData)
+            return;
+        hwdata->direct = NULL;
+        BOARD_Q(FB_ADDR) = (UQUAD)(IPTR)hwdata->framebuffer;
+        BOARD(FB_STRIDE) = hwdata->bytesperline;
+    }
+    BOARD(FB_ENABLE) = 1;
+    BOARD(FB_FRAMES) = 1;
+}
+
+void vesaDoRefreshArea(struct HWData *hwdata, struct VESAGfxBitMapData *data,
+                       LONG x1, LONG y1, LONG x2, LONG y2)
+{
+    if (hwdata->direct && hwdata->direct == data->VideoData)
+    {
+        BOARD(FB_FRAMES) = 1;
+        return;
+    }
+    UBYTE *src, *dst;
+    ULONG srcmod, dstmod;
+    LONG y, w, h, sx, sy;
+
+    x1 += data->xoffset;
+    y1 += data->yoffset;
+    x2 += data->xoffset;
+    y2 += data->yoffset;
+
+    /* Clip the rectangle against physical display borders */
+    if ((x1 >= data->disp_width) || (x2 < 1) ||
+        (y1 >= data->disp_height) || (y2 < 1))
+        return;
+    if (x1 < 0)
+        x1 = 0;
+    if (y1 < 0)
+        y1 = 0;
+    if (x2 > data->disp_width)
+        x2 = data->disp_width;
+    if (y2 > data->disp_height)
+        y2 = data->disp_height;
+
+    /* Calculate width and height */
+    w = x2 - x1;
+    h = y2 - y1;
+
+    /* Jump back to bitmap coordinates (adjusted) */
+    sx = x1 - data->xoffset;
+    sy = y1 - data->yoffset;
+
+    w *= data->bytesperpix;
+
+    srcmod = data->bytesperline;
+    dstmod = hwdata->bytesperline;
+
+    src = data->VideoData + sy * data->bytesperline + sx * data->bytesperpix;
+    dst = hwdata->framebuffer + y1 * hwdata->bytesperline + x1 * hwdata->bytesperpixel;
+
+    /*
+     * Disable screen debug output if not done yet.
+     * TODO: develop some mechanism to tell kernel that we actually
+     * didn't change the mode, so upon warm reboot it can reuse
+     * the framebuffer for debug output.
+     */
+    if (!hwdata->owned)
+    {
+        RawPutChar(0x03);
+        hwdata->owned = TRUE;
+    }
+
+    /*
+    ** common sense assumption: memcpy can't possibly be faster than CopyMem[Quick]
+    */
+    if ((srcmod != dstmod) || (srcmod != w))
+    {
+        for(y = 0; y < h; y++)
+        {
+            CopyMem(src, dst, w);
+            src += srcmod;
+            dst += dstmod;
+        }
+    }
+    else
+    {
+        /* this is a plain total fast rulez copy */
+        CopyMem(src, dst, w*h);
+    }
+    /* tell the board a frame changed; it shows the latest at the Mac's display rate */
+    BOARD(FB_ENABLE) = 1;
+    BOARD(FB_FRAMES) = 1;
+}
+
+/*
+** DACLoad --
+**      load palette registers
+*/
+void DACLoad(struct VESAGfx_staticdata *xsd, UBYTE *DAC,
+             unsigned char first, int num)
+{
+    /* true colour only */
+}
+
+/*
+** ClearBuffer --
+**      clear the screen buffer
+*/
+void ClearBuffer(struct HWData *data)
+{
+    IPTR *p, *limit;
+
+    if (!data->owned)
+    {
+        RawPutChar(0x03);
+        data->owned = TRUE;
+    }
+
+    SetMem(data->framebuffer, 0 ,data->height * data->bytesperline);
+    BOARD(FB_ENABLE) = 1;
+    BOARD(FB_FRAMES) = 1;
+}
diff --git a/arch/m68k64-native/qrx/ec64gfx/vesagfx_support.h b/arch/m68k64-native/qrx/ec64gfx/vesagfx_support.h
new file mode 100644
index 00000000..953b0f94
--- /dev/null
+++ b/arch/m68k64-native/qrx/ec64gfx/vesagfx_support.h
@@ -0,0 +1,48 @@
+#ifndef VESAGFX_SUPPORT_H
+#define VESAGFX_SUPPORT_H
+
+#include <exec/types.h>
+#include <oop/oop.h>
+
+#define PCI_VENDOR_S3 0x5333
+
+#define vgaIOBase 0x3d0
+
+struct HWData
+{
+    APTR	 framebuffer;
+    ULONG	 fbsize;
+    ULONG	 width;
+    ULONG	 height;
+    ULONG	 depth;
+    ULONG	 bytesperpixel;
+    ULONG	 bitsperpixel;
+    ULONG	 redmask;
+    ULONG	 greenmask;
+    ULONG	 bluemask;
+    ULONG	 redshift;
+    ULONG	 greenshift;
+    ULONG	 blueshift;
+    ULONG	 bytesperline;
+    BOOL	 owned;
+    UBYTE	 palettewidth;
+    UBYTE	 DAC[768];
+    UBYTE	*direct;	/* the visible bitmap's pixels when the board shows them directly */
+    /* Used by PCI scanning routine */
+    OOP_AttrBase pciDeviceAttrBase;
+};
+
+#undef HiddPCIDeviceAttrBase
+#define HiddPCIDeviceAttrBase sd->pciDeviceAttrBase
+
+struct VESAGfx_staticdata;
+struct VESAGfxBitMapData;
+
+BOOL initVesaGfxHW(struct HWData *);
+void DACLoad(struct VESAGfx_staticdata *, UBYTE *, unsigned char, int);
+void ClearBuffer(struct HWData *data);
+void ec64ShowBitmap(struct HWData *hwdata, struct VESAGfxBitMapData *data, BOOL visible);
+void vesaDoRefreshArea(struct HWData *hwdata, struct VESAGfxBitMapData *data,
+		       LONG x1, LONG y1, LONG x2, LONG y2);
+
+#endif /* VESAGFX_SUPPORT_H */
diff --git a/arch/m68k64-native/qrx/kernel/kernel_startup.c b/arch/m68k64-native/qrx/kernel/kernel_startup.c
new file mode 100644
index 00000000..e628507e
--- /dev/null
+++ b/arch/m68k64-native/qrx/kernel/kernel_startup.c
@@ -0,0 +1,273 @@
+/*
+    Copyright (C) 2013-2026, The AROS Development Team. All rights reserved.
+*/
+
+#define DEBUG 1
+
+#include <aros/kernel.h>
+#include <aros/symbolsets.h>
+
+#include <aros/m68k64/cpucontext.h>
+
+#include <aros/cpu.h>
+
+#include <exec/memory.h>
+#include <exec/memheaderext.h>
+#include <exec/tasks.h>
+#include <exec/alerts.h>
+#include <exec/execbase.h>
+#include <proto/kernel.h>
+#include <proto/exec.h>
+
+#include <strings.h>
+#include <string.h>
+
+#include "exec_intern.h"
+#include "etask.h"
+#include "tlsf.h"
+
+#include "kernel_intern.h"
+#include "kernel_debug.h"
+#include "kernel_romtags.h"
+
+#include "exec_platform.h"
+
+#undef KernelBase
+#include "tls.h"
+#include "tags.h"
+#include "kernel_smp.h"
+
+#undef TARGET_SECTION_COMMENT
+#define TARGET_SECTION_COMMENT "\n#"
+
+extern struct TagItem *BootMsg;
+
+void __attribute__((used)) kernel_cstart(struct TagItem *msg);
+
+extern void cpu_SetupVectors(void);
+extern void qrx_selftest(const char *cmdline);
+extern void cpu_StartTimer(void);
+
+/* AROS_STACKSIZE is in bytes here */
+static IPTR stack[AROS_STACKSIZE / sizeof(IPTR)] __attribute__((used,aligned(16)));
+static IPTR stack_super[AROS_STACKSIZE / sizeof(IPTR)] __attribute__((used,aligned(16)));
+
+/*
+    The 68100EC64 comes out of reset in 32-bit mode, in supervisor state, with interrupts
+    masked. The loader jumps here with the boot tag list in A0.
+        $7001               moveq   #1,d0
+        $4E7B $080F         movec   d0,$80F     long mode on
+    From here on everything is 64 bits.
+*/
+asm (
+    ".section .aros.init,\"ax\"\n\t"
+    ".globl start\n\t"
+    ".type start,@function\n"
+    "start:\n"
+    "   .short  0x7001, 0x4E7B, 0x080F\n"
+    "   move.q  (stack_super_end,%pc), %sp\n"
+    "   move.q  %a0, -(%sp)\n"
+    "   jsr     (__clear_bss,%pc)\n"
+    "   jsr     (kernel_cstart,%pc)\n"
+    "1: .short  0x4E72, 0x2700\n"           /* stop #$2700 */
+    "   bra     1b\n"
+    ".string \"Native/CORE v3 (" __DATE__ ")\"" "\n\t\n\t"
+);
+
+static IPTR * const stack_end __attribute__((used, section(".aros.init " TARGET_SECTION_COMMENT))) = &stack[AROS_STACKSIZE / sizeof(IPTR) - 2];
+static IPTR * const stack_super_end __attribute__((used, section(".aros.init " TARGET_SECTION_COMMENT))) = &stack_super[AROS_STACKSIZE / sizeof(IPTR) - 2];
+
+//struct ARM_Implementation __arm_arosintern  __attribute__((aligned(4), section(".data"))) = {0,0,NULL,0};
+struct ExecBase *SysBase __attribute__((section(".data"))) = NULL;
+
+static void __attribute__((used)) __clear_bss(struct TagItem *msg)
+{
+    struct KernelBSS *bss = (struct KernelBSS *)krnGetTagData(KRN_KernelBss, 0, msg);
+
+    if (bss)
+    {
+        for (; bss->addr && bss->len; bss++)
+        {
+            unsigned char *dest = bss->addr;
+            IPTR length = bss->len;
+
+            while (length--)
+                *dest++ = 0;
+        }
+    }
+}
+
+void __attribute__((used)) kernel_cstart(struct TagItem *msg)
+{
+    UWORD *ranges[3];
+    struct MinList memList;
+    struct MemHeader *mh;
+    long unsigned int memlower = 0, memupper = 0, protlower = 0, protupper = 0;
+    char *cmdline = NULL;
+    BootMsg = msg;
+    tls_t *__tls;
+
+    msg = BootMsg;
+
+    /* NB: the bootstrap has conveniently setup the framebuffer
+            and initialised the serial port and led for us */
+
+    while(msg->ti_Tag != TAG_DONE)
+    {
+        switch (msg->ti_Tag)
+        {
+        case KRN_CmdLine:
+//            RelocateStringData(tag);
+            cmdline = (char *)msg->ti_Data;
+            break;
+        case KRN_MEMLower:
+            memlower = msg->ti_Data;
+            break;
+        case KRN_MEMUpper:
+            memupper = msg->ti_Data;
+            break;
+        case KRN_ProtAreaStart:
+            protlower = msg->ti_Data;
+            break;
+        case KRN_ProtAreaEnd:
+            // Page align
+            protupper = (msg->ti_Data + 4095) & ~4095;
+            break;
+        case KRN_KernelBase:
+            /*
+             * KRN_KernelBase is actually a border between read-only
+             * (code) and read-write (data) sections of the kickstart.
+             * read-write section goes to lower addresses from this one,
+             * so we align it upwards in order not to make part of RW data
+             * read-only.
+             */
+//            addr = AROS_ROUNDUP2(msg->ti_Data, PAGE_SIZE);
+            break;
+        }
+        msg++;
+    }
+    msg = BootMsg;
+
+    __tls = (void *)protupper;
+    protupper += (sizeof(tls_t) + 4095) & ~4095;
+
+    __tls->KernelBase = NULL;
+    __tls->SysBase = NULL;
+    __tls->ThisTask = NULL;
+    __tls->ScheduleFlags = 0;
+    __tls->IDNestCnt = 0;
+    __tls->TDNestCnt = 0;
+    __tls->SuperDepth = 1;      /* the boot runs in supervisor state: KrnIsSuper() */
+    __tls->Quantum = SCHEDQUANTUM_VALUE;
+    __tls->Elapsed = SCHEDQUANTUM_VALUE;
+    {
+        unsigned long core;
+        /* movec $80E,d0: this core's number */
+        asm volatile ("   .short 0x4E7A, 0x080E\n   move.q %%d0, %0" : "=d"(core) : : "d0");
+        __tls->CPUNumber = core;
+        /* movec $80B,d0: the number of cores */
+        asm volatile ("   .short 0x4E7A, 0x080B\n   move.q %%d0, %0" : "=d"(core) : : "d0");
+        m68k64_CoreCount = core;
+    }
+    TLS_PTR_SET(__tls);
+
+    /* All exceptions and interrupts go through our table from now on */
+    cpu_SetupVectors();
+
+    D(bug("[Kernel] AROS 68100EC64 Native Kernel built on %s\n", __DATE__));
+    D(bug("[Kernel] Entered kernel_cstart @ 0x%p, BootMsg @ 0x%p\n", kernel_cstart, BootMsg));
+
+    D(bug("[Kernel] Preparing memory 0x%p -> 0x%p\n", memlower, memupper));
+    D(bug("[Kernel] - protected area 0x%p -> 0x%p)\n", protlower, protupper));
+
+    NEWLIST(&memList);
+
+    if (memlower >= protlower)
+        memlower = protupper;
+
+    mh = (struct MemHeader *)memlower;
+
+    {
+        extern int m68k64_IdleDump;
+        if (cmdline && strstr(cmdline, "idledump"))
+            m68k64_IdleDump = 1;
+    }
+    if (cmdline && strstr(cmdline, "notlsf"))
+    {
+#if (0)
+        krnCreateMemHeader("System Memory", 0, mh, (memupper - memlower), MEMF_CHIP | MEMF_FAST | MEMF_PUBLIC | MEMF_KICK | MEMF_LOCAL);
+
+        if (memlower < protlower)
+        {
+//            AllocAbs(protupper-protlower, (void *)protlower);
+        }
+#endif
+    }
+    else
+    {
+        /* Initialize TLSF memory allocator */
+        krnCreateTLSFMemHeader("System Memory", 0, mh, (memupper - memlower), MEMF_CHIP | MEMF_FAST | MEMF_PUBLIC | MEMF_KICK | MEMF_LOCAL);
+        if (memlower < protlower)
+        {
+            /* Protect the bootstrap area from further use. AllocAbs will do the trick */
+            APTR got = ((struct MemHeaderExt *)mh)->mhe_AllocAbs((struct MemHeaderExt *)mh, protupper-protlower, (void *)protlower);
+            D(bug("[Kernel] protected 0x%p bytes at 0x%p: %s\n", protupper - protlower, protlower, got ? "ok" : "FAILED"));
+            if (!got)
+                krnPanic(NULL, "Cannot protect the boot area");
+        }
+    }
+
+    ranges[0] = (UWORD *)krnGetTagData(KRN_KernelLowest, 0, msg);
+    ranges[1] = (UWORD *)krnGetTagData(KRN_KernelHighest, 0, msg);
+    ranges[2] = (UWORD *)-1;
+
+    D(bug("[Kernel] Preparing ExecBase (memheader @ 0x%p)\n", mh));
+    krnPrepareExecBase(ranges, mh, BootMsg);
+
+    __tls->SysBase = SysBase;
+    D(bug("[Kernel] SysBase @ 0x%p\n", SysBase));
+
+    /*
+     * Make kickstart code area read-only.
+     * We do it only after ExecBase creation because SysBase pointer is put
+     * into .rodata. This way we prevent it from ocassional modification by buggy software.
+     */
+//    core_ProtKernelArea(addr, kick_highest - addr, 1, 0, 1);
+
+    D(bug("[Kernel] InitCode(RTF_SINGLETASK) ... \n"));
+    InitCode(RTF_SINGLETASK, 0);
+
+    D(bug("[Kernel] Dropping into USER mode ... \n"));
+    TLS_PTR_GET()->SuperDepth = 0;
+
+    /*
+        The boot task goes on in user state on the stack it runs on now, so this function's
+        locals stay where they are. Exceptions get the other stack from here on:
+            movec a0,usp        $4E7B $8800     user stack = the current one
+            move  #$0000,sr     $46FC $0000     user state, all interrupts in
+        The timer starts first, its interrupt waits for the mask to drop.
+    */
+    cpu_StartTimer();
+    asm volatile (
+        "   move.q  %%sp, %%a0\n"
+        "   .short  0x4E7B, 0x8800\n"
+        "   move.q  %0, %%sp\n"
+        "   .short  0x46FC, 0x0000\n"
+        : : "a"(stack_end) : "a0", "memory");
+
+    D(bug("[Kernel] InitCode(RTF_COLDSTART) ...\n"));
+    InitCode(RTF_COLDSTART, 0);
+
+    /* Nothing else in the kickstart yet: the test of exec can run here */
+    if (cmdline && strstr(cmdline, "selftest"))
+        qrx_selftest(cmdline);
+
+    /* The above should not return */
+    krnPanic(KernelBase, "System Boot Failed!");
+
+    /* User state: STOP is privileged, so just stay here */
+    for (;;)
+        asm volatile ("nop");
+}
+
+
diff --git a/arch/m68k64-native/qrx/kernel/ldscript.lds b/arch/m68k64-native/qrx/kernel/ldscript.lds
new file mode 100644
index 00000000..bf4b33d1
--- /dev/null
+++ b/arch/m68k64-native/qrx/kernel/ldscript.lds
@@ -0,0 +1,41 @@
+SECTIONS
+{
+    .text : {
+        __text_start = .;
+        *(SORT_NONE(.aros.init*))
+        *(.text*)                   /* wildcard for "gcc -ffunction-sections" */
+        *(.gnu.linkonce.t.*)        /* C++ templates? */
+        __text_end = .;
+    }
+
+    .intvecs :
+    {
+        __intvecs_start = .;
+        *(.intvecs)
+        __intvecs_end = .;
+    }
+
+    .rodata : {
+        *(.rodata*)                 /* read-only data (ELF only) */
+        *(.gnu.linkonce.r.*)
+        
+    }
+
+    . = ALIGN(4096);
+
+    .data : {
+        *(.data*)                   /* wildcard for "gcc -fdata-sections" */
+        *(.gnu.linkonce.d.*)
+        . = ALIGN(16);
+        start_ctors = .; *(SORT(.ctor*)) QUAD(0)
+        start_dtors = .; *(SORT(.dtor*)) QUAD(0)
+    }
+
+    . = ALIGN(4096);
+
+    .bss : {
+        *(.bss*)                    /* wildcard for "gcc -fdata-sections" */
+        *(.gnu.linkonce.b.*)
+        *(COMMON)                   /* "common" variables */
+    }
+}
diff --git a/arch/m68k64-native/qrx/kernel/mmakefile.src b/arch/m68k64-native/qrx/kernel/mmakefile.src
new file mode 100644
index 00000000..32d11655
--- /dev/null
+++ b/arch/m68k64-native/qrx/kernel/mmakefile.src
@@ -0,0 +1,52 @@
+
+include $(SRCDIR)/config/aros.cfg
+
+%get_archincludes modname=kernel \
+    includeflag=TARGET_KERNEL_INCLUDES maindir=rom/kernel
+
+%get_archincludes modname=exec \
+    includeflag=TARGET_EXEC_INCLUDES maindir=rom/exec
+
+PRIV_KERNEL_INCLUDES = \
+    $(TARGET_KERNEL_INCLUDES) \
+	-I$(SRCDIR)/rom/kernel \
+	$(TARGET_EXEC_INCLUDES) \
+	-I$(SRCDIR)/rom/exec
+
+CFILES := \
+        kernel_startup selftest
+
+PLATFILES := 
+
+AFILES := 
+
+#MM kernel-qrx-m68k64: setup-native-m68k64-qrx kernel-kernel-kobj kernel-exec-kobj kernel-task-kobj
+#MM
+kernel-qrx-m68k64: $(OSGENDIR)/boot/core.elf
+		$(Q)$(NOP)
+
+#MM- kernel-qrx-m68k64-quick: setup-native-m68k64-qrx-quick kernel-kernel-kobj-quick kernel-exec-kobj-quick kernel-task-kobj-quick kernel-qrx-m68k64
+
+ELFCORELIBS := -L$(AROS_LIB) -larossupport -lautoinit -llibinit -lstdc.static
+# soft float and 128-bit helpers from compiler-rt (the core has no FPU)
+ELFCORELIBS += $(TARGET_C_LIBS)
+ifeq ("$(AROS_TOOLCHAIN)","gnu")
+ELFCORELIBS += -L$(CROSSTOOLSDIR)/lib/gcc/$(AROS_TARGET_CPU)-aros/$(TARGET_GCC_VER) -lgcc
+endif
+
+$(OSGENDIR)/boot/core.elf: $(KOBJSDIR)/kernel_resource.o $(KOBJSDIR)/exec_library.o  $(KOBJSDIR)/task_resource.o
+		@$(ECHO) "Creating   $@"
+		%mkdirs_q $(OSGENDIR)/boot
+		@$(TARGET_LD) -Map $(OSGENDIR)/boot/core.map -T $(SRCDIR)/$(CURDIR)/ldscript.lds -o $@ $^ $(ELFCORELIBS)
+		@$(TARGET_STRIP) --strip-unneeded -R .note -R .comment $@
+
+#MM kernel-kernel-native-m68k64-qrx :  includes
+
+USER_INCLUDES := $(PRIV_KERNEL_INCLUDES) -I$(GENINCDIR) -I$(AROS_DEVELOPER)/include -I$(SRCDIR)/rom/openfirmware
+#USER_CPPFLAGS := -DTARGET_SECTION_COMMENT=\"$(AROS_SECTION_COMMENT)\"
+
+%build_archspecific \
+  mainmmake=kernel-kernel modname=kernel maindir=rom/kernel arch=native-m68k64-qrx \
+  files="$(CFILES) $(PLATFILES)" asmfiles="$(AFILES)" compiler=kernel
+
+%common
diff --git a/arch/m68k64-native/qrx/kernel/selftest.c b/arch/m68k64-native/qrx/kernel/selftest.c
new file mode 100644
index 00000000..410cb866
--- /dev/null
+++ b/arch/m68k64-native/qrx/kernel/selftest.c
@@ -0,0 +1,295 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    A boot-time test of exec on the 68100EC64, run with "selftest" on the kernel command line
+    when nothing else is in the kickstart yet. Two tasks pass a ball with Signal/Wait, and two busy
+    tasks of the same priority only both get on if the timer preempts them. The result ends the test
+    machine (TRAP #2, the code in D0): 0 when everything passed.
+*/
+
+#include <aros/kernel.h>
+#include <exec/tasks.h>
+#include <exec/execbase.h>
+#include <proto/exec.h>
+#include <exec/memory.h>
+
+#include <aros/m68k64/cpucontext.h>
+#include <string.h>
+
+#include "kernel_intern.h"
+#include "kernel_smp.h"
+
+#define ROUNDS 5
+#define WORKERS 8
+#define WORKER_STEPS 20000
+#define BUSY_STEPS 3000000UL
+
+static struct
+{
+    struct Task *boot, *ping, *pong;
+    BYTE done_sig;
+    volatile ULONG passes;
+    volatile UQUAD count[2];
+    volatile UQUAD seen_other[2];   /* how often a busy task saw the other one move on */
+    volatile UQUAD shared;          /* changed atomically by the workers */
+    volatile ULONG cores_seen;      /* bit n: a worker ran on core n */
+} st;
+
+static void report_done(void)
+{
+    __atomic_fetch_add(&st.passes, 1, __ATOMIC_SEQ_CST);
+    Signal(st.boot, 1UL << st.done_sig);
+}
+
+/* A mask with one core in it, for TASKTAG_AFFINITY */
+static void *core_mask(unsigned int core)
+{
+    /* what KrnAllocCPUMask() and KrnGetCPUMask() make; this test runs inside the kernel module */
+    cpumask_t *m = AllocMem(sizeof(cpumask_t), MEMF_PUBLIC | MEMF_CLEAR);
+
+    if (m)
+        *m = (cpumask_t)1 << (core % m68k64_CoreCount);
+    return m;
+}
+
+static void ping_task(void)
+{
+    int i;
+    /* ping runs before NewCreateTask() returns to the boot task, so it says who it is itself */
+    st.ping = FindTask(NULL);
+    for (i = 0; i < ROUNDS; i++)
+    {
+        Signal(st.pong, SIGF_SINGLE);
+        Wait(SIGF_SINGLE);
+    }
+    report_done();
+}
+
+static void pong_task(void)
+{
+    int i;
+    for (i = 0; i < ROUNDS; i++)
+    {
+        Wait(SIGF_SINGLE);
+        Signal(st.ping, SIGF_SINGLE);
+    }
+    report_done();
+}
+
+static void busy(int me)
+{
+    UQUAD i, last = st.count[!me];
+    for (i = 0; i < BUSY_STEPS; i++)
+    {
+        st.count[me]++;
+        if (st.count[!me] != last)
+        {
+            last = st.count[!me];
+            st.seen_other[me]++;
+        }
+    }
+    report_done();
+}
+/*
+    Workers bound to the cores in turn. exec's semaphores rely on Forbid(), which only keeps out
+    tasks on the same core in this AROS, so the shared count is atomic here. Each worker then signals
+    the boot task on core 0, which goes through core_DoCallIPI() from the other cores.
+*/
+static void worker(void)
+{
+    int i;
+
+    for (i = 0; i < WORKER_STEPS; i++)
+        __atomic_fetch_add(&st.shared, 1, __ATOMIC_RELAXED);
+    __atomic_fetch_or(&st.cores_seen, 1UL << GetCPUNumber(), __ATOMIC_RELAXED);
+    report_done();
+}
+
+/*
+    Faults in user state go to the task's tc_TrapCode: each fault task has a handler that notes the
+    vector and sends the task on to fault_resume, which ends it.
+*/
+#define FAULTS 4
+static const ULONG fault_want[FAULTS] = { 5, 8, 4, 2 };   /* divide by zero, privilege, illegal, bus */
+static volatile ULONG fault_got[FAULTS];
+
+static void fault_resume(void)
+{
+    report_done();
+    RemTask(NULL);
+}
+
+static void fault_trap(ULONG trap, struct ExceptionContext *ctx)
+{
+    IPTR n = (IPTR)FindTask(NULL)->tc_UserData;
+
+    if (n < FAULTS)
+        fault_got[n] = trap;
+    ctx->pc = (IPTR)fault_resume;
+}
+
+static void fault_task(void)
+{
+    struct Task *me = FindTask(NULL);
+
+    me->tc_TrapCode = (APTR)fault_trap;
+    switch ((IPTR)me->tc_UserData)
+    {
+    case 0: asm volatile ("   .short 0x7200, 0x80C1" : : : "d0", "d1", "cc"); break;   /* moveq #0,d1; divu.w d1,d0 */
+    case 1: asm volatile ("   .short 0x4E72, 0x2700"); break;     /* stop: privileged */
+    case 2: asm volatile ("   .short 0x4AFC"); break;             /* illegal */
+    case 3: (void)*(volatile UQUAD *)0x7000000000UL; break;       /* far outside RAM */
+    }
+    /* not reached when the fault was taken; fault_got stays 0 */
+    fault_resume();
+}
+
+/* No tc_TrapCode: exec's trap handler turns the fault into an alert for the task, a dead end */
+static void crash_task(void)
+{
+    (void)*(volatile UQUAD *)0x7000000000UL;
+}
+
+static void end_machine(unsigned long code)
+{
+    register unsigned long c asm("d0") = code;
+    for (;;)
+        asm volatile ("trap #2" : : "d"(c));
+}
+
+static void dump_list(struct KernelBase *KernelBase, const char *name, struct List *l)
+{
+    struct Node *n;
+    bug("[watchdog] %s:\n", name);
+    ForeachNode(l, n)
+    {
+        struct Task *t = (struct Task *)n;
+        bug("[watchdog]   0x%p '%s' state %d pri %d sigwait %08lx sigrecvd %08lx\n", t, n->ln_Name,
+            t->tc_State, n->ln_Pri, (unsigned long)t->tc_SigWait, (unsigned long)t->tc_SigRecvd);
+    }
+}
+
+static void watchdog(void)
+{
+    struct KernelBase *KernelBase = (struct KernelBase *)TLS_GET(KernelBase);
+    UQUAD i;
+    for (i = 0; i < 40000000UL; i++)
+        asm volatile ("" ::: "memory");
+    bug("[watchdog] passes %lu\n", (unsigned long)st.passes);
+    Disable();
+    dump_list(KernelBase, "ready", &SysBase->TaskReady);
+    dump_list(KernelBase, "wait", &SysBase->TaskWait);
+    end_machine(7);
+}
+
+/* The jump code that LoadSeg() and CreateSegList() put in front of a segment */
+static volatile int jmp_hit;
+static void jmp_target(void) { jmp_hit = 1; }
+
+static int jumpvec_test(void)
+{
+    struct FullJumpVec *v = AllocMem(sizeof(*v), MEMF_PUBLIC);
+    if (!v)
+        return 0;
+    __AROS_SET_FULLJMP(v, jmp_target);
+    ((void (*)(void))v)();
+    FreeMem(v, sizeof(*v));
+    return jmp_hit;
+}
+
+static void busy0(void) { busy(0); }
+static void busy1(void) { busy(1); }
+
+
+void qrx_selftest(const char *cmdline)
+{
+    struct KernelBase *KernelBase = (struct KernelBase *)TLS_GET(KernelBase);
+    ULONG got = 0;
+
+    st.boot = FindTask(NULL);
+    st.done_sig = AllocSignal(-1);
+    bug("[selftest] boot task 0x%p, done signal %d\n", st.boot, st.done_sig);
+    /* Nothing may be left in Forbid() or Disable() after the boot */
+    if (TLS_GET(TDNestCnt) != -1 || TLS_GET(IDNestCnt) != -1)
+    {
+        bug("[selftest] FAIL: TDNestCnt %d, IDNestCnt %d after the boot\n", (int)TLS_GET(TDNestCnt), (int)TLS_GET(IDNestCnt));
+        end_machine(1);
+    }
+
+    /* The busy tasks share the boot task's priority, ping and pong are above it */
+    st.pong = NewCreateTask(TASKTAG_NAME, "selftest pong", TASKTAG_PRI, 1, TASKTAG_PC, pong_task, TAG_DONE);
+    NewCreateTask(TASKTAG_NAME, "selftest ping", TASKTAG_PRI, 1, TASKTAG_PC, ping_task, TAG_DONE);
+    /* With more cores than one the busy tasks run on cores 1 and 2 (or 1 and 0), side by side */
+    NewCreateTask(TASKTAG_NAME, "selftest busy 0", TASKTAG_PRI, 0, TASKTAG_PC, busy0,
+                  TASKTAG_AFFINITY, core_mask(1), TAG_DONE);
+    NewCreateTask(TASKTAG_NAME, "selftest busy 1", TASKTAG_PRI, 0, TASKTAG_PC, busy1,
+                  TASKTAG_AFFINITY, core_mask(m68k64_CoreCount > 2 ? 2 : 0), TAG_DONE);
+
+    if (strstr(cmdline, "crashtest") && !strstr(cmdline, "rebooted"))
+    {
+        bug("[selftest] crash test: a task faults without a trap handler\n");
+        NewCreateTask(TASKTAG_NAME, "selftest crash", TASKTAG_PRI, 2, TASKTAG_PC, crash_task, TAG_DONE);
+        Wait(0);
+    }
+    if (strstr(cmdline, "reboottest") && !strstr(cmdline, "rebooted"))
+    {
+        bug("[selftest] reboot test: ColdReboot()\n");
+        ColdReboot();
+        bug("[selftest] FAIL: ColdReboot() returned\n");
+        end_machine(1);
+    }
+
+    if (strstr(cmdline, "watchdog"))
+        NewCreateTask(TASKTAG_NAME, "selftest watchdog", TASKTAG_PRI, -100, TASKTAG_PC, watchdog,
+                      TASKTAG_AFFINITY, core_mask(0), TAG_DONE);
+    {
+        int f;
+        for (f = 0; f < FAULTS; f++)
+            NewCreateTask(TASKTAG_NAME, "selftest fault", TASKTAG_PRI, 0, TASKTAG_PC, fault_task,
+                          TASKTAG_AFFINITY, core_mask(f), TASKTAG_USERDATA, (IPTR)f, TAG_DONE);
+    }
+
+    {
+        int w;
+        for (w = 0; w < WORKERS; w++)
+            NewCreateTask(TASKTAG_NAME, "selftest worker", TASKTAG_PRI, 0, TASKTAG_PC, worker,
+                          TASKTAG_AFFINITY, core_mask(w), TAG_DONE);
+    }
+
+    while (st.passes < 4 + WORKERS + FAULTS)
+        got |= Wait(1UL << st.done_sig);
+
+    bug("[selftest] ping/pong: %d rounds done\n", ROUNDS);
+    bug("[selftest] busy 0: %lu steps, saw busy 1 move %lu times\n",
+        (unsigned long)st.count[0], (unsigned long)st.seen_other[0]);
+    bug("[selftest] busy 1: %lu steps, saw busy 0 move %lu times\n",
+        (unsigned long)st.count[1], (unsigned long)st.seen_other[1]);
+
+    bug("[selftest] workers: %lu of %lu increments, ran on cores %08lx (%u cores)\n",
+        (unsigned long)st.shared, (unsigned long)WORKERS * WORKER_STEPS, (unsigned long)st.cores_seen, m68k64_CoreCount);
+
+    {
+        int f;
+        for (f = 0; f < FAULTS; f++)
+            bug("[selftest] fault %d: vector %lu, wanted %lu\n", f, (unsigned long)fault_got[f],
+                (unsigned long)fault_want[f]);
+    }
+
+    {
+        if (!jumpvec_test())
+        {
+            bug("[selftest] FAIL: jump vector\n");
+            end_machine(1);
+        }
+    }
+
+    {
+        int ok = fault_got[0] == fault_want[0] && fault_got[1] == fault_want[1] &&
+                 fault_got[2] == fault_want[2] && fault_got[3] == fault_want[3] &&
+                 st.count[0] == BUSY_STEPS && st.count[1] == BUSY_STEPS &&
+                 st.seen_other[0] > 0 && st.seen_other[1] > 0 &&
+                 st.shared == (UQUAD)WORKERS * WORKER_STEPS;
+        bug("[selftest] %s\n", ok ? "PASS: tasks switch, the timer preempts, cores signal each other, faults reach trap handlers" : "FAIL");
+        end_machine(ok ? 0 : 1);
+    }
+}
