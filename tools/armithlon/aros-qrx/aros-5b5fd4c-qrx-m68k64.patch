+/* sigsetjmp() for the 68100EC64: env at 8(sp). Layout: retaddr, D2-D7, A2-A6, then SP in regs[_JMPLEN-1] as __vfork expects. */
+#include "aros/m68k64/asm.h"
+	.text
+	.globl AROS_CDEFNAME(sigsetjmp)
+	.type AROS_CDEFNAME(sigsetjmp),@function
+AROS_CDEFNAME(sigsetjmp):
+	move.q (8,%sp), %a0
+	move.q (%sp), %d0
+	move.q %d0, (%a0)
+	movem.q %d2-%d7/%a2-%a6, (8,%a0)
+	lea (8,%sp), %a1
+	move.q %a1, (120,%a0)
+	moveq #0, %d0
+	rts
diff --git a/arch/m68k64-all/crt/posixc/vfork.s b/arch/m68k64-all/crt/posixc/vfork.s
new file mode 100644
index 00000000..a8dd3609
--- /dev/null
+++ b/arch/m68k64-all/crt/posixc/vfork.s
@@ -0,0 +1,23 @@
+/*
+    Copyright (c) 2026, The AROS Development Team. All rights reserved.
+    $Id$
+
+    Desc: POSIX function vfork(), 68100EC64 version. A jmp_buf (8 + 15*8 bytes) on the
+          stack is filled by setjmp(), then gets vfork's own return address and the stack
+          pointer the caller will have after vfork returns. __vfork() never returns.
+*/
+#include "aros/m68k64/asm.h"
+	.text
+	.globl AROS_CDEFNAME(vfork)
+	.type AROS_CDEFNAME(vfork),@function
+AROS_CDEFNAME(vfork):
+	suba.q #128, %sp
+	move.q %sp, %d0
+	move.q %d0, -(%sp)
+	jsr (AROS_CDEFNAME(setjmp),%pc)
+	lea (8,%sp), %a0
+	move.q (128,%a0), %d0
+	move.q %d0, (%a0)
+	lea (136,%a0), %a1
+	move.q %a1, (120,%a0)
+	jsr (AROS_CDEFNAME(__vfork),%pc)
