diff --git a/arch/m68k64-all/exec/newstackswap.c b/arch/m68k64-all/exec/newstackswap.c
new file mode 100644
index 00000000..1e420b78
--- /dev/null
+++ b/arch/m68k64-all/exec/newstackswap.c
@@ -0,0 +1,107 @@
+/*
+    Copyright (C) 2023, The AROS Development Team. All rights reserved.
+
+    Desc: NewStackSwap() - Call a function with swapped stack, 68100EC64 version
+*/
+
+#include <aros/debug.h>
+#include <exec/tasks.h>
+#include <proto/exec.h>
+
+#define _PUSH(sp, val) *--sp = (IPTR)val
+
+AROS_LH3(IPTR, NewStackSwap,
+        AROS_LHA(struct StackSwapStruct *,  sss, A0),
+        AROS_LHA(LONG_FUNC, entry, A1),
+        AROS_LHA(struct StackSwapArgs *, args, A2),
+        struct ExecBase *, SysBase, 134, Exec)
+{
+    AROS_LIBFUNC_INIT
+
+    volatile struct Task *t = FindTask(NULL);
+    volatile IPTR *sp = sss->stk_Pointer;
+    volatile APTR spreg = t->tc_SPReg;
+    volatile APTR splower = t->tc_SPLower;
+    volatile APTR spupper = t->tc_SPUpper;
+    IPTR ret;
+
+    if (args != NULL)
+    {
+        /* All arguments go on the stack, in 8-byte slots */
+        _PUSH(sp, args->Args[7]);
+        _PUSH(sp, args->Args[6]);
+        _PUSH(sp, args->Args[5]);
+        _PUSH(sp, args->Args[4]);
+        _PUSH(sp, args->Args[3]);
+        _PUSH(sp, args->Args[2]);
+        _PUSH(sp, args->Args[1]);
+        _PUSH(sp, args->Args[0]);
+    }
+
+    if (t->tc_Flags & TF_STACKCHK)
+    {
+        UBYTE* startfill = sss->stk_Lower;
+
+        while (startfill < (UBYTE *)sp)
+            *startfill++ = 0xE1;
+    }
+
+    /*
+     * We need to Disable() before changing limits and SP, otherwise
+     * stack check will fail if we get interrupted in the middle of this
+     */
+    D(bug("[NewStackSwap] SP 0x%p, entry point 0x%p\n", sp, entry));
+    Disable();
+
+    /* Change limits. The rest is done in asm below */
+    t->tc_SPReg = (APTR)sp;
+    t->tc_SPLower = sss->stk_Lower;
+    t->tc_SPUpper = sss->stk_Upper;
+
+    /*
+     * Switch the stack, Enable(), call the function, Disable(), switch back. The old SP
+     * stays in A2 and the block in A3, both preserved by the calls.
+     */
+    {
+        volatile IPTR blk[5];
+        blk[0] = (IPTR)sp;
+        blk[1] = (IPTR)__AROS_GETVECADDR(SysBase, 21);  /* Enable */
+        blk[2] = (IPTR)entry;
+        blk[3] = (IPTR)__AROS_GETVECADDR(SysBase, 20);  /* Disable */
+        blk[4] = (IPTR)SysBase;
+
+        asm volatile(
+            "\tmove.q %1, %%a3\n"
+            "\tmove.q %%sp, %%a2\n"
+            "\tmove.q (0,%%a3), %%sp\n"
+            "\tmove.q (32,%%a3), -(%%sp)\n"
+            "\tmove.q (8,%%a3), %%a0\n"
+            "\tjsr (%%a0)\n"
+            "\tadda.q #8, %%sp\n"
+            "\tmove.q (16,%%a3), %%a0\n"
+            "\tjsr (%%a0)\n"
+            "\tmove.q %%d0, -(%%sp)\n"
+            "\tmove.q (32,%%a3), -(%%sp)\n"
+            "\tmove.q (24,%%a3), %%a0\n"
+            "\tjsr (%%a0)\n"
+            "\tadda.q #8, %%sp\n"
+            "\tmove.q (%%sp)+, %%d0\n"
+            "\tmove.q %%a2, %%sp\n"
+            "\tmove.q %%d0, %0\n"
+            : "=m"(ret)
+            : "a"(blk)
+            : "d0", "d1", "a0", "a1", "a2", "a3", "memory", "cc");
+    }
+
+    /* Change limits back and return */
+    t->tc_SPReg = spreg;
+    t->tc_SPLower = splower;
+    t->tc_SPUpper = spupper;
+    Enable();
+
+    D(bug("[NewStackSwap] Returning 0x%p\n", ret));
+    return ret;
+
+    AROS_LIBFUNC_EXIT
+} /* NewStackSwap() */
+
diff --git a/arch/m68k64-all/exec/preparecontext.c b/arch/m68k64-all/exec/preparecontext.c
new file mode 100644
index 00000000..f676b7f1
--- /dev/null
+++ b/arch/m68k64-all/exec/preparecontext.c
@@ -0,0 +1,78 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: PrepareContext() - Prepare a task context for dispatch, 68100EC64 version.
+          All arguments are on the stack in 8-byte slots, below them the return address
+          (the fallback function), as a call through JSR would leave them.
+*/
+
+#include <exec/execbase.h>
+#include <exec/memory.h>
+#include <utility/tagitem.h>
+#include <proto/arossupport.h>
+#include <proto/kernel.h>
+#include <aros/m68k64/cpucontext.h>
+
+#include "exec_intern.h"
+#include "exec_util.h"
+#if defined(__AROSEXEC_SMP__)
+#include "etask.h"
+#endif
+
+BOOL PrepareContext(struct Task *task, APTR entryPoint, APTR fallBack,
+                    const struct TagItem *tagList, struct ExecBase *SysBase)
+{
+    struct TagItem *t;
+    struct ExceptionContext *ctx;
+    IPTR args[8] = {0};
+    int numargs = 0;
+    STACKIPTR *ctxsp = task->tc_SPReg;
+
+    if (!(task->tc_Flags & TF_ETASK) )
+        return FALSE;
+
+    ctx = KrnCreateContext();
+    task->tc_UnionETask.tc_ETask->et_RegFrame = ctx;
+    if (!ctx)
+        return FALSE;
+
+    while((t = LibNextTagItem((struct TagItem **)&tagList)))
+    {
+        switch(t->ti_Tag)
+        {
+#if defined(__AROSEXEC_SMP__)
+            case TASKTAG_AFFINITY:
+                IntETask(task->tc_UnionETask.tc_ETask)->iet_CpuAffinity = t->ti_Data;
+                break;
+#endif
+#define STACKARG(argno)                         \
+        case TASKTAG_ARG ## argno:              \
+            args[argno - 1] = t->ti_Data;       \
+            if (argno > numargs)                \
+                numargs = argno;                \
+            break;
+
+        STACKARG(1)
+        STACKARG(2)
+        STACKARG(3)
+        STACKARG(4)
+        STACKARG(5)
+        STACKARG(6)
+        STACKARG(7)
+        STACKARG(8)
+        }
+    }
+
+    while (numargs > 0)
+        *--ctxsp = args[--numargs];
+    *--ctxsp = (IPTR)fallBack;
+
+    task->tc_SPReg = ctxsp;
+    ctx->a[6] = 0;                  /* no frame above the entry point */
+    ctx->a[7] = (IPTR)ctxsp;
+    ctx->pc = (IPTR)entryPoint;
+    ctx->sr = CPUMODE_USER;         /* user state, all interrupt levels open */
+    ctx->Flags = 0;
+
+    return TRUE;
+} /* PrepareContext() */
diff --git a/arch/m68k64-all/exec/stackswap.S b/arch/m68k64-all/exec/stackswap.S
new file mode 100644
index 00000000..e83166e1
--- /dev/null
+++ b/arch/m68k64-all/exec/stackswap.S
@@ -0,0 +1,61 @@
+/*
+    Copyright (c) 2026, The AROS Development Team. All rights reserved.
+    $Id$
+
+    Desc: StackSwap(sss, SysBase), 68100EC64 version.
+
+    The caller removes its two argument slots after the return, from whichever stack it
+    is on by then. So the stack pointer kept in stk_Pointer is the one the caller has after
+    that cleanup, and the new stack gets two dummy slots below the return address.
+    The stack fill of TF_STACKCHK is not done yet.
+*/
+	#include <aros/m68k64/asm.h>
+
+	.text
+	.balign 4
+	.globl	AROS_SLIB_ENTRY(StackSwap,Exec,122)
+	.type	AROS_SLIB_ENTRY(StackSwap,Exec,122), @function
+AROS_SLIB_ENTRY(StackSwap,Exec,122):
+	move.q	%a2, -(%sp)
+	move.q	%a3, -(%sp)
+	move.q	(24,%sp), %a2		/* sss */
+	move.q	(32,%sp), %a3		/* SysBase */
+
+	move.q	%a3, -(%sp)
+	move.q	(Disable,%a3), %a0
+	jsr	(%a0)
+	adda.q	#8, %sp
+
+	move.q	%a3, -(%sp)		/* FindTask(NULL, SysBase) */
+	moveq	#0, %d0
+	move.q	%d0, -(%sp)
+	move.q	(FindTask,%a3), %a0
+	jsr	(%a0)
+	adda.q	#16, %sp		/* the task comes back in A0 */
+
+	move.q	(tc_SPLower,%a0), %d0
+	move.q	(stk_Lower,%a2), %d1
+	move.q	%d1, (tc_SPLower,%a0)
+	move.q	%d0, (stk_Lower,%a2)
+	move.q	(tc_SPUpper,%a0), %d0
+	move.q	(stk_Upper,%a2), %d1
+	move.q	%d1, (tc_SPUpper,%a0)
+	move.q	%d0, (stk_Upper,%a2)
+
+	lea	(40,%sp), %a0		/* old stack after the caller's cleanup */
+	move.q	(stk_Pointer,%a2), %d0
+	move.q	%a0, (stk_Pointer,%a2)
+	move.q	%a3, %d1		/* SysBase */
+	move.q	(16,%sp), %a1		/* return address */
+	move.q	(%sp)+, %a3
+	move.q	(%sp)+, %a2
+	move.q	%d0, %sp
+	suba.q	#16, %sp		/* dummy argument slots */
+	move.q	%a1, -(%sp)
+
+	move.q	%d1, -(%sp)
+	move.q	%d1, %a0
+	move.q	(Enable,%a0), %a0
+	jsr	(%a0)
+	adda.q	#8, %sp
+	rts
diff --git a/arch/m68k64-all/include/aros/atomic.h b/arch/m68k64-all/include/aros/atomic.h
new file mode 100644
index 00000000..43397306
--- /dev/null
+++ b/arch/m68k64-all/include/aros/atomic.h
@@ -0,0 +1,26 @@
+/*
+    Copyright (c) 2026, The AROS Development Team. All rights reserved.
+    $Id$
+
+    Desc: atomic operations for the 68100EC64. CAS is atomic between cores on aligned
+          addresses, so the compiler's CAS loops are enough.
+    Lang: english
+*/
+
+#ifndef AROS_M68K64_ATOMIC_H
+#define AROS_M68K64_ATOMIC_H
+
+#define __AROS_ATOMIC_INC_B(var)        (void)__atomic_fetch_add(&(var), 1, __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_INC_W(var)        (void)__atomic_fetch_add(&(var), 1, __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_INC_L(var)        (void)__atomic_fetch_add(&(var), 1, __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_DEC_B(var)        (void)__atomic_fetch_sub(&(var), 1, __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_DEC_W(var)        (void)__atomic_fetch_sub(&(var), 1, __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_DEC_L(var)        (void)__atomic_fetch_sub(&(var), 1, __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_AND_B(var, mask)  (void)__atomic_fetch_and(&(var), (mask), __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_AND_W(var, mask)  (void)__atomic_fetch_and(&(var), (mask), __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_AND_L(var, mask)  (void)__atomic_fetch_and(&(var), (mask), __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_OR_B(var, mask)   (void)__atomic_fetch_or(&(var), (mask), __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_OR_W(var, mask)   (void)__atomic_fetch_or(&(var), (mask), __ATOMIC_SEQ_CST)
+#define __AROS_ATOMIC_OR_L(var, mask)   (void)__atomic_fetch_or(&(var), (mask), __ATOMIC_SEQ_CST)
+
+#endif /* AROS_M68K64_ATOMIC_H */
diff --git a/arch/m68k64-all/include/aros/cpu.h b/arch/m68k64-all/include/aros/cpu.h
new file mode 100644
index 00000000..790d0891
--- /dev/null
+++ b/arch/m68k64-all/include/aros/cpu.h
@@ -0,0 +1,168 @@
+#ifndef AROS_M68K64_CPU_H
+#define AROS_M68K64_CPU_H
+
+/*
+    Copyright (c) 2026, The AROS Development Team. All rights reserved.
+    $Id$
+
+    NOTE: This file must compile *without* any other header !
+
+    Desc: cpu.h include file for the 68100EC64 in long mode (LP64, big endian)
+    Lang: english
+*/
+
+typedef unsigned char cpuid_t;
+typedef unsigned long cpumask_t;        /* one bit per core, at most 64 */
+
+/* Information about size and alignment,
+ * the defines have to be numeric constants */
+#define AROS_STACK_GROWS_DOWNWARDS 1
+#define AROS_BIG_ENDIAN            1
+#define AROS_SIZEOFULONG           4 /* Size of an ULONG */
+#define AROS_SIZEOFPTR             8 /* Size of a PTR */
+#define AROS_WORDALIGN             2 /* Alignment for WORD */
+#define AROS_LONGALIGN             4 /* Alignment for LONG */
+#define AROS_QUADALIGN             8 /* Alignment for QUAD */
+#define AROS_PTRALIGN              8 /* Alignment for PTR */
+#define AROS_IPTRALIGN             8 /* Alignment for IPTR */
+#define AROS_DOUBLEALIGN           8 /* Alignment for double */
+#define AROS_WORSTALIGN           16 /* Worst case alignment */
+#define AROS_STACKALIGN           16 /* Clean stack alignment */
+
+/* define this if we have no support for linear varargs in the compiler */
+#define NO_LINEAR_VARARGS       1
+
+#define AROS_SLOWSTACKTAGS      1
+#define AROS_SLOWSTACKMETHODS   1
+#define AROS_SLOWSTACKHOOKS     1
+#define AROS_SLOWSTACKFORMAT    1
+
+#define AROS_32BIT_TYPE         int
+#define AROS_64BIT_TYPE         long
+#define AROS_64BIT_STACKTYPE    long
+
+#define AROS_MAKE_INT64(i)  i ## L
+#define AROS_MAKE_UINT64(i) i ## UL
+
+#define __WORDSIZE              64
+
+#define STACKED __attribute__((aligned(8)))
+
+/* Use C pointer and string for the BCPL pointers and strings */
+#define AROS_FAST_BPTR 1
+#define AROS_FAST_BSTR 1
+
+/* types and limits for sig_atomic_t */
+#define AROS_SIG_ATOMIC_T       int
+#define AROS_SIG_ATOMIC_MIN     (-0x7fffffff-1)
+#define AROS_SIG_ATOMIC_MAX     0x7fffffff
+
+#define AROS_GET_SP ({ \
+       unsigned char *__sp; \
+       __asm__ __volatile__("move.q %%sp,%0" : "=a"(__sp)); \
+       __sp; \
+})
+
+/* do we need a function attribute to get parameters on the stack? */
+#define __stackparm
+
+/*
+ * Jump code for seglist headers (LoadSeg() and friends). (xxx).L sign extends in long
+ * mode, so a 64-bit target goes through A0, which the ABI does not preserve:
+ *     $A008 $207C <8 bytes>   movea.q #vec,a0
+ *     $4ED0                   jmp     (a0)
+ */
+struct FullJumpVec
+{
+    unsigned short prefix;
+    unsigned short movea;
+    void          *vec;
+    unsigned short jmp;
+} __attribute__((packed));
+
+#define __AROS_SET_FULLJMP(v,a) \
+do \
+{  \
+    struct FullJumpVec *_v = (v); \
+    _v->prefix = 0xA008;        \
+    _v->movea  = 0x207C;        \
+    _v->vec    = (a);           \
+    _v->jmp    = 0x4ED0;        \
+} while (0)
+
+/* The vector table holds pointers only, as on x86-64. */
+struct JumpVec
+{
+    void *vec;
+};
+
+/* Use these to access a vector table */
+#define LIB_VECTSIZE                    ((int)sizeof (struct JumpVec))
+#define __AROS_GETJUMPVEC(lib,n)        (&((struct JumpVec *)lib)[-(long)(n)])
+#define __AROS_GETVECADDR(lib,n)        (__AROS_GETJUMPVEC(lib,n)->vec)
+#define __AROS_SETVECADDR(lib,n,addr)   (__AROS_GETJUMPVEC(lib,n)->vec = (addr))
+#define __AROS_INITVEC(lib,n)           __AROS_SETVECADDR(lib,n,_aros_not_implemented)
+
+#undef UseExecstubs
+#define UseExecstubs 1
+
+/* Macros to test/set failure of AllocEntry() */
+#define AROS_ALLOCENTRY_FAILED(memType) \
+        ((struct MemList *)((IPTR)(memType) | 0x80ul<<(sizeof(APTR)-1)*8))
+#define AROS_CHECK_ALLOCENTRY(memList) \
+        (!((IPTR)(memList) & 0x80ul<<(sizeof(APTR)-1)*8))
+
+#define AROS_ALIGN(x)        (((x)+AROS_WORSTALIGN-1)&-AROS_WORSTALIGN)
+
+/* Prototypes */
+extern void _aros_not_implemented (char *);
+
+#define AROS_STACKSIZE  65536
+
+/*
+    Library calls use the compiler's calling convention (arguments on the stack), not the
+    m68k register mapping of 32-bit AmigaOS. The library base is the last argument.
+*/
+#define __AROS_LH_BASE(basetype,basename)   basetype basename
+#define __AROS_LP_BASE(basetype,basename)   void *
+#define __AROS_LC_BASE(basetype,basename)   basename
+#define __AROS_LD_BASE(basetype,basename)   basetype
+
+#define __AROS_LHA(type,name,reg)     type name
+#define __AROS_LPA(type,name,reg)     type
+#define __AROS_LCA(type,name,reg)     name
+#define __AROS_LDA(type,name,reg)     type
+#define __AROS_UFHA(type,name,reg)    type name
+#define __AROS_UFPA(type,name,reg)    type
+#define __AROS_UFCA(type,name,reg)    name
+#define __AROS_UFDA(type,name,reg)    type
+#define __AROS_LHA2(type,name,reg1,reg2)     type name
+#define __AROS_LPA2(type,name,reg1,reg2)     type
+#define __AROS_LCA2(type,name,reg1,reg2)     name
+#define __AROS_LDA2(type,name,reg1,reg2)     type
+
+#define __AROS_LH_PREFIX    /* eps */
+#define __AROS_LP_PREFIX    /* eps */
+#define __AROS_LC_PREFIX    /* eps */
+#define __AROS_LD_PREFIX    /* eps */
+#define __AROS_UFH_PREFIX   /* eps */
+#define __AROS_UFP_PREFIX   /* eps */
+#define __AROS_UFC_PREFIX   /* eps */
+#define __AROS_UFD_PREFIX   /* eps */
+
+#define AROS_HOST_BARRIER
+
+/*
+    Every object that uses a library defines __aros_libreq_<base>.<version> as an absolute
+    symbol. GNU ld accepts the same absolute value defined twice, lld does not, so these are weak;
+    collect-aros reads them as 'W' as well as 'A'.
+*/
+#define AROS_LIBREQ(bname, ver) \
+    asm volatile ( \
+                  ".weak __aros_libreq_" #bname "." #ver "\n" \
+                  "__aros_libreq_" #bname "." #ver "=" #ver);
+
+#define AROS_SWAP_BYTES_LONG_CPU(l)     __builtin_bswap32(l)
+#define AROS_SWAP_BYTES_WORD_CPU(l)     __builtin_bswap16(l)
+
+#endif /* AROS_M68K64_CPU_H */
diff --git a/arch/m68k64-all/include/aros/cpucontext.h b/arch/m68k64-all/include/aros/cpucontext.h
new file mode 100644
index 00000000..cf5b9989
--- /dev/null
+++ b/arch/m68k64-all/include/aros/cpucontext.h
@@ -0,0 +1,35 @@
+#ifndef AROS_M68K64_CPUCONTEXT_H
+#define AROS_M68K64_CPUCONTEXT_H
+
+/*
+    Copyright (c) 2026, The AROS Development Team. All rights reserved.
+    $Id$
+
+    Desc: CPU context of the 68100EC64 in long mode
+    Lang: english
+*/
+
+/* D0-D15 and A0-A15, 64 bits each. a[7] is the stack pointer of the task's own state. */
+#define M68K64_DREG_CNT 16
+#define M68K64_AREG_CNT 16
+
+struct ExceptionContext
+{
+    UQUAD d[M68K64_DREG_CNT];
+    UQUAD a[M68K64_AREG_CNT];
+    UQUAD pc;
+    UWORD sr;
+    UWORD Flags;            /* ECF_* below */
+    ULONG reserved;
+};
+
+#define ECF_FPU         (1 << 0)   /* No FPU yet, never set */
+
+/* SR values */
+#define SR_SUPERVISOR   0x2000
+#define SR_IPL_MASK     0x0700
+
+#define CPUMODE_SUPERVISOR  SR_SUPERVISOR
+#define CPUMODE_USER        0x0000
+
+#endif
diff --git a/arch/m68k64-all/include/aros/fenv.h b/arch/m68k64-all/include/aros/fenv.h
new file mode 100644
index 00000000..9326c14e
--- /dev/null
+++ b/arch/m68k64-all/include/aros/fenv.h
@@ -0,0 +1,275 @@
+/*
+    Copyright (C) 2023, The AROS Development Team. All rights reserved.
+
+    Desc: FPU-specific definitions for the 68100EC64
+*/
+
+#ifndef	_FENV_H_
+#define	_FENV_H_
+
+#include <aros/system.h>
+#include <aros/types/int_t.h>
+
+#ifndef	__fenv_static
+#define	__fenv_static	static
+#endif
+
+typedef	uint64_t	fenv_t;
+typedef	uint64_t	fexcept_t;
+
+/* Exception flags */
+#define	FE_INVALID	0x0010
+#define	FE_DIVBYZERO	0x0008
+#define	FE_OVERFLOW	0x0004
+#define	FE_UNDERFLOW	0x0002
+#define	FE_INEXACT	0x0001
+#define	FE_ALL_EXCEPT	(FE_DIVBYZERO | FE_INEXACT | \
+			 FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW)
+
+/*
+ * 68100EC64 Rounding modes
+ */
+#define	_ROUND_SHIFT	5
+#define	FE_TONEAREST	(0x00 << _ROUND_SHIFT)
+#define	FE_TOWARDZERO	(0x01 << _ROUND_SHIFT)
+#define	FE_DOWNWARD	(0x02 << _ROUND_SHIFT)
+#define	FE_UPWARD	(0x03 << _ROUND_SHIFT)
+#define	_ROUND_MASK	(FE_TONEAREST | FE_DOWNWARD | \
+			 FE_UPWARD | FE_TOWARDZERO)
+
+__BEGIN_DECLS
+
+/* Default floating-point environment */
+extern const fenv_t	__fe_dfl_env;
+#define	FE_DFL_ENV	(&__fe_dfl_env)
+
+/* The 68100EC64 has no FPU yet, and clang sets no float ABI macro for it: soft float. */
+#if !defined(__m68k64_float_abi_soft) && !defined(__m68k64_float_abi_double)
+#define __m68k64_float_abi_soft 1
+#endif
+
+#ifndef __m68k64_float_abi_soft
+/* No FPU on the 68100EC64 yet: floating point is soft, exception flags are not kept,
+   and rounding is always to nearest. */
+#define	__rfs(__fcsr)	((__fcsr) = 0)
+#define	__wfs(__fcsr)	((void)(__fcsr))
+#endif
+
+#ifdef __m68k64_float_abi_soft
+
+static __inline int feclearexcept(int __excepts)
+{
+    return 0;
+}
+
+static __inline int fegetexceptflag(fexcept_t *__flagp, int __excepts)
+{
+    *__flagp = 0;
+    return 0;
+}
+
+static __inline int fesetexceptflag(const fexcept_t *__flagp, int __excepts)
+{
+    return 0;
+}
+
+static __inline int feraiseexcept(int __excepts)
+{
+    return 0;
+}
+
+static __inline int fetestexcept(int __excepts)
+{
+    return 0;
+}
+
+static __inline int fegetround(void)
+{
+    return -1;
+}
+
+static __inline int fesetround(int __round)
+{
+    return -1;
+}
+
+static __inline int fegetenv(fenv_t *__envp)
+{
+    return 0;
+}
+
+static __inline int feholdexcept(fenv_t *__envp)
+{
+    *__envp = 0;
+    return 0;
+}
+
+static __inline int fesetenv(const fenv_t *__envp)
+{
+    return 0;
+}
+
+static __inline int feupdateenv(const fenv_t *__envp)
+{
+    return 0;
+}
+#else
+__fenv_static inline int
+feclearexcept(int __excepts)
+{
+
+	(void)(__excepts);
+
+	return (0);
+}
+
+__fenv_static inline int
+fegetexceptflag(fexcept_t *__flagp, int __excepts)
+{
+	fexcept_t __fcsr;
+
+	__rfs(__fcsr);
+	*__flagp = __fcsr & __excepts;
+
+	return (0);
+}
+
+__fenv_static inline int
+fesetexceptflag(const fexcept_t *__flagp, int __excepts)
+{
+	fexcept_t __fcsr;
+
+	__fcsr = *__flagp;
+	(void)(__excepts);
+	(void)(__fcsr & __excepts);
+
+	return (0);
+}
+
+__fenv_static inline int
+feraiseexcept(int __excepts)
+{
+
+	(void)(__excepts);
+
+	return (0);
+}
+
+__fenv_static inline int
+fetestexcept(int __excepts)
+{
+	fexcept_t __fcsr;
+
+	__rfs(__fcsr);
+
+	return (__fcsr & __excepts);
+}
+
+__fenv_static inline int
+fegetround(void)
+{
+	fexcept_t __fcsr;
+
+	__rfs(__fcsr);
+
+	return (__fcsr & _ROUND_MASK);
+}
+
+__fenv_static inline int
+fesetround(int __round)
+{
+	fexcept_t __fcsr;
+
+	if (__round & ~_ROUND_MASK)
+		return (-1);
+
+	__rfs(__fcsr);
+	__fcsr &= ~_ROUND_MASK;
+	__fcsr |= __round;
+	__wfs(__fcsr);
+
+	return (0);
+}
+
+__fenv_static inline int
+fegetenv(fenv_t *__envp)
+{
+
+	__rfs(*__envp);
+
+	return (0);
+}
+
+__fenv_static inline int
+feholdexcept(fenv_t *__envp __unused)
+{
+
+	/* No exception traps. */
+
+	return (-1);
+}
+
+__fenv_static inline int
+fesetenv(const fenv_t *__envp)
+{
+
+	__wfs(*__envp);
+
+	return (0);
+}
+
+__fenv_static inline int
+feupdateenv(const fenv_t *__envp)
+{
+	fexcept_t __fcsr;
+
+	__rfs(__fcsr);
+	__wfs(*__envp);
+	feraiseexcept(__fcsr & FE_ALL_EXCEPT);
+
+	return (0);
+}
+#endif /* !__m68k64_float_abi_soft */
+
+#if __BSD_VISIBLE
+
+/* We currently provide no external definitions of the functions below. */
+
+#ifdef __m68k64_float_abi_soft
+int feenableexcept(int __mask);
+int fedisableexcept(int __mask);
+int fegetexcept(void);
+#else
+static inline int
+feenableexcept(int __mask __unused)
+{
+
+	/* No exception traps. */
+
+	return (0);
+}
+
+static inline int
+fedisableexcept(int __mask __unused)
+{
+
+	/* No exception traps. */
+
+	return (0);
+}
+
+static inline int
+fegetexcept(void)
+{
+
+	/* No exception traps. */
+
+	return (0);
+}
+#endif /* !__m68k64_float_abi_soft */
+
+#endif /* __BSD_VISIBLE */
+
+__END_DECLS
+
+#endif	/* !_FENV_H_ */
diff --git a/arch/m68k64-all/include/aros/genmodule.h b/arch/m68k64-all/include/aros/genmodule.h
new file mode 100644
index 00000000..bda74faa
--- /dev/null
+++ b/arch/m68k64-all/include/aros/genmodule.h
@@ -0,0 +1,101 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: genmodule.h include file for the 68100EC64 in long mode
+
+    All arguments are on the stack in 8-byte slots, so a stub can jump to the library
+    function without touching them. The library base travels in A1, which the ABI
+    neither preserves nor uses for arguments (except as the rarely used 'nest' register).
+*/
+
+#ifndef AROS_M68K64_GENMODULE_H
+#define AROS_M68K64_GENMODULE_H
+
+#include <exec/execbase.h>
+
+/******************* Linklib Side Thunks ******************/
+
+/* Macro: AROS_GM_LIBFUNCSTUB(functionname, libbasename, lvo)
+   A stub for the stack call function 'functionname' of the library whose base is in the
+   variable 'libbasename'. lvo has to be a constant.
+*/
+#define __AROS_GM_LIBFUNCSTUB(fname, libbasename, lvo)                  \
+    void __ ## fname ## _ ## libbasename ## _wrapper(void)              \
+    {                                                                   \
+        asm volatile(                                                   \
+            ".weak " #fname "\n"                                        \
+            ".type " #fname ", @function\n"                             \
+            #fname ":\n"                                                \
+            "\tmove.q (" #libbasename ",%%pc), %%a1\n"                  \
+            "\tmove.q (%c0,%%a1), %%a0\n"                               \
+            "\tjmp (%%a0)\n"                                            \
+            : : "i" ((-lvo*LIB_VECTSIZE))                               \
+        );                                                              \
+    }
+#define AROS_GM_LIBFUNCSTUB(fname, libbasename, lvo) \
+    __AROS_GM_LIBFUNCSTUB(fname, libbasename, lvo)
+
+/* Macro: AROS_GM_RELLIBFUNCSTUB(functionname, libbasename, lvo)
+   Same as AROS_GM_LIBFUNCSTUB but finds the base at an offset in the current one.
+   __aros_getoffsettable() leaves the stack arguments alone and returns in A0.
+*/
+#define __AROS_GM_RELLIBFUNCSTUB(fname, libbasename, lvo)               \
+    void __ ## fname ## _ ## libbasename ## _relwrapper(void)           \
+    {                                                                   \
+        asm volatile(                                                   \
+            ".weak " #fname "\n"                                        \
+            ".type " #fname ", @function\n"                             \
+            #fname ":\n"                                                \
+            "\tjsr (__aros_getoffsettable,%%pc)\n"                      \
+            "\tmove.q (__aros_rellib_offset_" #libbasename ",%%pc), %%d0\n" \
+            "\tmove.q (0,%%a0,%%d0), %%a1\n"                            \
+            "\tmove.q (%c0,%%a1), %%a0\n"                               \
+            "\tjmp (%%a0)\n"                                            \
+            : : "i" ((-lvo*LIB_VECTSIZE))                               \
+        );                                                              \
+    }
+#define AROS_GM_RELLIBFUNCSTUB(fname, libbasename, lvo) \
+    __AROS_GM_RELLIBFUNCSTUB(fname, libbasename, lvo)
+
+/* Macro: AROS_GM_LIBFUNCALIAS(functionname, alias)
+   An alias 'alias' for function 'functionname'
+*/
+#define __AROS_GM_LIBFUNCALIAS(fname, alias) \
+    asm(".weak " #alias "\n" \
+        "\t.set " #alias "," #fname \
+    );
+#define AROS_GM_LIBFUNCALIAS(fname, alias) \
+    __AROS_GM_LIBFUNCALIAS(fname, alias)
+
+/******************* Library Side Thunks ******************/
+
+/* The caller used one of the stubs above, so the base is in A1. */
+#define __GM_STRINGIZE(x) #x
+#define __AROS_GM_STACKCALL(fname, libbasename, libfuncname)            \
+    void libfuncname(void);                                             \
+    void __ ## fname ## _stackcall(void)                                \
+    {                                                                   \
+        asm volatile(                                                   \
+            "\t" __GM_STRINGIZE(libfuncname) ":\n"                      \
+            "\tmove.q %%a1, -(%%sp)\n"                                  \
+            "\tjsr (__aros_setoffsettable,%%pc)\n"                      \
+            "\tadda.q #8, %%sp\n"                                       \
+            "\tjmp (" #fname ",%%pc)\n"                                 \
+        );                                                              \
+    }
+
+#define AROS_GM_STACKCALL(fname, libbasename, lvo) \
+     __AROS_GM_STACKCALL(fname, libbasename, AROS_SLIB_ENTRY(fname, libbasename, lvo))
+
+/* Macro: AROS_GM_STACKALIAS(functionname, libbasename, lvo)
+   An alias for function 'functionname'
+*/
+#define __AROS_GM_STACKALIAS(fname, alias) \
+    void alias(void); \
+    asm(".weak " __GM_STRINGIZE(alias) "\n" \
+        "\t.set " __GM_STRINGIZE(alias) "," #fname \
+    );
+#define AROS_GM_STACKALIAS(fname, libbasename, lvo) \
+    __AROS_GM_STACKALIAS(fname, AROS_SLIB_ENTRY(fname, libbasename, lvo))
+
+#endif /* AROS_M68K64_GENMODULE_H */
