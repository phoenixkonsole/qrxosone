diff --git a/arch/m68k64-all/exec/alert_cpu.c b/arch/m68k64-all/exec/alert_cpu.c
new file mode 100644
index 00000000..c06d9eed
--- /dev/null
+++ b/arch/m68k64-all/exec/alert_cpu.c
@@ -0,0 +1,42 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: 68100EC64 CPU context parsing routines.
+*/
+
+#include <exec/rawfmt.h>
+#include <proto/exec.h>
+
+#include "exec_intern.h"
+#include "exec_util.h"
+
+static const char *gpr_fmt =
+    "D0=%016lx D1=%016lx D2=%016lx D3=%016lx\n"
+    "D4=%016lx D5=%016lx D6=%016lx D7=%016lx\n"
+    "A0=%016lx A1=%016lx A2=%016lx A3=%016lx\n"
+    "A4=%016lx A5=%016lx A6=%016lx SP=%016lx\n"
+    "PC=%016lx SR=%04lx\n";
+
+char *FormatCPUContext(char *buffer, struct ExceptionContext *ctx, struct ExecBase *SysBase)
+{
+    VOID_FUNC dest = buffer ? RAWFMTFUNC_STRING : RAWFMTFUNC_SERIAL;
+    char *buf;
+
+    buf = NewRawDoFmt(gpr_fmt, dest, buffer,
+                      ctx->d[0], ctx->d[1], ctx->d[2], ctx->d[3],
+                      ctx->d[4], ctx->d[5], ctx->d[6], ctx->d[7],
+                      ctx->a[0], ctx->a[1], ctx->a[2], ctx->a[3],
+                      ctx->a[4], ctx->a[5], ctx->a[6], ctx->a[7],
+                      ctx->pc, (IPTR)ctx->sr);
+
+    return buf - 1;
+}
+
+/* LINK A6 leaves the caller's A6 at (A6) and the return address above it. */
+APTR UnwindFrame(APTR fp, APTR *caller)
+{
+    APTR *frame = fp;
+
+    *caller = frame[1];
+    return frame[0];
+}
diff --git a/arch/m68k64-all/exec/execstubs.s b/arch/m68k64-all/exec/execstubs.s
new file mode 100644
index 00000000..70b4de08
--- /dev/null
+++ b/arch/m68k64-all/exec/execstubs.s
@@ -0,0 +1,47 @@
+/*
+    Copyright (c) 2026, The AROS Development Team. All rights reserved.
+    $Id$
+
+    Desc: Stubs to call C functions while preserving all registers, 68100EC64 version.
+          The ABI saves D2-D7 and A2-A6 itself; these stubs also keep D0, D1, A0 and A1.
+          The compiler does not use D8-D15 and A8-A15 yet, so nothing saves them here. The stubbed functions take at most two
+          arguments (the second is the library base), copied below the saved registers.
+          ';' starts a comment in m68k assembly, so this is an assembler macro.
+    Lang: english
+*/
+
+#include "aros/m68k64/asm.h"
+
+	.macro STUB cname, name
+	.globl \cname
+	.type \cname, @function
+\cname:
+	suba.q #32, %sp
+	move.q %d0, (0,%sp)
+	move.q %d1, (8,%sp)
+	move.q %a0, (16,%sp)
+	move.q %a1, (24,%sp)
+	move.q (48,%sp), -(%sp)
+	move.q (48,%sp), -(%sp)
+	jsr (\name,%pc)
+	adda.q #16, %sp
+	move.q (0,%sp), %d0
+	move.q (8,%sp), %d1
+	move.q (16,%sp), %a0
+	move.q (24,%sp), %a1
+	adda.q #32, %sp
+	rts
+	.endm
+
+	.text
+
+#ifdef  UseExecstubs
+	STUB AROS_SLIB_ENTRY(Disable,Exec,20), AROS_CSYMNAME(_Exec_20_Disable)
+	STUB AROS_SLIB_ENTRY(Enable,Exec,21), AROS_CSYMNAME(_Exec_21_Enable)
+	STUB AROS_SLIB_ENTRY(Forbid,Exec,22), AROS_CSYMNAME(_Exec_22_Forbid)
+	STUB AROS_SLIB_ENTRY(Permit,Exec,23), AROS_CSYMNAME(_Exec_23_Permit)
+
+	STUB AROS_SLIB_ENTRY(ObtainSemaphore,Exec,94), AROS_CSYMNAME(_Exec_94_ObtainSemaphore)
+	STUB AROS_SLIB_ENTRY(ReleaseSemaphore,Exec,95), AROS_CSYMNAME(_Exec_95_ReleaseSemaphore)
+	STUB AROS_SLIB_ENTRY(ObtainSemaphoreShared,Exec,113), AROS_CSYMNAME(_Exec_113_ObtainSemaphoreShared)
+#endif
