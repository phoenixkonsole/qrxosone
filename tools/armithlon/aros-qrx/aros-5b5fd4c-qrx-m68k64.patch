diff --git a/arch/m68k64-native/kernel/intr.c b/arch/m68k64-native/kernel/intr.c
new file mode 100644
index 00000000..848a5610
--- /dev/null
+++ b/arch/m68k64-native/kernel/intr.c
@@ -0,0 +1,451 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Exceptions and interrupts of the 68100EC64 in long mode, see docs/armithlon/68100ec64.md
+    in QRX OS One. All 256 vectors go to one entry, which reads the vector number from the
+    frame, builds a struct ExceptionContext on the supervisor stack and calls cpu_Exception().
+*/
+
+#include <inttypes.h>
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+#include <aros/m68k64/cpucontext.h>
+#include <hardware/intbits.h>
+#include <stddef.h>
+#include <string.h>
+
+#include "kernel_base.h"
+
+#include <proto/exec.h>
+#include <proto/kernel.h>
+
+#include "kernel_cpu.h"
+#include "kernel_intern.h"
+#include "kernel_debug.h"
+#include "kernel_interrupts.h"
+#include "kernel_intr.h"
+#include "kernel_syscall.h"
+#include "kernel_scheduler.h"
+#include "kernel_smp.h"
+
+#define DTRAP(x)
+#define SC_M68K64_PENDING   0x70    /* exec's Enable(), see cpu_RunPending() */
+
+_Static_assert(offsetof(tls_t, SuperDepth) == TLS_SUPERDEPTH_OFFSET, "the exception entry counts at offset 36");
+
+extern void cpu_Trap3(regs_t *regs);
+
+#define D(x)
+#define DIRQ(x)
+
+/* The frame period of the core timer: 50 Hz, the VBlank rate exec schedules by */
+#define M68K64_TIMER_US         20000
+
+void ictl_enable_irq(uint8_t irq, struct KernelBase *KernelBase)
+{
+}
+
+void ictl_disable_irq(uint8_t irq, struct KernelBase *KernelBase)
+{
+}
+
+/*
+    The exception entry. On entry SP is the supervisor stack and holds the frame:
+        0 SR, 2 format and vector offset, 4 reserved, 8 PC, and for format 1 16 the fault address.
+    struct ExceptionContext (272 bytes) goes below it:
+        0 d[16], 128 a[16] (a[7] at 184), 256 pc, 264 sr, 266 Flags, 268 reserved
+    The exit reads the frame's format again to put the stack back where it was: the context may
+    belong to another task by then, after a task switch.
+
+    Privileged instructions llvm-mc does not know yet are written as words:
+        $007C $0700     ori.w #$0700,sr     mask interrupts while the kernel runs
+        $4E7A $8800     movec usp,a0
+        $4E7B $8800     movec a0,usp
+*/
+asm (
+    "   .text\n"
+    "   .globl  __m68k64_exception\n"
+    "   .type   __m68k64_exception,@function\n"
+    "   .p2align 2\n"
+    "__m68k64_exception:\n"
+    "   .short  0x007C, 0x0700\n"
+    "   suba.q  #272, %sp\n"
+    "   movem.q %d0-%d7, (0,%sp)\n"
+    "   movem.q %a0-%a6, (128,%sp)\n"
+    "   moveq   #16, %d1\n"
+    "   move.w  (274,%sp), %d0\n"
+    "   lsr.w   #8, %d0\n"
+    "   lsr.w   #4, %d0\n"
+    "   cmpi.w  #1, %d0\n"
+    "   bne     1f\n"
+    "   moveq   #24, %d1\n"
+    "1: move.l  %d1, (268,%sp)\n"
+    "   move.w  (272,%sp), %d0\n"
+    "   move.w  %d0, (264,%sp)\n"
+    "   move.w  #0, (266,%sp)\n"
+    "   move.q  (280,%sp), %a0\n"
+    "   move.q  %a0, (256,%sp)\n"
+    "   btst    #13, %d0\n"
+    "   bne     2f\n"
+    "   .short  0x4E7A, 0x8800\n"
+    "   bra     3f\n"
+    "2: lea     (272,%sp), %a0\n"
+    "   adda.q  %d1, %a0\n"
+    "3: move.q  %a0, (184,%sp)\n"
+    /* A8 is the core's TLS. A core that is just starting has none yet: see kernel_smp.c */
+    "   .short  0xA009, 0x2048\n"          /* movea.q a8,a0 */
+    "   move.q  %a0, %d2\n"
+    "   bne     7f\n"
+    "   move.q  %sp, %a0\n"
+    "   move.q  %a0, -(%sp)\n"
+    "   jsr     (cpu_SecondaryStart,%pc)\n"
+    "   adda.q  #8, %sp\n"
+    "   bra     8f\n"
+    "7: move.l  (36,%a0), %d0\n"         /* TLS SuperDepth + 1: KrnIsSuper() */
+    "   add.l   #1, %d0\n"
+    "   move.l  %d0, (36,%a0)\n"
+    "   moveq   #0, %d0\n"
+    "   move.w  (274,%sp), %d0\n"
+    "   and.l   #4095, %d0\n"
+    "   lsr.l   #2, %d0\n"
+    "   move.q  %sp, %a0\n"
+    "   move.q  %d0, -(%sp)\n"
+    "   move.q  %a0, -(%sp)\n"
+    "   jsr     (cpu_Exception,%pc)\n"
+    "   adda.q  #16, %sp\n"
+    "8:\n"
+    "   .short  0xA009, 0x2048\n"           /* movea.q a8,a0 */
+    "   move.l  (36,%a0), %d0\n"
+    "   sub.l   #1, %d0\n"
+    "   move.l  %d0, (36,%a0)\n"
+    /* Back to user state: the frame goes where it came from, the user stack into USP */
+    "   move.w  (264,%sp), %d0\n"
+    "   btst    #13, %d0\n"
+    "   bne     4f\n"
+    "   move.q  (184,%sp), %a0\n"
+    "   .short  0x4E7B, 0x8800\n"
+    /* The frame size again from the hardware frame: 'reserved' belongs to the task now */
+    "   moveq   #16, %d1\n"
+    "   move.w  (274,%sp), %d2\n"
+    "   lsr.w   #8, %d2\n"
+    "   lsr.w   #4, %d2\n"
+    "   cmpi.w  #1, %d2\n"
+    "   bne     6f\n"
+    "   moveq   #24, %d1\n"
+    "6: lea     (272,%sp), %a0\n"
+    "   adda.q  %d1, %a0\n"
+    "   suba.q  #16, %a0\n"
+    "   move.q  %a0, (184,%sp)\n"
+    "   bra     5f\n"
+    /* Back to supervisor state: the frame goes just below the stack the context names */
+    "4: move.q  (184,%sp), %a0\n"
+    "   suba.q  #16, %a0\n"
+    "   move.q  %a0, (184,%sp)\n"
+    "5: move.w  %d0, (0,%a0)\n"
+    "   move.w  #0, (2,%a0)\n"
+    "   move.l  #0, (4,%a0)\n"
+    "   move.q  (256,%sp), %a1\n"
+    "   move.q  %a1, (8,%a0)\n"
+    "   movem.q (0,%sp), %d0-%d7\n"
+    "   movem.q (128,%sp), %a0-%a6\n"
+    "   move.q  (184,%sp), %sp\n"
+    "   rte\n"
+    "   .size   __m68k64_exception, .-__m68k64_exception\n"
+);
+
+extern void __m68k64_exception(void);
+
+/* 256 vectors of 8 bytes, 8-byte aligned, as VBR wants them */
+static void *cpu_Vectors[EXCEPTIONS_COUNT] __attribute__((aligned(8)));
+
+void cpu_SetupVectors(void)
+{
+    void *table = cpu_Vectors;
+    int i;
+
+    for (i = 0; i < EXCEPTIONS_COUNT; i++)
+        cpu_Vectors[i] = (void *)__m68k64_exception;
+
+    /* movec a0,vbr: $4E7B $8801 */
+    asm volatile (
+        "   move.q  %0, %%a0\n"
+        "   .short  0x4E7B, 0x8801\n"
+        : : "a"(table) : "a0", "memory");
+}
+
+void cpu_StartTimer(void)
+{
+    unsigned long period = M68K64_TIMER_US;
+
+    /* movec d0,$80C: $4E7B $080C */
+    asm volatile (
+        "   move.q  %0, %%d0\n"
+        "   .short  0x4E7B, 0x080C\n"
+        : : "d"(period) : "d0");
+}
+
+static void cpu_RunPending(regs_t *regs, struct KernelBase *KernelBase);
+
+static void cpu_Syscall(regs_t *regs)
+{
+    unsigned long sc = regs->d[0];
+
+    switch (sc)
+    {
+    case SC_CLI:
+        regs->sr |= 0x0700;
+        break;
+
+    case SC_STI:
+        regs->sr &= ~0x0700;
+        break;
+
+    case SC_SUPERSTATE:
+        regs->sr |= SR_SUPERVISOR | 0x0700;
+        break;
+
+    case SC_ISSUPERSTATE:
+        regs->d[0] = (regs->sr & SR_SUPERVISOR) ? 1 : 0;
+        break;
+
+    case SC_M68K64_PENDING:
+        /* Enable() of the soft Disable(): the interrupts that came meanwhile */
+        if (!(regs->sr & SR_SUPERVISOR))
+            cpu_RunPending(regs, (struct KernelBase *)TLS_GET(KernelBase));
+        break;
+
+    case SC_GETCPUNUMBER:
+        regs->d[0] = GetCPUNumber();
+        break;
+
+    case SC_CACHECLEARE:
+        /* No caches to clear on the reference core */
+        break;
+
+    case SC_REBOOT:
+        /*
+            The end of exec's reset callbacks, D1 is the SD_ACTION. The reference machine has no reset
+            line: the run ends with M68K64_END_POWEROFF + action and the boot loader starts the
+            system again for a reboot (movec d0,$8F1 ends all cores).
+        */
+        bug("[Kernel:%02u] %s\n", GetCPUNumber(),
+            regs->d[1] == 0 ? "power off" : regs->d[1] == 1 ? "cold reboot" : "warm reboot");
+        asm volatile ("   move.q %0, %%d0\n   .short 0x4E7B, 0x08F1"
+                      : : "d"(M68K64_END_POWEROFF + (regs->d[1] & 3)) : "d0");
+        for (;;)
+            asm volatile (".short 0x4E72, 0x2700");
+
+    default:
+        /* Task switches happen only on the way back to a task in user state */
+        if (!(regs->sr & SR_SUPERVISOR))
+            core_SysCall(sc, regs);
+        break;
+    }
+}
+
+/*
+    A fault: the kernel's exception handlers first (KrnAddExceptionHandler), then, for a task in user
+    state, its tc_TrapCode, or exec's, which turns the fault into an alert for the task. Vector numbers
+    are the 68000's and so the Amiga trap numbers. A fault in supervisor state, or with no exec yet,
+    stops the core with a register dump.
+*/
+static void cpu_Dump(regs_t *regs, unsigned long vector)
+{
+    int i;
+    UQUAD *sp = (UQUAD *)regs->a[7];
+
+    bug("[Kernel:%02u] exception %lu at pc 0x%016lx, sr 0x%04x\n", GetCPUNumber(), vector,
+        (unsigned long)regs->pc, regs->sr);
+    for (i = 0; i < 8; i++)
+        bug("[Kernel] d%d %016lx  a%d %016lx\n", i, (unsigned long)regs->d[i],
+            i, (unsigned long)regs->a[i]);
+    bug("[Kernel] stack:");
+    for (i = 0; i < 8; i++)
+        bug(" %016lx", (unsigned long)sp[i]);
+    bug("\n[Kernel] task 0x%p '%s'\n", GET_THIS_TASK,
+        GET_THIS_TASK ? GET_THIS_TASK->tc_Node.ln_Name : "");
+}
+
+static void cpu_Fault(regs_t *regs, unsigned long vector)
+{
+    struct KernelBase *KernelBase = (struct KernelBase *)TLS_GET(KernelBase);
+    struct Task *task = GET_THIS_TASK;
+
+    if (KernelBase && krnRunExceptionHandlers(KernelBase, vector, regs))
+        return;
+
+    if (SysBase && task && !(regs->sr & SR_SUPERVISOR))
+    {
+        void (*trap)(ULONG, struct ExceptionContext *) = task->tc_TrapCode;
+
+        if (!trap)
+            trap = SysBase->TaskTrapCode;
+        if (trap)
+        {
+            DTRAP(bug("[Kernel:%02u] exception %lu in '%s', trap code 0x%p\n", GetCPUNumber(), vector,
+                task->tc_Node.ln_Name, trap));
+            /* It may change the context (exec's sends the task to its crash handler) or not return */
+            trap(vector, regs);
+            core_ExitInterrupt(regs);
+            return;
+        }
+    }
+
+    cpu_Dump(regs, vector);
+    for (;;)
+        asm volatile (".short 0x4E72, 0x2700");     /* stop #$2700 */
+}
+
+/*
+    "idledump" on the command line: when core 0 has only run its idle task for 5 seconds, print
+    every task with its state, signals and PC once. A help for finding tasks that wait forever.
+*/
+int m68k64_IdleDump;
+
+static void dump_tasklist(struct KernelBase *KernelBase, const char *name, struct List *l)
+{
+    struct Node *n;
+    int k = 0;
+
+    bug("[Kernel] %s:\n", name);
+    ForeachNode(l, n)
+    {
+        struct Task *t = (struct Task *)n;
+        struct ExceptionContext *ctx = (t->tc_Flags & TF_ETASK) && t->tc_UnionETask.tc_ETask ?
+                                       t->tc_UnionETask.tc_ETask->et_RegFrame : NULL;
+
+        bug("[Kernel]   0x%p '%s' type %d state %d pri %d wait %08lx recvd %08lx pc 0x%lx\n", t,
+            n->ln_Name ? n->ln_Name : "", n->ln_Type, t->tc_State, n->ln_Pri, (unsigned long)t->tc_SigWait,
+            (unsigned long)t->tc_SigRecvd, ctx ? (unsigned long)ctx->pc : 0UL);
+        if (++k > 60)
+            break;
+    }
+}
+
+static void idle_watch(struct KernelBase *KernelBase)
+{
+    static unsigned int idle_ticks;
+    static int done;
+    struct Task *t = GET_THIS_TASK;
+
+    if (done || !SysBase)
+        return;
+    if (t && t->tc_Node.ln_Pri == -127)
+        idle_ticks++;
+    else
+        idle_ticks = 0;
+    if (idle_ticks < 250)
+        return;
+    done = 1;
+    bug("[Kernel] core 0 idle for 5 s, the tasks:\n");
+    dump_tasklist(KernelBase, "ready", &SysBase->TaskReady);
+    dump_tasklist(KernelBase, "waiting", &SysBase->TaskWait);
+}
+
+/* One interrupt level's work, without the reschedule on the way out */
+static void cpu_Interrupt(regs_t *regs, unsigned int level, struct KernelBase *KernelBase)
+{
+    if (level == M68K64_IRQ_TIMER)
+    {
+        DIRQ(bug("[Kernel] timer\n"));
+        if (GetCPUNumber() == 0)
+        {
+            /* Core 0 runs the VBlank servers, which also count its quantum */
+            if (KernelBase)
+                krnRunIRQHandlers(KernelBase, IRQ_TIMER);
+            if (m68k64_IdleDump && KernelBase)
+                idle_watch(KernelBase);
+            if (SysBase && (IDNESTCOUNT_GET < 0))
+                core_Cause(INTB_VERTB, 1L << INTB_VERTB);
+        }
+        else
+        {
+            /* The other cores only count their own quantum, as the VBlank server does */
+            if (!SCHEDELAPSED_GET || (--SCHEDELAPSED_GET == 0))
+            {
+                FLAG_SCHEDQUANTUM_SET;
+                FLAG_SCHEDSWITCH_SET;
+            }
+        }
+    }
+    else if (level == M68K64_IRQ_IPI)
+    {
+        DIRQ(bug("[Kernel] signal from another core\n"));
+        cpu_HandleIPI(regs);
+    }
+    else if (KernelBase)
+        krnRunIRQHandlers(KernelBase, level);
+}
+
+/*
+    The interrupts that came while the task in user state was Disable()d (the soft Disable(),
+    see exec's disable.c): from Enable()'s trap, or on the way back to a task that is enabled.
+*/
+static void cpu_RunPending(regs_t *regs, struct KernelBase *KernelBase)
+{
+    unsigned long bits = __atomic_exchange_n(&TLS_PTR_GET()->IntPending, 0, __ATOMIC_ACQ_REL);
+    unsigned int level;
+
+    for (level = 1; level <= 7; level++)
+        if (bits & (1UL << level))
+            cpu_Interrupt(regs, level, KernelBase);
+    core_ExitInterrupt(regs);
+}
+
+void cpu_Exception(regs_t *regs, unsigned long vector)
+{
+    struct KernelBase *KernelBase = (struct KernelBase *)TLS_GET(KernelBase);
+
+    if (vector >= M68K64_VEC_IRQ(1) && vector <= M68K64_VEC_IRQ(7))
+    {
+        unsigned int level = vector - M68K64_VEC_IRQ(0);
+
+        if (!(regs->sr & SR_SUPERVISOR) && IDNESTCOUNT_GET >= 0)
+        {
+            /* The task is Disable()d: noted, Enable() runs it */
+            __atomic_fetch_or(&TLS_PTR_GET()->IntPending, 1UL << level, __ATOMIC_ACQ_REL);
+            return;
+        }
+        cpu_Interrupt(regs, level, KernelBase);
+        if (!(regs->sr & SR_SUPERVISOR))
+            core_ExitInterrupt(regs);
+    }
+    else switch (vector)
+    {
+    case M68K64_VEC_TRAP(0):
+        cpu_Syscall(regs);
+        break;
+
+    case M68K64_VEC_TRAP(3):
+        cpu_Trap3(regs);
+        break;
+
+    case M68K64_VEC_TRAP(2):
+        /* Test machine only: end the run with the code in D0, movec d0,$8F1 */
+        asm volatile ("   move.q %0, %%d0\n   .short 0x4E7B, 0x08F1" : : "d"(regs->d[0]) : "d0");
+        break;
+
+    case M68K64_VEC_TRAP(4):
+        /* KrnMayGetChar: the next console input character or -1 in D0, movec $8F0,d0 */
+        {
+            long ch;
+            asm volatile ("   .short 0x4E7A, 0x08F0\n   move.q %%d0, %0" : "=d"(ch) : : "d0");
+            regs->d[0] = ch;
+        }
+        break;
+
+    case M68K64_VEC_TRAP(1):
+        /* krnPutC: the character in D0 to the console, movec d0,$8F0 */
+        asm volatile ("   move.q %0, %%d0\n   .short 0x4E7B, 0x08F0" : : "d"(regs->d[0]) : "d0");
+        break;
+
+    default:
+        cpu_Fault(regs, vector);
+        break;
+    }
+
+    /* Back to a task in user state that is enabled (after a switch, say): what is pending runs now */
+    if (!(regs->sr & SR_SUPERVISOR) && IDNESTCOUNT_GET < 0 &&
+        __atomic_load_n(&TLS_PTR_GET()->IntPending, __ATOMIC_ACQUIRE))
+        cpu_RunPending(regs, KernelBase);
+}
diff --git a/arch/m68k64-native/kernel/issuper.c b/arch/m68k64-native/kernel/issuper.c
new file mode 100644
index 00000000..130a4216
--- /dev/null
+++ b/arch/m68k64-native/kernel/issuper.c
@@ -0,0 +1,28 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    KrnIsSuper on the 68100EC64. MOVE from SR is privileged in long mode, and a trap for every
+    call costs hundreds of instructions (exec asks very often). Instead the exception entry in
+    intr.c counts the exceptions this core is in, in its TLS; the boot, which runs in supervisor
+    state before any exception, counts as one. A8 (the TLS) is readable in user state too.
+    See rom/kernel/issuper.c for documentation.
+*/
+
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+
+#include <kernel_base.h>
+
+#include <proto/kernel.h>
+
+#include "tls.h"
+
+AROS_LH0I(int, KrnIsSuper,
+         struct KernelBase *, KernelBase, 13, Kernel)
+{
+    AROS_LIBFUNC_INIT
+
+    return TLS_PTR_GET()->SuperDepth != 0;
+
+    AROS_LIBFUNC_EXIT
+}
