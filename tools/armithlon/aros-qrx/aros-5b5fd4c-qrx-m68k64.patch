+/* around a Wait() inside a qrx_local_forbid() section: the next task must not inherit the local part */
+static inline void qrx_local_forbid_suspend(void) { tls_t *t = TLS_PTR_GET(); QRX_LOCAL_BARRIER(); t->LocalTDNest--; QRX_LOCAL_BARRIER(); }
+static inline void qrx_local_forbid_resume(void) { tls_t *t = TLS_PTR_GET(); QRX_LOCAL_BARRIER(); t->LocalTDNest++; QRX_LOCAL_BARRIER(); }
