+/* Waiting for a key: a timer tick of 10 ms through timer.device, exec only (the handler has no
+ * DOSBase). Polling with Reschedule() starved every program below the handler's priority. */
+static void econsole_nap(void)
+{
+    static struct MsgPort *port;
+    static struct timerequest *tr;
+    static int state;                   /* 0 untried, 1 ready, -1 none: fall back to Reschedule */
+    if (state == 0) {
+        state = -1;
+        port = CreateMsgPort();
+        if (port) {
+            tr = (struct timerequest *)CreateIORequest(port, sizeof(*tr));
+            if (tr && !OpenDevice("timer.device", UNIT_MICROHZ, (struct IORequest *)tr, 0))
+                state = 1;
+        }
+    }
+    if (state < 0) { Reschedule(); return; }
+    tr->tr_node.io_Command = TR_ADDREQUEST;
+    tr->tr_time.tv_secs = 0;
+    tr->tr_time.tv_micro = 10000;
+    DoIO((struct IORequest *)tr);
+}
