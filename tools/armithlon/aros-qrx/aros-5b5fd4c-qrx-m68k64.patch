diff --git a/arch/m68k64-native/qrx/qrxdisk/qrxdisk.conf b/arch/m68k64-native/qrx/qrxdisk/qrxdisk.conf
new file mode 100644
index 00000000..0533704e
--- /dev/null
+++ b/arch/m68k64-native/qrx/qrxdisk/qrxdisk.conf
@@ -0,0 +1,12 @@
+##begin config
+version 1.0
+basename QRXDisk
+libbasetype struct QRXDiskBase
+residentpri 4
+beginio_func beginio
+abortio_func abortio
+options noexpunge
+##end config
+##begin cdefprivate
+#include "qrxdisk_intern.h"
+##end cdefprivate
diff --git a/arch/m68k64-native/qrx/qrxdisk/qrxdisk_device.c b/arch/m68k64-native/qrx/qrxdisk/qrxdisk_device.c
new file mode 100644
index 00000000..f175f470
--- /dev/null
+++ b/arch/m68k64-native/qrx/qrxdisk/qrxdisk_device.c
@@ -0,0 +1,328 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: qrxdisk.device, a disk in RAM for the 68100EC64 reference machine.
+
+    The boot loader puts a disk image (512-byte blocks) at the top of RAM, outside the memory it
+    gives to exec, and names it on the kernel command line as qrxdisk=<address>,<size> in hex.
+    Unit 0 reads and writes it. At init the device adds a boot node DH0: for it, with the
+    Fast File System (afs.handler), which dosboot then mounts and boots from. The FAT handler of
+    this AROS snapshot does not convert all its little-endian fields, so it does not work on a
+    big-endian CPU.
+*/
+
+#include <aros/debug.h>
+#include <aros/symbolsets.h>
+#include <exec/errors.h>
+#include <exec/io.h>
+#include <exec/memory.h>
+#include <devices/newstyle.h>
+#include <devices/trackdisk.h>
+#include <dos/dos.h>
+#include <dos/dosextens.h>
+#include <dos/filehandler.h>
+#include <libraries/expansion.h>
+#include <aros/bootloader.h>
+
+#include <proto/bootloader.h>
+#include <proto/exec.h>
+#include <proto/expansion.h>
+
+#include <string.h>
+
+#include LC_LIBDEFS_FILE
+
+#define BLOCK_SIZE          512
+#define BLOCKS_PER_TRACK    32
+#define QRXDISK_DOSTYPE     0x444f5301  /* DOS\1, the Fast File System: afs.handler */
+
+static const UWORD SupportedCommands[] =
+{
+    CMD_RESET, CMD_READ, CMD_WRITE, CMD_UPDATE, CMD_CLEAR, CMD_STOP, CMD_START, CMD_FLUSH,
+    TD_MOTOR, TD_SEEK, TD_FORMAT, TD_REMOVE, TD_CHANGENUM, TD_CHANGESTATE, TD_PROTSTATUS,
+    TD_GETDRIVETYPE, TD_GETNUMTRACKS, TD_ADDCHANGEINT, TD_REMCHANGEINT, TD_GETGEOMETRY,
+    TD_READ64, TD_WRITE64, TD_FORMAT64, NSCMD_TD_READ64, NSCMD_TD_WRITE64, NSCMD_TD_FORMAT64,
+    NSCMD_DEVICEQUERY,
+    0
+};
+
+static UQUAD parse_hex(const char **s)
+{
+    UQUAD v = 0;
+    const char *p = *s;
+
+    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X'))
+        p += 2;
+    for (;; p++)
+    {
+        char c = *p;
+        if (c >= '0' && c <= '9') v = v * 16 + (c - '0');
+        else if (c >= 'a' && c <= 'f') v = v * 16 + (c - 'a' + 10);
+        else if (c >= 'A' && c <= 'F') v = v * 16 + (c - 'A' + 10);
+        else break;
+    }
+    *s = p;
+    return v;
+}
+
+static void add_bootnode(LIBBASETYPEPTR base)
+{
+    struct Library *ExpansionBase = OpenLibrary("expansion.library", 0);
+    IPTR *pp;
+    struct DosEnvec *de;
+    struct DeviceNode *dn;
+    UQUAD blocks = base->qd_Size / BLOCK_SIZE;
+
+    if (!ExpansionBase)
+        return;
+    pp = AllocMem(sizeof(IPTR) * 4 + sizeof(struct DosEnvec), MEMF_PUBLIC | MEMF_CLEAR);
+    if (pp)
+    {
+        pp[0] = (IPTR)"DH0";
+        pp[1] = (IPTR)"qrxdisk.device";
+        pp[2] = 0;          /* unit */
+        pp[3] = 0;          /* OpenDevice() flags */
+        de = (struct DosEnvec *)&pp[4];
+        de->de_TableSize = DE_BOOTBLOCKS;
+        de->de_SizeBlock = BLOCK_SIZE / 4;
+        de->de_Surfaces = 1;
+        de->de_SectorPerBlock = 1;
+        de->de_BlocksPerTrack = BLOCKS_PER_TRACK;
+        de->de_Reserved = 2;        /* the boot block */
+        de->de_LowCyl = 0;
+        de->de_HighCyl = blocks / BLOCKS_PER_TRACK - 1;
+        de->de_NumBuffers = 32;
+        de->de_BufMemType = MEMF_PUBLIC;
+        de->de_MaxTransfer = 0x01000000;
+        de->de_Mask = (IPTR)~0;
+        de->de_BootPri = 0;
+        de->de_DosType = QRXDISK_DOSTYPE;
+
+        dn = MakeDosNode(pp);
+        if (dn)
+        {
+            AddBootNode(0, ADNF_STARTPROC, dn, NULL);
+            D(bug("[qrxdisk] boot node DH0: for %lu blocks\n", (unsigned long)blocks));
+        }
+    }
+    CloseLibrary(ExpansionBase);
+}
+
+static int GM_UNIQUENAME(Init)(LIBBASETYPEPTR base)
+{
+    APTR BootLoaderBase = OpenResource("bootloader.resource");
+    struct List *args;
+    struct Node *node;
+
+    if (!BootLoaderBase || !(args = GetBootInfo(BL_Args)))
+        return TRUE;
+
+    ForeachNode(args, node)
+    {
+        if (strncmp(node->ln_Name, "qrxdisk=", 8) == 0)
+        {
+            const char *p = node->ln_Name + 8;
+            UQUAD addr = parse_hex(&p), size = 0;
+
+            if (*p == ',')
+            {
+                p++;
+                size = parse_hex(&p);
+            }
+            if (addr && size >= BLOCK_SIZE * BLOCKS_PER_TRACK)
+            {
+                base->qd_Image = (UBYTE *)addr;
+                base->qd_Size = size & ~(UQUAD)(BLOCK_SIZE - 1);
+            }
+        }
+    }
+
+    if (base->qd_Image)
+        add_bootnode(base);
+    return TRUE;
+}
+
+static int GM_UNIQUENAME(Open)(LIBBASETYPEPTR base, struct IORequest *io, ULONG unitnum, ULONG flags)
+{
+    if (unitnum != 0 || !base->qd_Image)
+    {
+        io->io_Error = IOERR_OPENFAIL;
+        return FALSE;
+    }
+    io->io_Unit = &base->qd_Unit;
+    io->io_Error = 0;
+    return TRUE;
+}
+
+static int GM_UNIQUENAME(Close)(LIBBASETYPEPTR base, struct IORequest *io)
+{
+    io->io_Unit = NULL;
+    return TRUE;
+}
+
+ADD2INITLIB(GM_UNIQUENAME(Init), 0)
+ADD2OPENDEV(GM_UNIQUENAME(Open), 0)
+ADD2CLOSEDEV(GM_UNIQUENAME(Close), 0)
+
+/* Reads and writes are copies, so every command is done at once */
+static BYTE transfer(LIBBASETYPEPTR base, struct IOExtTD *iotd, UQUAD offset, BOOL write)
+{
+    ULONG len = iotd->iotd_Req.io_Length;
+
+    iotd->iotd_Req.io_Actual = 0;
+    if ((offset | len) & (BLOCK_SIZE - 1))
+        return IOERR_BADADDRESS;
+    if (offset > base->qd_Size || len > base->qd_Size - offset)
+        return TDERR_SeekError;
+    if (write)
+        CopyMem(iotd->iotd_Req.io_Data, base->qd_Image + offset, len);
+    else
+        CopyMem(base->qd_Image + offset, iotd->iotd_Req.io_Data, len);
+    iotd->iotd_Req.io_Actual = len;
+    return 0;
+}
+
+AROS_LH1(void, beginio,
+    AROS_LHA(struct IOExtTD *, iotd, A1),
+    LIBBASETYPEPTR, base, 5, QRXDisk)
+{
+    AROS_LIBFUNC_INIT
+
+    struct IOStdReq *io = &iotd->iotd_Req;
+    UQUAD offset64 = ((UQUAD)io->io_Actual << 32) | io->io_Offset;
+    BYTE err = 0;
+    BOOL reply = TRUE;
+
+    io->io_Message.mn_Node.ln_Type = NT_MESSAGE;
+
+    switch (io->io_Command)
+    {
+    case CMD_READ:
+    case ETD_READ:
+        err = transfer(base, iotd, io->io_Offset, FALSE);
+        break;
+
+    case CMD_WRITE:
+    case ETD_WRITE:
+    case TD_FORMAT:
+    case ETD_FORMAT:
+        err = transfer(base, iotd, io->io_Offset, TRUE);
+        break;
+
+    case TD_READ64:
+    case NSCMD_TD_READ64:
+        err = transfer(base, iotd, offset64, FALSE);
+        break;
+
+    case TD_WRITE64:
+    case NSCMD_TD_WRITE64:
+    case TD_FORMAT64:
+    case NSCMD_TD_FORMAT64:
+        err = transfer(base, iotd, offset64, TRUE);
+        break;
+
+    case TD_GETGEOMETRY:
+    {
+        struct DriveGeometry *dg = (struct DriveGeometry *)io->io_Data;
+        ULONG blocks = base->qd_Size / BLOCK_SIZE;
+
+        if (io->io_Length < sizeof(struct DriveGeometry))
+        {
+            err = IOERR_BADLENGTH;
+            break;
+        }
+        memset(dg, 0, sizeof(*dg));
+        dg->dg_SectorSize = BLOCK_SIZE;
+        dg->dg_TotalSectors = blocks;
+        dg->dg_Cylinders = blocks / BLOCKS_PER_TRACK;
+        dg->dg_CylSectors = BLOCKS_PER_TRACK;
+        dg->dg_Heads = 1;
+        dg->dg_TrackSectors = BLOCKS_PER_TRACK;
+        dg->dg_BufMemType = MEMF_PUBLIC;
+        dg->dg_DeviceType = DG_DIRECT_ACCESS;
+        dg->dg_Flags = 0;
+        io->io_Actual = sizeof(*dg);
+        break;
+    }
+
+    case NSCMD_DEVICEQUERY:
+    {
+        struct NSDeviceQueryResult *dq = (struct NSDeviceQueryResult *)io->io_Data;
+
+        if (io->io_Length < sizeof(struct NSDeviceQueryResult))
+        {
+            err = IOERR_BADLENGTH;
+            break;
+        }
+        dq->DevQueryFormat = 0;
+        dq->SizeAvailable = sizeof(struct NSDeviceQueryResult);
+        dq->DeviceType = NSDEVTYPE_TRACKDISK;
+        dq->DeviceSubType = 0;
+        dq->SupportedCommands = (UWORD *)SupportedCommands;
+        io->io_Actual = sizeof(struct NSDeviceQueryResult);
+        break;
+    }
+
+    case TD_CHANGENUM:
+        io->io_Actual = 1;
+        break;
+
+    case TD_CHANGESTATE:    /* 0: a disk is in the drive */
+    case TD_PROTSTATUS:     /* 0: not write protected */
+        io->io_Actual = 0;
+        break;
+
+    case TD_GETDRIVETYPE:
+        io->io_Actual = DRIVE3_5;
+        break;
+
+    case TD_GETNUMTRACKS:
+        io->io_Actual = base->qd_Size / BLOCK_SIZE / BLOCKS_PER_TRACK;
+        break;
+
+    case TD_ADDCHANGEINT:
+        /* The disk never changes: keep the request, as trackdisk.device does, and never reply */
+        reply = FALSE;
+        break;
+
+    case TD_REMCHANGEINT:
+    case CMD_RESET:
+    case CMD_UPDATE:
+    case ETD_UPDATE:
+    case CMD_CLEAR:
+    case ETD_CLEAR:
+    case CMD_STOP:
+    case CMD_START:
+    case CMD_FLUSH:
+    case TD_MOTOR:
+    case ETD_MOTOR:
+    case TD_SEEK:
+    case ETD_SEEK:
+    case TD_REMOVE:
+        io->io_Actual = 0;
+        break;
+
+    default:
+        err = IOERR_NOCMD;
+        break;
+    }
+
+    io->io_Error = err;
+    if (!reply)
+        io->io_Flags &= ~IOF_QUICK;
+    else if (!(io->io_Flags & IOF_QUICK))
+        ReplyMsg(&io->io_Message);
+
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH1(LONG, abortio,
+    AROS_LHA(struct IOExtTD *, iotd, A1),
+    LIBBASETYPEPTR, base, 6, QRXDisk)
+{
+    AROS_LIBFUNC_INIT
+
+    return 0;
+
+    AROS_LIBFUNC_EXIT
+}
