new file mode 100644
index 00000000..d1820ae6
--- /dev/null
+++ b/arch/m68k64-native/kernel/kernel_cpu.c
@@ -0,0 +1,179 @@
+/*
+    Copyright (C) 2023, The AROS Development Team. All rights reserved.
+*/
+
+#include <aros/types/timespec_s.h>
+#include <aros/kernel.h>
