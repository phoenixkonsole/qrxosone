     AROS_MAKE_ASM_SYM(int, __##x##__symbol_set_handler_missing, __##x##__symbol_set_handler_missing, 0); \
     AROS_EXPORT_ASM_SYM(__##x##__symbol_set_handler_missing);
+#endif
     
 #endif
 
