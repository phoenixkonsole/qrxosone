+/* siglongjmp() for the 68100EC64: env at 8(sp), val at 16(sp). */
+#include "aros/m68k64/asm.h"
+	.text
+	.globl AROS_CDEFNAME(siglongjmp)
+	.type AROS_CDEFNAME(siglongjmp),@function
+AROS_CDEFNAME(siglongjmp):
+	move.q (8,%sp), %a0
+	move.q (16,%sp), %d0
+	cmpi.l #0, %d0
+	bne 1f
+	moveq #1, %d0
+1:	movem.q (8,%a0), %d2-%d7/%a2-%a6
+	move.q (120,%a0), %sp
+	move.q (%a0), %a1
+	jmp (%a1)
