+static inline void qrx_local_enable(struct ExecBase *SysBase)
+{
+    QRX_LOCAL_KERNELBASE;
+    tls_t *t = TLS_PTR_GET();
+    QRX_LOCAL_BARRIER();
+    t->LocalIDNest--;
+    QRX_LOCAL_BARRIER();
+    t->IDNestCnt--;
+    QRX_LOCAL_BARRIER();
+    /* as Enable() */
+    if (KernelBase && t->IDNestCnt < 0 && !KrnIsSuper())
+    {
+        KrnSti();
+        if (SysBase->SysFlags & SFF_SoftInt)
+            KrnCause();
+        if (t->TDNestCnt < 0 && (t->ScheduleFlags & TLSSF_Switch))
+            KrnSchedule();
+    }
