diff --git a/arch/m68k64-native/kernel/kernel_scheduler.c b/arch/m68k64-native/kernel/kernel_scheduler.c
new file mode 100644
index 00000000..994aa796
--- /dev/null
+++ b/arch/m68k64-native/kernel/kernel_scheduler.c
@@ -0,0 +1,438 @@
+/*
+    The x86 scheduler (arch/all-pc/kernel/kernel_scheduler.c) with the affinity test of the
+    68100EC64 port in place of the APIC one.
+
+    Copyright (C) 2017-2023, The AROS Development Team. All rights reserved.
+*/
+
+#include <exec/alerts.h>
+#include <exec/execbase.h>
+#include <exec/lists.h>
+#include <proto/exec.h>
+
+#define __KERNEL_NOLIBBASE__
+#include <proto/kernel.h>
+
+#include <kernel_base.h>
+#include <kernel_debug.h>
+#include <kernel_scheduler.h>
+
+#include "kernel_cpu.h"
+
+#include <exec_platform.h>
+
+#include <aros/types/spinlock_s.h>
+
+#include <etask.h>
+
+#define __AROS_KERNEL__
+
+#include "exec_intern.h"
+
+
+#define LOWSTACKWARN
+#define SCHEDULERASCII_DEBUG
+
+#ifdef DEBUG
+#undef DEBUG
+#endif
+#define DEBUG 0
+
+#if (DEBUG > 0)
+#define DSCHED(x) x
+#else
+#define DSCHED(x)
+#endif
+
+#if (DEBUG > 0) && defined(SCHEDULERASCII_DEBUG)
+#define DEBUGCOLOR_SET       "\033[31m"
+#define DEBUGFUNCCOLOR_SET   "\033[31;1m"
+#define DEBUGCOLOR_RESET     "\033[0m"
+#else
+#define DEBUGCOLOR_SET
+#define DEBUGFUNCCOLOR_SET
+#define DEBUGCOLOR_RESET
+#endif
+
+#if defined(__AROSEXEC_SMP__)
+/* For x86's core_APIC_CPUInMask(): the affinity is a cpumask_t pointer, none or TASKAFFINITY_ANY is every core */
+static inline BOOL m68k64_CPUInMask(cpuid_t cpuNo, void *mask)
+{
+    if (!mask || (IPTR)mask == TASKAFFINITY_ANY)
+        return TRUE;
+    return (*(cpumask_t *)mask >> cpuNo) & 1;
+}
+#endif
+
+/* Check if the currently running task on this cpu should be rescheduled.. */
+BOOL core_Schedule(void)
+{
+#if defined(__AROSEXEC_SMP__) || (DEBUG > 0)
+    cpuid_t cpuNo;
+#endif
+    struct Task *task;
+    BOOL corereschedule = TRUE;
+
+    DSCHED(bug("[Kernel]" DEBUGFUNCCOLOR_SET " %s()" DEBUGCOLOR_RESET "\n", __func__);)
+
+    task = GET_THIS_TASK;
+#if defined(__AROSEXEC_SMP__) || (DEBUG > 0)
+    cpuNo = KrnGetCPUNumber();
+#endif
+
+    DSCHED(
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: running Task @ 0x%p" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task);
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: '%s', state %08X" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task->tc_Node.ln_Name, task->tc_State);
+    )
+
+    FLAG_SCHEDSWITCH_CLEAR;
+
+    if (task)
+    {
+        if (
+#if defined(__AROSEXEC_SMP__)
+            (task->tc_State == TS_TOMBSTONED) ||
+#endif
+            (task->tc_State == TS_REMOVED))
+        {
+            /* always let finalising tasks finish... */
+            corereschedule = FALSE;
+#if defined(__AROSEXEC_SMP__) || (DEBUG > 0)
+            bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: letting finalising task run.." DEBUGCOLOR_RESET "\n", cpuNo, __func__);
+#endif
+        }
+        else if (!(task->tc_Flags & TF_EXCEPT))
+        {
+#if defined(__AROSEXEC_SMP__)
+            KrnSpinLock(&PrivExecBase(SysBase)->TaskReadySpinLock, NULL,
+                        SPINLOCK_MODE_READ);
+#endif
+            /* Is the TaskReady empty? If yes, then the running task is the only one. Let it work */
+            if (IsListEmpty(&SysBase->TaskReady))
+                corereschedule = FALSE;
+            else
+            {
+                struct Task *nexttask;
+                /*
+                        If there are tasks ready for this cpu that have equal or lower priority,
+                        and the current task has used its alloted time - reschedule so they can run
+                    */
+                for (nexttask = (struct Task *)GetHead(&SysBase->TaskReady); nexttask != NULL; nexttask = (struct Task *)GetSucc(nexttask))
+                {
+#if defined(__AROSEXEC_SMP__)
+                    if (!(PrivExecBase(SysBase)->IntFlags & EXECF_CPUAffinity) || (GetIntETask(nexttask) && m68k64_CPUInMask(cpuNo, GetIntETask(nexttask)->iet_CpuAffinity)))
+                    {
+#endif
+                     if (
+#if defined(__AROSEXEC_SMP__)
+                            (task->tc_State != TS_SPIN) &&
+
+#endif
+                            (nexttask->tc_Node.ln_Pri <= task->tc_Node.ln_Pri))
+                        {
+                            /* If the running task did not used it's whole quantum yet, let it work */
+                            if (!FLAG_SCHEDQUANTUM_ISSET)
+                                corereschedule = FALSE;
+                        }
+                        break;
+#if defined(__AROSEXEC_SMP__)
+                    }
+#endif
+                }
+            }
+#if defined(__AROSEXEC_SMP__)
+            KrnSpinUnLock(&PrivExecBase(SysBase)->TaskReadySpinLock);
+#endif
+        }
+
+#if defined(__AROSEXEC_SMP__)
+        if ((!corereschedule) && (task->tc_State == TS_SPIN))
+            task->tc_State = TS_RUN;
+#endif
+    }
+
+    DSCHED
+        (
+            if (corereschedule)
+                bug("[Kernel:%03u]" DEBUGCOLOR_SET " '%s' @ 0x%p needs rescheduled .." DEBUGCOLOR_RESET "\n", cpuNo, task->tc_Node.ln_Name, task);
+        )
+
+    return corereschedule;
+}
+
+/*
+    Switch the currently running task on this cpu
+    if it is running , switch it to the ready state
+    on SMP builds, if exec has set TS_SPIN,
+    switch it to the spinning list.
+*/
+void core_Switch(void)
+{
+    cpuid_t cpuNo;
+    struct Task *task;
+    ULONG showAlert = 0;
+    BOOL doSwitch = TRUE;
+    struct ETask * taskEtask = NULL;
+
+    DSCHED(bug("[Kernel]" DEBUGFUNCCOLOR_SET " %s()" DEBUGCOLOR_RESET "\n", __func__);)
+
+    cpuNo = KrnGetCPUNumber();
+    task = GET_THIS_TASK;
+
+    DSCHED(
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Current running Task @ 0x%p" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task);
+    )
+    if ((!task) || (task->tc_State == TS_INVALID))
+    {
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: called on invalid task!" DEBUGCOLOR_RESET "\n", cpuNo, __func__);
+        doSwitch = FALSE;
+    }
+    DSCHED(
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Task name '%s'" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task->tc_Node.ln_Name);
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Task state = %08X" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task->tc_State);
+    )
+#if defined(__AROSEXEC_SMP__)
+    if (doSwitch && task->tc_State == TS_TOMBSTONED)
+        doSwitch = FALSE;
+#endif
+    if (!doSwitch)
+    {
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Letting Task continue to run.." DEBUGCOLOR_RESET "\n", cpuNo, __func__);
+        return;
+    }
+
+    DSCHED(
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Switching away from Task" DEBUGCOLOR_RESET "\n", cpuNo, __func__);
+    )
+
+#if defined(__AROSEXEC_SMP__)
+    KrnSpinLock(&PrivExecBase(SysBase)->TaskRunningSpinLock, NULL,
+                SPINLOCK_MODE_WRITE);
+#else
+    if (task->tc_State != TS_RUN && task->tc_State != TS_REMOVED)
+#endif
+    REMOVE(&task->tc_Node);
+#if defined(__AROSEXEC_SMP__)
+    KrnSpinUnLock(&PrivExecBase(SysBase)->TaskRunningSpinLock);
+    if (task->tc_State == TS_REMOVED)
+        task->tc_State = TS_TOMBSTONED;
+#endif
+
+    DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Task removed from list, state = %08X" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task->tc_State);)
+
+    if ((task->tc_State != TS_WAIT) &&
+#if defined(__AROSEXEC_SMP__)
+        (task->tc_State != TS_SPIN) &&
+        (task->tc_State != TS_TOMBSTONED) &&
+#endif
+        (task->tc_State != TS_REMOVED))
+        task->tc_State = TS_READY;
+
+    /* if the current task has gone out of stack bounds, suspend it to prevent further damage to the system */
+    if (task->tc_SPReg <= task->tc_SPLower || task->tc_SPReg > task->tc_SPUpper)
+    {
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " ERROR! Task (%s) went out of stack limits" DEBUGCOLOR_RESET "\n", cpuNo, task->tc_Node.ln_Name);
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET "  - Lower Bound = 0x%p, Upper Bound = 0x%p" DEBUGCOLOR_RESET "\n", cpuNo, task->tc_SPLower, task->tc_SPUpper);
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET "  - SP = 0x%p" DEBUGCOLOR_RESET "\n", cpuNo, task->tc_SPReg);
+
+        task->tc_SigWait    = 0;
+        task->tc_State      = TS_WAIT;
+
+        showAlert = AN_StackProbe;
+#if defined(LOWSTACKWARN)
+    }
+    else if (task->tc_SPReg <= task->tc_SPLower + 1024)
+    {
+        bug("[Kernel:%03u]" DEBUGCOLOR_SET " WARNING - Task (%s) close to stack limits" DEBUGCOLOR_RESET "\n", cpuNo, task->tc_Node.ln_Name);
+#endif
+    }
+    task->tc_IDNestCnt = IDNESTCOUNT_GET;
+
+    if (task->tc_State == TS_READY)
+    {
+        if (task->tc_Flags & TF_SWITCH)
+            AROS_UFC1NR(void, task->tc_Switch, AROS_UFCA(struct ExecBase *, SysBase, A6));
+
+        DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Setting '%s' @ 0x%p as ready" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task->tc_Node.ln_Name, task);)
+#if defined(__AROSEXEC_SMP__)
+        KrnSpinLock(&PrivExecBase(SysBase)->TaskReadySpinLock, NULL,
+                SPINLOCK_MODE_WRITE);
+#endif
+        Enqueue(&SysBase->TaskReady, &task->tc_Node);
+#if defined(__AROSEXEC_SMP__)
+        KrnSpinUnLock(&PrivExecBase(SysBase)->TaskReadySpinLock);
+#endif
+    }
+#if defined(__AROSEXEC_SMP__)
+    else if (task->tc_State == TS_SPIN)
+    {
+        DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Setting '%s' @ 0x%p to spin" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task->tc_Node.ln_Name, task);)
+        KrnSpinLock(&PrivExecBase(SysBase)->TaskSpinningLock, NULL,
+                    SPINLOCK_MODE_WRITE);
+        Enqueue(&PrivExecBase(SysBase)->TaskSpinning, &task->tc_Node);
+        KrnSpinUnLock(&PrivExecBase(SysBase)->TaskSpinningLock);
+    }
+#endif
+    else if(
+#if defined(__AROSEXEC_SMP__)
+        (task->tc_State != TS_TOMBSTONED) &&
+#endif
+        (task->tc_State != TS_REMOVED))
+    {
+        DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Setting '%s' @ 0x%p to wait" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task->tc_Node.ln_Name, task);)
+#if defined(__AROSEXEC_SMP__)
+        KrnSpinLock(&PrivExecBase(SysBase)->TaskWaitSpinLock, NULL,
+                    SPINLOCK_MODE_WRITE);
+#endif
+        Enqueue(&SysBase->TaskWait, &task->tc_Node);
+#if defined(__AROSEXEC_SMP__)
+        KrnSpinUnLock(&PrivExecBase(SysBase)->TaskWaitSpinLock);
+#endif
+    }
+    if (showAlert)
+        Alert(showAlert);
+}
+
+/* Dispatch a "new" ready task on this cpu */
+struct Task *core_Dispatch(void)
+{
+    struct Task *newtask;
+    struct Task *task = GET_THIS_TASK;
+#if defined(__AROSEXEC_SMP__) || (DEBUG > 0)
+    cpuid_t cpuNo = KrnGetCPUNumber();
+#endif
+
+    DSCHED(bug("[Kernel:%03u]" DEBUGFUNCCOLOR_SET " %s()" DEBUGCOLOR_RESET "\n", cpuNo, __func__);)
+
+#if defined(__AROSEXEC_SMP__)
+    KrnSpinLock(&PrivExecBase(SysBase)->TaskReadySpinLock, NULL,
+                SPINLOCK_MODE_WRITE);
+#endif
+    for (newtask = (struct Task *)GetHead(&SysBase->TaskReady); newtask != NULL; newtask = (struct Task *)GetSucc(newtask))
+    {
+#if defined(__AROSEXEC_SMP__)
+        if (!(PrivExecBase(SysBase)->IntFlags & EXECF_CPUAffinity) || (GetIntETask(newtask) && m68k64_CPUInMask(cpuNo, GetIntETask(newtask)->iet_CpuAffinity)))
+        {
+#endif
+            REMOVE(&newtask->tc_Node);
+            break;
+#if defined(__AROSEXEC_SMP__)
+        }
+#endif
+    }
+#if defined(__AROSEXEC_SMP__)
+    KrnSpinUnLock(&PrivExecBase(SysBase)->TaskReadySpinLock);
+#endif
+
+    if ((!newtask) && (task) && (task->tc_State != TS_WAIT))
+    {
+#if defined(__AROSEXEC_SMP__)
+        if (task->tc_State == TS_SPIN)
+        {
+            DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Waking spinning task '%s' @ 0x%p" DEBUGCOLOR_RESET "\n",
+                cpuNo, __func__newtask->tc_Node.ln_Name, newtask);)
+#if 0
+bug("----> such unspinning should not take place!" DEBUGCOLOR_RESET "\n");
+            KrnSpinLock(&PrivExecBase(SysBase)->TaskSpinningLock, NULL,
+                    SPINLOCK_MODE_WRITE);
+            REMOVE(&task->tc_Node);
+            KrnSpinUnLock(&PrivExecBase(SysBase)->TaskSpinningLock);
+#endif
+            task->tc_State = TS_READY;
+        }
+#endif
+        newtask = task;
+    }
+
+    if (newtask != NULL)
+    {
+        BOOL launchtask = FALSE, sleeptask = FALSE;
+
+        if (newtask->tc_State == TS_READY)
+        {
+            DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Preparing to run '%s' @ 0x%p" DEBUGCOLOR_RESET "\n",
+                cpuNo, __func__, newtask->tc_Node.ln_Name, newtask);)
+
+            IDNESTCOUNT_SET(newtask->tc_IDNestCnt);
+            SET_THIS_TASK(newtask);
+            SCHEDELAPSED_SET(SCHEDQUANTUM_GET);
+            FLAG_SCHEDQUANTUM_CLEAR;
+        }
+        if  ((newtask->tc_State == TS_READY) || (newtask->tc_State == TS_RUN))
+        {
+            /* Check the stack of the task we are about to launch. */
+            if ((newtask->tc_SPReg <= newtask->tc_SPLower) ||
+                (newtask->tc_SPReg > newtask->tc_SPUpper))
+            {
+                newtask->tc_State     = TS_WAIT;
+                sleeptask = TRUE;
+            }
+            else
+            {
+                newtask->tc_State     = TS_RUN;
+                launchtask = TRUE;
+            }
+        }
+        else if (
+#if defined(__AROSEXEC_SMP__)
+            (task->tc_State == TS_TOMBSTONED ) ||
+#endif
+            (task->tc_State == TS_REMOVED))
+        {
+#if defined(__AROSEXEC_SMP__) || (DEBUG > 0)
+            // The task is on its way out ...
+            bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: --> Dispatching finalizing/tombstoned task?" DEBUGCOLOR_RESET "\n", cpuNo, __func__);
+            bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: --> Task @ 0x%p '%s', state %08X" DEBUGCOLOR_RESET "\n", cpuNo, __func__, task, task->tc_Node.ln_Name, newtask->tc_State);
+#endif
+        }
+
+        if (sleeptask)
+        {
+            DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Moving '%s' @ 0x%p to wait queue" DEBUGCOLOR_RESET "\n", cpuNo, __func__, newtask->tc_Node.ln_Name, newtask);)
+#if defined(__AROSEXEC_SMP__)
+            KrnSpinLock(&PrivExecBase(SysBase)->TaskWaitSpinLock, NULL,
+                        SPINLOCK_MODE_WRITE);
+#endif
+            Enqueue(&SysBase->TaskWait, &newtask->tc_Node);
+#if defined(__AROSEXEC_SMP__)
+            KrnSpinUnLock(&PrivExecBase(SysBase)->TaskWaitSpinLock);
+#endif
+        }
+
+        if (!launchtask)
+        {
+            /* if the new task shouldn't run - force a reschedule */
+            DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Skipping '%s' @ 0x%p (state %08X)" DEBUGCOLOR_RESET "\n", cpuNo, __func__, newtask->tc_Node.ln_Name, newtask, newtask->tc_State);)
+
+            core_Switch();
+            newtask = core_Dispatch();
+        }
+        else
+        {
+#if defined(AROS_NO_ATOMIC_OPERATIONS)
+            SysBase->DispCount++;
+#else
+            AROS_ATOMIC_INC(SysBase->DispCount);
+#endif
+            DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: Launching '%s' @ 0x%p (state %08X)" DEBUGCOLOR_RESET "\n", cpuNo, __func__, newtask->tc_Node.ln_Name, newtask, newtask->tc_State);)
+        }
+    }
+    else
+    {
+        /* Go idle if there is nothing to do ... */
+        DSCHED(bug("[Kernel:%03u]" DEBUGCOLOR_SET " %s: No ready Task(s) - entering sleep mode" DEBUGCOLOR_RESET "\n", cpuNo, __func__);)
+
+        /*
+         * Idle counter is incremented every time when we enter here,
+         * not only once. This is correct.
+         */
+#if defined(AROS_NO_ATOMIC_OPERATIONS)
+        SysBase->IdleCount++;
+#else
+        AROS_ATOMIC_INC(SysBase->IdleCount);
+#endif
+        FLAG_SCHEDSWITCH_SET;
+    }
+
+    return newtask;
+}
diff --git a/arch/m68k64-native/kernel/kernel_smp.c b/arch/m68k64-native/kernel/kernel_smp.c
new file mode 100644
index 00000000..ebadbe57
--- /dev/null
+++ b/arch/m68k64-native/kernel/kernel_smp.c
@@ -0,0 +1,250 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Several cores on the 68100EC64, see kernel_smp.h. The control registers used here:
+        $80A    stack for the next core this one starts
+        $80B    number of cores
+        $80D    signal (level 6) to a mask of cores; a waiting core starts on its first one
+        $80E    this core's number
+*/
+
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+#include <exec/memory.h>
+#include <exec/tasks.h>
+#include <hardware/intbits.h>
+
+#include <proto/exec.h>
+#include <utility/hooks.h>
+
+#include "kernel_base.h"
+#include "kernel_cpu.h"
+#include "kernel_intern.h"
+#include "kernel_debug.h"
+#include "kernel_scheduler.h"
+#include "kernel_smp.h"
+#include <exec_platform.h>
+
+#define D(x)
+
+#define CORE_STACK_SIZE         65536
+
+unsigned int m68k64_CoreCount;
+volatile cpumask_t m68k64_CoresUp;
+volatile unsigned long m68k64_IPIPending[M68K64_MAX_CORES];
+static tls_t *cpu_TLS[M68K64_MAX_CORES];
+static void ipi_RunHooks(unsigned int me);
+
+extern void cpu_StartTimer(void);
+extern void cpu_Dispatch(regs_t *regs);
+
+static void movec_startsp(void *sp)
+{
+    asm volatile ("   move.q %0, %%d0\n   .short 0x4E7B, 0x080A" : : "d"(sp) : "d0");
+}
+
+static void movec_signal(cpumask_t mask)
+{
+    asm volatile ("   move.q %0, %%d0\n   .short 0x4E7B, 0x080D" : : "d"(mask) : "d0", "memory");
+}
+
+static unsigned long movec_coreid(void)
+{
+    unsigned long id;
+    asm volatile ("   .short 0x4E7A, 0x080E\n   move.q %%d0, %0" : "=d"(id) : : "d0");
+    return id;
+}
+
+/* Core 0, supervisor state (TRAP #3 from exec's platform init): starts the other cores one by one */
+void cpu_StartSecondaries(void)
+{
+    tls_t *boot = TLS_PTR_GET();
+    struct KernelBase *KernelBase = (struct KernelBase *)boot->KernelBase;
+    unsigned int n;
+
+    m68k64_CoresUp = (cpumask_t)1 << boot->CPUNumber;
+
+    for (n = 1; n < m68k64_CoreCount && n < M68K64_MAX_CORES; n++)
+    {
+        tls_t *t = AllocMem(sizeof(tls_t), MEMF_PUBLIC | MEMF_CLEAR);
+        UBYTE *stack = AllocMem(CORE_STACK_SIZE, MEMF_PUBLIC | MEMF_CLEAR);
+        unsigned long wait;
+
+        if (!t || !stack)
+        {
+            bug("[Kernel:%02u] no memory to start core %u\n", boot->CPUNumber, n);
+            break;
+        }
+        t->SysBase = boot->SysBase;
+        t->KernelBase = boot->KernelBase;
+        t->ThisTask = NULL;
+        t->CPUNumber = n;
+        t->IDNestCnt = -1;
+        t->TDNestCnt = -1;
+        t->Quantum = SCHEDQUANTUM_VALUE;
+        t->Elapsed = SCHEDQUANTUM_VALUE;
+        cpu_TLS[n] = t;
+        __atomic_thread_fence(__ATOMIC_SEQ_CST);
+
+        movec_startsp(stack + CORE_STACK_SIZE - 16);
+        movec_signal((cpumask_t)1 << n);
+
+        for (wait = 0; wait < 100000000UL; wait++)
+            if (__atomic_load_n(&m68k64_CoresUp, __ATOMIC_ACQUIRE) & ((cpumask_t)1 << n))
+                break;
+        if (!(m68k64_CoresUp & ((cpumask_t)1 << n)))
+            bug("[Kernel:%02u] core %u did not come up\n", boot->CPUNumber, n);
+    }
+}
+
+/*
+    A new core, from intr.c: it took its first level 6 signal with A8 still 0. There is nothing to
+    return to, so it picks a task from exec's ready list, as a task switch would.
+*/
+void cpu_SecondaryStart(regs_t *regs)
+{
+    unsigned long id = movec_coreid();
+    tls_t *t = id < M68K64_MAX_CORES ? cpu_TLS[id] : NULL;
+    struct KernelBase *KernelBase;
+
+    if (!t)
+        for (;;)
+            asm volatile (".short 0x4E72, 0x2700");     /* stop: no TLS was made for this core */
+
+    TLS_PTR_SET(t);
+    t->SuperDepth = 1;      /* in the exception that started this core; its exit counts it down */
+    KernelBase = (struct KernelBase *)t->KernelBase;
+    __atomic_fetch_and(&m68k64_IPIPending[id], 0, __ATOMIC_SEQ_CST);
+
+    cpu_StartTimer();
+    __atomic_fetch_or(&m68k64_CoresUp, (cpumask_t)1 << id, __ATOMIC_SEQ_CST);
+    bug("[Kernel:%02u] core up\n", (unsigned)id);
+
+    cpu_Dispatch(regs);
+}
+
+/* Level 6: messages from other cores */
+void cpu_HandleIPI(regs_t *regs)
+{
+    unsigned int me = GetCPUNumber();
+    unsigned long bits = __atomic_exchange_n(&m68k64_IPIPending[me], 0, __ATOMIC_SEQ_CST);
+
+    if (bits & (1UL << IPI_CALL_HOOK))
+        ipi_RunHooks(me);
+    if (bits & (1UL << IPI_RESCHEDULE))
+    {
+        FLAG_SCHEDQUANTUM_SET;
+        FLAG_SCHEDSWITCH_SET;
+    }
+}
+
+/* Any state: the signal itself needs MOVEC, which is privileged, so it goes through TRAP #3 */
+void core_DoIPI(unsigned char ipi_number, void *cpu_mask, struct KernelBase *KernelBase)
+{
+    cpumask_t targets, up = __atomic_load_n(&m68k64_CoresUp, __ATOMIC_ACQUIRE);
+    unsigned int me = GetCPUNumber(), n;
+
+    if (!cpu_mask || (IPTR)cpu_mask == TASKAFFINITY_ANY)
+        targets = up & ~((cpumask_t)1 << me);
+    else
+        targets = *(cpumask_t *)cpu_mask & up;
+    if (!targets)
+        return;
+
+    for (n = 0; n < M68K64_MAX_CORES; n++)
+        if (targets & ((cpumask_t)1 << n))
+            __atomic_fetch_or(&m68k64_IPIPending[n], 1UL << ipi_number, __ATOMIC_SEQ_CST);
+
+    {
+        register unsigned long fn asm("d0") = M68K64_TRAP3_SIGNAL;
+        register unsigned long mask asm("d1") = targets;
+        asm volatile ("trap #3" : "+d"(fn) : "d"(mask) : "memory", "cc");
+    }
+}
+
+/* TRAP #3 in supervisor state */
+void cpu_Trap3(regs_t *regs)
+{
+    switch (regs->d[0])
+    {
+    case M68K64_TRAP3_STARTCORES:
+        cpu_StartSecondaries();
+        break;
+    case M68K64_TRAP3_SIGNAL:
+        movec_signal(regs->d[1]);
+        break;
+    }
+}
+
+/*
+    Running a hook on other cores (exec's Signal() uses it for tasks bound to another core).
+    A pool of IPIHooks; each core has a bitmask of the pool slots waiting for it.
+*/
+#define IPI_SLOTS 32
+static struct IPIHook ipi_Slot[IPI_SLOTS];
+static volatile ULONG ipi_SlotBusy[IPI_SLOTS];
+static volatile cpumask_t ipi_SlotWant[IPI_SLOTS], ipi_SlotDone[IPI_SLOTS];
+static volatile unsigned long ipi_HooksFor[M68K64_MAX_CORES];
+
+static void ipi_RunHooks(unsigned int me)
+{
+    unsigned long slots = __atomic_exchange_n(&ipi_HooksFor[me], 0, __ATOMIC_SEQ_CST);
+    unsigned int i;
+
+    for (i = 0; i < IPI_SLOTS; i++)
+    {
+        if (!(slots & (1UL << i)))
+            continue;
+        CALLHOOKPKT(&ipi_Slot[i].ih_Hook, NULL, 0);
+        if ((__atomic_or_fetch(&ipi_SlotDone[i], (cpumask_t)1 << me, __ATOMIC_SEQ_CST) == ipi_SlotWant[i])
+            && ipi_Slot[i].ih_Async)
+            __atomic_store_n(&ipi_SlotBusy[i], 0, __ATOMIC_RELEASE);
+    }
+}
+
+int core_DoCallIPI(struct Hook *hook, void *cpu_mask, int async, int nargs, IPTR *args, void *_KB)
+{
+    struct KernelBase *KernelBase = _KB;
+    cpumask_t targets, up = __atomic_load_n(&m68k64_CoresUp, __ATOMIC_ACQUIRE);
+    unsigned int me = GetCPUNumber(), i, n;
+    struct IPIHook *ipi;
+
+    if (!hook || nargs > IPI_CALL_HOOK_MAX_ARGS)
+        return FALSE;
+    if (!cpu_mask || (IPTR)cpu_mask == TASKAFFINITY_ANY)
+        targets = up & ~((cpumask_t)1 << me);
+    else
+        targets = *(cpumask_t *)cpu_mask & up;
+    if (!targets)
+        return FALSE;
+
+    /* A free slot; the others free theirs as their cores run them */
+    for (i = 0;; i = (i + 1) % IPI_SLOTS)
+    {
+        ULONG free = 0;
+        if (__atomic_compare_exchange_n(&ipi_SlotBusy[i], &free, 1, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+            break;
+    }
+    ipi = &ipi_Slot[i];
+    ipi->ih_Hook.h_Entry = hook->h_Entry;
+    ipi->ih_Hook.h_SubEntry = hook->h_SubEntry;
+    ipi->ih_Hook.h_Data = hook->h_Data;
+    for (n = 0; n < (unsigned)nargs; n++)
+        ipi->ih_Args[n] = args[n];
+    ipi->ih_Async = async;
+    ipi_SlotWant[i] = targets;
+    __atomic_store_n(&ipi_SlotDone[i], 0, __ATOMIC_SEQ_CST);
+
+    for (n = 0; n < M68K64_MAX_CORES; n++)
+        if (targets & ((cpumask_t)1 << n))
+            __atomic_fetch_or(&ipi_HooksFor[n], 1UL << i, __ATOMIC_SEQ_CST);
+    core_DoIPI(IPI_CALL_HOOK, &targets, KernelBase);
+
+    if (!async)
+    {
+        while (__atomic_load_n(&ipi_SlotDone[i], __ATOMIC_ACQUIRE) != targets)
+            ;
+        __atomic_store_n(&ipi_SlotBusy[i], 0, __ATOMIC_RELEASE);
+    }
+    return TRUE;
+}
diff --git a/arch/m68k64-native/kernel/kernel_smp.h b/arch/m68k64-native/kernel/kernel_smp.h
new file mode 100644
index 00000000..f9afad4d
--- /dev/null
+++ b/arch/m68k64-native/kernel/kernel_smp.h
@@ -0,0 +1,53 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Several cores of the 68100EC64 machine. Core 0 boots AROS, then starts the others: each takes
+    its first signal (level 6) with the stack core 0 named in MOVEC $80A, and the shared vector
+    table sends it to cpu_SecondaryStart(), see intr.c. All cores share exec's task lists.
+*/
+
+#ifndef KERNEL_SMP_H_
+#define KERNEL_SMP_H_
+
+#include <aros/cpu.h>
+
+struct ExceptionContext;
+struct KernelBase;
+
+#define M68K64_MAX_CORES        64
+
+/* Messages a core finds in its pending bits when the level 6 signal comes */
+#define IPI_NOP                 0
+#define IPI_RESCHEDULE          1
+#define IPI_CALL_HOOK           2
+
+/* Kernel calls through TRAP #3, D0 is the function */
+#define M68K64_TRAP3_STARTCORES 1   /* start every other core */
+#define M68K64_TRAP3_SIGNAL     2   /* D1: mask of cores to get a level 6 signal */
+
+extern unsigned int m68k64_CoreCount;
+extern volatile cpumask_t m68k64_CoresUp;
+extern volatile unsigned long m68k64_IPIPending[M68K64_MAX_CORES];
+
+/* A hook run on other cores, as on x86 (exec's signal.c uses its arguments) */
+#include <utility/hooks.h>
+#include <aros/types/spinlock_s.h>
+#define IPI_CALL_HOOK_MAX_ARGS  5
+struct IPIHook
+{
+    struct Hook     ih_Hook;
+    IPTR            ih_Args[IPI_CALL_HOOK_MAX_ARGS];
+    uint32_t *      ih_CPUDone;
+    uint32_t *      ih_CPURequested;
+    int             ih_Async;
+    spinlock_t      ih_Lock;
+    spinlock_t      ih_SyncLock;
+};
+
+void cpu_StartSecondaries(void);
+void cpu_SecondaryStart(struct ExceptionContext *regs);
+void cpu_HandleIPI(struct ExceptionContext *regs);
+void core_DoIPI(unsigned char ipi_number, void *cpu_mask, struct KernelBase *KernelBase);
+int core_DoCallIPI(struct Hook *hook, void *cpu_mask, int async, int nargs, IPTR *args, void *_KB);
+
+#endif
diff --git a/arch/m68k64-native/kernel/maygetchar.c b/arch/m68k64-native/kernel/maygetchar.c
new file mode 100644
index 00000000..f64c7244
--- /dev/null
+++ b/arch/m68k64-native/kernel/maygetchar.c
@@ -0,0 +1,24 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: KrnMayGetChar() for the 68100EC64: the test machine's console input is a read of
+          MOVEC $8F0, which is privileged, so it goes through TRAP #4 (intr.c).
+*/
+
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+
+#include <kernel_base.h>
+
+AROS_LH0(int, KrnMayGetChar,
+         struct KernelBase *, KernelBase, 26, Kernel)
+{
+    AROS_LIBFUNC_INIT
+
+    register long c asm("d0");
+
+    asm volatile ("trap #4" : "=d"(c) : : "memory", "cc");
+    return (int)c;
+
+    AROS_LIBFUNC_EXIT
+}
