diff --git a/arch/m68k64-native/kernel/spinlock.c b/arch/m68k64-native/kernel/spinlock.c
new file mode 100644
index 00000000..56f9b178
--- /dev/null
+++ b/arch/m68k64-native/kernel/spinlock.c
@@ -0,0 +1,35 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    KrnSpinLock: spins until it gets the lock. The fail hook (exec's task spinning) is not used yet: a task that has to wait keeps its core on the 68100EC64. See rom/kernel/spinlock.c for documentation.
+*/
+
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+#include <exec/tasks.h>
+#include <aros/types/spinlock_s.h>
+
+#include <kernel_base.h>
+
+#include <proto/kernel.h>
+
+extern spinlock_t *m68k64_SpinTry(spinlock_t *lock, ULONG mode);
+
+AROS_LH3(spinlock_t *, KrnSpinLock,
+    AROS_LHA(spinlock_t *, lock, A1),
+    AROS_LHA(struct Hook *, failhook, A0),
+    AROS_LHA(ULONG, mode, D0),
+    struct KernelBase *, KernelBase, 52, Kernel)
+{
+    AROS_LIBFUNC_INIT
+
+    while (!m68k64_SpinTry(lock, mode))
+    {
+        while (__atomic_load_n(&lock->lock, __ATOMIC_RELAXED) &
+               (mode == SPINLOCK_MODE_WRITE ? ~0U : SPINLOCKF_WRITE))
+            ;
+    }
+    return lock;
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/arch/m68k64-native/kernel/spintrylock.c b/arch/m68k64-native/kernel/spintrylock.c
new file mode 100644
index 00000000..6ffd3368
--- /dev/null
+++ b/arch/m68k64-native/kernel/spintrylock.c
@@ -0,0 +1,47 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    KrnSpinTryLock: one attempt. A write lock is SPINLOCKF_WRITE in the lock word, a read lock counts readers below it; CAS is atomic between the cores on the 68100EC64. See rom/kernel/spintrylock.c for documentation.
+*/
+
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+#include <exec/tasks.h>
+#include <aros/types/spinlock_s.h>
+
+#include <kernel_base.h>
+
+#include <proto/kernel.h>
+
+spinlock_t *m68k64_SpinTry(spinlock_t *lock, ULONG mode)
+{
+    unsigned int old = __atomic_load_n(&lock->lock, __ATOMIC_RELAXED);
+
+    if (mode == SPINLOCK_MODE_WRITE)
+    {
+        old = SPINLOCK_UNLOCKED;
+        if (__atomic_compare_exchange_n(&lock->lock, &old, SPINLOCKF_WRITE, 0,
+                                        __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+            return lock;
+        return NULL;
+    }
+
+    if (old & SPINLOCKF_WRITE)
+        return NULL;
+    if (__atomic_compare_exchange_n(&lock->lock, &old, old + 1, 0,
+                                    __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+        return lock;
+    return NULL;
+}
+
+AROS_LH2(spinlock_t *, KrnSpinTryLock,
+    AROS_LHA(spinlock_t *, lock, A0),
+    AROS_LHA(ULONG, mode, D0),
+    struct KernelBase *, KernelBase, 51, Kernel)
+{
+    AROS_LIBFUNC_INIT
+
+    return m68k64_SpinTry(lock, mode);
+
+    AROS_LIBFUNC_EXIT
+}
