diff --git a/rom/exec/exec_local.h b/rom/exec/exec_local.h
new file mode 100644
index 00000000..3f297825
--- /dev/null
+++ b/rom/exec/exec_local.h
@@ -0,0 +1,92 @@
+/*
+    QRX OS One 64: Forbid()/Permit() and Disable()/Enable() for exec code that guards its data with a
+    spinlock as well (semaphores, message ports, memory lists). They count like the real ones on this
+    core, and also in the TLS's LocalTDNest/LocalIDNest, which the 68100EC64's global Forbid leaves
+    out: such a section needs no other core to stand still, the spinlock already keeps it out.
+    The counter and its local part change in one run of straight code (one JIT block of the machine),
+    the real level first when taking and last when giving back, so no task switch and no check of the
+    global Forbid falls between them in the wrong order. Code that Wait()s inside such a section gives
+    its local part back first (qrx_local_forbid_suspend) and takes it again after.
+    Elsewhere they are the plain calls.
+*/
+#ifndef EXEC_LOCAL_H
+#define EXEC_LOCAL_H
+#include <exec/execbase.h>
+#if defined(__m68k64__) && defined(__AROSEXEC_SMP__)
+#include "exec_intern.h"
+#include <proto/kernel.h>
+#define QRX_LOCAL_BARRIER() __asm__ volatile("" ::: "memory")
+/* kernel.resource's calls want a KernelBase in scope; exec defines it differently in places */
+#pragma push_macro("KernelBase")
+#undef KernelBase
+#define QRX_LOCAL_KERNELBASE APTR KernelBase = PrivExecBase(SysBase)->KernelBase
+static inline void qrx_local_forbid(void)
+{
+    tls_t *t = TLS_PTR_GET();
+    t->TDNestCnt++;
+    QRX_LOCAL_BARRIER();
+    t->LocalTDNest++;
+    QRX_LOCAL_BARRIER();
+}
+static inline void qrx_local_permit(struct ExecBase *SysBase)
+{
+    QRX_LOCAL_KERNELBASE;
+    tls_t *t = TLS_PTR_GET();
+    QRX_LOCAL_BARRIER();
+    t->LocalTDNest--;
+    QRX_LOCAL_BARRIER();
+    t->TDNestCnt--;
+    QRX_LOCAL_BARRIER();
+    /* as Permit() */
+    if (KernelBase && t->TDNestCnt < 0 && t->IDNestCnt < 0 && (t->ScheduleFlags & TLSSF_Switch) && !KrnIsSuper())
+        KrnSchedule();
+}
+static inline void qrx_local_disable(struct ExecBase *SysBase)
+{
+    QRX_LOCAL_KERNELBASE;
+    if (KernelBase)
+        KrnCli();
+    tls_t *t = TLS_PTR_GET();
+    t->IDNestCnt++;
+    QRX_LOCAL_BARRIER();
+    t->LocalIDNest++;
