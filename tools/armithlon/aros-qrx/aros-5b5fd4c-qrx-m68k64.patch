new file mode 100644
index 00000000..f9075513
--- /dev/null
+++ b/arch/m68k64-native/qrx/battclock/readbattclock.c
@@ -0,0 +1,28 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: ReadBattClock() for the 68100EC64: the ARMithlon board's host clock (seconds since 1970,
+          UTC) in its device window, see docs/armithlon/68100ec64.md. There is no MMU, so the
+          resource reads the register directly.
+*/
+
+#include <aros/libcall.h>
+#include <exec/types.h>
+#include <proto/battclock.h>
+
+#include "battclock_intern.h"
+
+#define QEC64_CLOCK_UNIX    (0xFFFFFFFF00000000UL + 0x0308)
+#define AMIGA_EPOCH         252460800UL     /* 1978-01-01 in Unix time */
+
+AROS_LH0(ULONG, ReadBattClock,
+         struct BattClockBase *, BattClockBase, 2, Battclock)
+{
+    AROS_LIBFUNC_INIT
+
+    UQUAD t = *(volatile UQUAD *)QEC64_CLOCK_UNIX;
+
+    return t > AMIGA_EPOCH ? (ULONG)(t - AMIGA_EPOCH) : 0;
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/arch/m68k64-native/qrx/boot/boot.c b/arch/m68k64-native/qrx/boot/boot.c
new file mode 100644
index 00000000..a59a71a6
--- /dev/null
+++ b/arch/m68k64-native/qrx/boot/boot.c
@@ -0,0 +1,44 @@
+/*
+    Copyright (C) 2023, The AROS Development Team. All rights reserved.
+
+    Desc: boot.c
+ */
+
+#include <exec/types.h>
+#include <aros/macros.h>
+#include <inttypes.h>
+#include <asm/cpu.h>
+#include <utility/tagitem.h>
+#include <aros/macros.h>
+#include <aros/kernel.h>
+#include <string.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+asm("   .section .aros.startup      \n"
+"       .globl bootstrap            \n"
+"       .type bootstrap,%function   \n"
+"bootstrap:                         \n"
+"       jal       boot              \n"
+"       .section .text              \n"
+".byte 0                            \n"
+".string \"$VER: aros-sifive-riscv.img v40.0 (" __DATE__ ")\"\n"
+".byte 0                            \n"
+"\n\t\n\t"
+);
+
+// The bootstrap tmp stack is re-used by the reset handler so we store it at this fixed location
+static __used void * tmp_stack_ptr __attribute__((used, section(".aros.startup" TARGET_SECTION_COMMENT))) = (void *)(0x1000 - 16);
+static struct TagItem *boottag;
+static unsigned long *mem_upper;
+struct tag;
+
+static const char bootstrapName[] = "Bootstrap/RISC-V 32bit";
+
+void boot(uintptr_t dummy, uintptr_t arch, struct tag * atags, uintptr_t a)
+{
+    uint32_t tmp, initcr;
+    void (*entry)(struct TagItem *);
+
+    while(1) asm volatile("wfi");
+}
diff --git a/arch/m68k64-native/qrx/boot/ldscript.lds b/arch/m68k64-native/qrx/boot/ldscript.lds
new file mode 100644
index 00000000..fc781cda
--- /dev/null
+++ b/arch/m68k64-native/qrx/boot/ldscript.lds
@@ -0,0 +1,80 @@
+SECTIONS
+{
+    . = 0x80000000;
+
+    __bootstrap_start = . ;
+
+    .text ALIGN(16) :
+    {
+        *(.aros.startup)
+        *(.text)
+        *(.text.*)
+        *(.stub)
+        *(.gnu.warning)
+        *(.gnu.linkonce.t.*)
+    }
+
+    .rodata ALIGN(0x1000) :
+    {
+        *(.rodata)
+        *(.rodata.*)
+        *(.gnu.linkonce.r.*)
+    }
+    .rodata1 : { *(.rodata1) }
+
+    .sdata2 : { *(.sdata2) *(.sdata2.*) *(.gnu.linkonce.s2.*) }
+    .sbss2  : { *(.sbss2) *(.sbss2.*) *(.gnu.linkonce.sb2.*) }
+
+    .data ALIGN(0x1000) :
+    {
+        *core.bin.o(.data)
+        *(.data)
+        *(.data.*)
+        *(.gnu.linkonce.d.*)
+    }
+
+    .data1              : { *(.data1) }
+    .eh_frame           : { KEEP (*(.eh_frame)) }
+    .gcc_except_table   : { *(.gcc_except_table) }
+
+    .sdata ALIGN(0x1000) :
+    {
+        *(.sdata)
+        *(.sdata.*)
+        *(.gnu.linkonce.s.*)
+    }
+
+    __bss_start = . ;
+
+    .sbss ALIGN(0x1000) :
+    {
+        *(.sbss)
+        *(.sbss.*)
+        *(.gnu.linkonce.sb.*)
+        *(.scommon)
+    }
+
+    .bss ALIGN(0x1000) :
+    {
+        *(.bss)
+        *(.bss.*)
+        *(.gnu.linkonce.b.*)
+        *(COMMON)
+    }
+
+    _end = . ;
+
+    __bootstrap_end = . ;
+
+    .trailer ALIGN(4) :
+    {
+    LONG(0)
+    LONG(0)
+    LONG(0x00000001)    /* DTOK = 1, please give us device tree */
+    LONG(0x00000004)
+    LONG(0x4b4f5444)    /* DTOK */
+    LONG(0x00000020)
+    LONG(0x00000004)
+    LONG(0x4c545052)
+    }
+}
