+#ifndef _POSIXC_DLFCN_H_
+#define _POSIXC_DLFCN_H_
+
+/*
+    Copyright (C) 2026, QRX OS One.
+
+    POSIX.1-2008 header file dlfcn.h. QRX OS One 64: AROS loads libraries as Exec libraries, not
+    as ELF shared objects, so there is no dynamic linker behind these functions. They are in
+    libqrxaroscompat: dlopen and dlsym return NULL with a dlerror() text, dladdr finds nothing.
+*/
+
+#include <aros/system.h>
+
+#define RTLD_LAZY     1
+#define RTLD_NOW      2
+#define RTLD_GLOBAL   0x100
+#define RTLD_LOCAL    0
+#define RTLD_NOLOAD   4
+#define RTLD_DEFAULT  ((void *)0)
+
+typedef struct {
+    const char *dli_fname;
+    void       *dli_fbase;
+    const char *dli_sname;
+    void       *dli_saddr;
+} Dl_info;
+
+__BEGIN_DECLS
+
+void *dlopen(const char *file, int mode);
+void *dlsym(void *handle, const char *name);
+int   dlclose(void *handle);
+char *dlerror(void);
+int   dladdr(const void *addr, Dl_info *info);
+
+__END_DECLS
+
+#endif /* _POSIXC_DLFCN_H_ */
