+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    KrnScheduleCPU on the 68100EC64: a CPU mask is one cpumask_t (64 cores), TASKAFFINITY_ANY means all.
+    See rom/kernel/schedulecpu.c for documentation.
+*/
+
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+#include <exec/memory.h>
+#include <exec/tasks.h>
+
+#include <kernel_base.h>
+#include "kernel_smp.h"
+
+#include <proto/exec.h>
+#include <proto/kernel.h>
+
+AROS_LH1(void, KrnScheduleCPU,
+    AROS_LHA(void *, mask, A0),
+    struct KernelBase *, KernelBase, 47, Kernel)
+{
+    AROS_LIBFUNC_INIT
+
+    core_DoIPI(IPI_RESCHEDULE, mask, KernelBase);
+
+    AROS_LIBFUNC_EXIT
+}
