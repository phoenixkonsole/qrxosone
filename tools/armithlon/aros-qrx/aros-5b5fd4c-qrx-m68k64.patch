diff --git a/rom/intuition/qrxresizescreen.c b/rom/intuition/qrxresizescreen.c
new file mode 100644
index 00000000..0c319c29
--- /dev/null
+++ b/rom/intuition/qrxresizescreen.c
@@ -0,0 +1,140 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    QRX OS One: a screen changes its display mode and size in place, with its windows open.
+    SetIPrefs(IPREFS_TYPE_SCREENMODE) does this for the Workbench screen when smp_Control has
+    SMC_INPLACE set, instead of closing and opening it again (which windows of other programs
+    prevent). The Window, RastPort and Layer structures stay what they are, so programs keep
+    their pointers: only the bitmap under the layers is replaced.
+
+    The layers are hidden front to back (smart refresh contents go to their backup), the root
+    layer and every layer's bitmap pointer change, and the layers are shown again back to front;
+    showing a layer computes its visible part against the new root. Simple refresh windows get
+    their damage as usual.
+*/
+
+#include <aros/debug.h>
+#include <proto/exec.h>
+#include <proto/graphics.h>
+#include <proto/layers.h>
+#include <proto/intuition.h>
+#include <aros/libcall.h>
+#include <graphics/videocontrol.h>
+#include <graphics/gfxmacros.h>
+#include <intuition/iprefs.h>
+#include <string.h>
+
+#include "intuition_intern.h"
+#include "inputhandler_actions.h"
+
+#define MAX_LAYERS 256
+
+/* layers.library V50, LVO 41; not in every generated header */
+#ifndef ChangeLayerVisibility
+#define ChangeLayerVisibility(l, v) \
+    AROS_LC2(LONG, ChangeLayerVisibility, AROS_LCA(struct Layer *, (l), A0), AROS_LCA(LONG, (v), D0), \
+             struct LayersBase *, LayersBase, 41, Layers)
+#endif
+
+BOOL int_QRXResizeScreen(struct Screen *scr, ULONG modeid, ULONG w, ULONG h, struct IntuitionBase *IntuitionBase)
+{
+    struct IntIntuitionBase *_intuitionBase = GetPrivIBase(IntuitionBase);
+    struct GfxBase *GfxBase = _intuitionBase->GfxBase;
+    struct LayersBase *LayersBase = _intuitionBase->LayersBase;
+    struct IntScreen *is = GetPrivScreen(scr);
+    struct BitMap *oldbm = scr->RastPort.BitMap, *nbm;
+    struct Layer_Info *li = &scr->LayerInfo;
+    struct Layer *root, *l;
+    static struct Layer *ls[MAX_LAYERS];
+    static BOOL vis[MAX_LAYERS];
+    struct Rectangle all;
+    struct TagItem bmtags[] = { { BMATags_DisplayID, modeid }, { TAG_DONE, 0 } };
+    struct ViewPortExtra *vpe = NULL;
+    struct TagItem vctags[] = { { VTAG_VIEWPORTEXTRA_GET, 0 }, { TAG_DONE, 0 } };
+    struct TagItem modetags[] = { { VTAG_VPMODEID_SET, modeid }, { TAG_DONE, 0 } };
+    ULONG depth, ow, oh, n = 0, i;
+    struct Window *win;
+
+    ULONG ilock;
+    if (!scr || !oldbm || oldbm != is->AllocatedBitMap || w < 320 || h < 200)
+        return FALSE;                     /* a screen on a bitmap of its own program: not ours to swap */
+    depth = GetBitMapAttr(oldbm, BMA_DEPTH);
+    ow = scr->Width; oh = scr->Height;
+    nbm = AllocBitMap(w, h, depth, BMF_DISPLAYABLE | BMF_CLEAR | BMF_CHECKVALUE, (struct BitMap *)bmtags);
+    if (!nbm)
+        return FALSE;
+
+    ilock = LockIBase(0);
+    LockLayerInfo(li);
+    LockLayers(li);
+    root = li->check_lp;
+    if (!root) { UnlockLayers(li); UnlockLayerInfo(li); UnlockIBase(ilock); FreeBitMap(nbm); return FALSE; }
+
+    /* the layers on the root, front to back */
+    for (l = li->top_layer; l && n < MAX_LAYERS; l = l->back)
+        if (l != root && l->parent == root) { ls[n] = l; vis[n] = l->visible; n++; }
+    for (i = 0; i < n; i++)
+        if (vis[i]) ChangeLayerVisibility(ls[i], FALSE);
+
+    BltBitMap(oldbm, 0, 0, nbm, 0, 0, w < ow ? w : ow, h < oh ? h : oh, 0xC0, 0xFF, NULL);
+
+    for (l = li->top_layer; l; l = l->back)
+        if (l->rp && l->rp->BitMap == oldbm) l->rp->BitMap = nbm;
+
+    all.MinX = 0; all.MinY = 0; all.MaxX = w - 1; all.MaxY = h - 1;
+    root->bounds = all;
+    root->Width = w; root->Height = h;
+    ClearRegion(root->shape);         OrRectRegion(root->shape, &all);
+    ClearRegion(root->visibleshape);  OrRectRegion(root->visibleshape, &all);
+    ClearRegion(root->VisibleRegion); OrRectRegion(root->VisibleRegion, &all);
+    /* a layer sees what of its shape lies inside its parent, the root */
+    for (i = 0; i < n; i++) {
+        ClearRegion(ls[i]->visibleshape);
+        OrRegionRegion(ls[i]->shape, ls[i]->visibleshape);
+        AndRegionRegion(root->shape, ls[i]->visibleshape);
+    }
+    for (i = n; i-- > 0;)
+        if (vis[i]) ChangeLayerVisibility(ls[i], TRUE);
+    UnlockLayers(li);
+    UnlockLayerInfo(li);
+
+    scr->RastPort.BitMap = nbm;
+    is->AllocatedBitMap = nbm;
+    scr->ViewPort.RasInfo->BitMap = nbm;
+    scr->Width = w; scr->Height = h;
+    scr->ViewPort.DWidth = w; scr->ViewPort.DHeight = h;
+    is->ModeID = modeid;
+    if (VideoControl(scr->ViewPort.ColorMap, vctags) == 0) {
+        vpe = (struct ViewPortExtra *)vctags[0].ti_Data;
+        if (vpe) vpe->DisplayClip = all;
+    }
+    VideoControl(scr->ViewPort.ColorMap, modetags);
+
+    /* the title bar is as wide as the screen */
+    KillScreenBar(scr, IntuitionBase);
+    CreateScreenBar(scr, IntuitionBase);
+
+    /* MakeScreen and RethinkDisplay go through the input handler, which needs the IBase lock */
+    UnlockIBase(ilock);
+    MakeScreen(scr);
+    RethinkDisplay();
+    /* windows that would lie outside are pulled in */
+    for (win = scr->FirstWindow; win; win = win->NextWindow) {
+        WORD x = win->LeftEdge, y = win->TopEdge;
+        if (x + win->Width > (WORD)w) x = (WORD)w - win->Width;
+        if (y + win->Height > (WORD)h) y = (WORD)h - win->Height;
+        if (x < 0) x = 0;
+        if (y < 0) y = 0;
+        if (x != win->LeftEdge || y != win->TopEdge) MoveWindow(win, x - win->LeftEdge, y - win->TopEdge);
+    }
+
+    /* The pointer and the display may still use the old bitmap for a moment: it goes at the
+     * next change, not now. */
+    {
+        static struct BitMap *previous;
+        if (previous) FreeBitMap(previous);
+        previous = oldbm;
+    }
+    CheckLayers(scr, IntuitionBase);
+    return TRUE;
+}
