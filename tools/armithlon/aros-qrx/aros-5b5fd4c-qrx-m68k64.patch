+#define LOCAL_PERMIT()   qrx_local_permit(SysBase)
+#define LOCAL_DISABLE()  qrx_local_disable(SysBase)
+#define LOCAL_ENABLE()   qrx_local_enable(SysBase)
+#define LOCAL_SUSPEND()  qrx_local_forbid_suspend()
+#define LOCAL_RESUME()   qrx_local_forbid_resume()
+#else
+#define LOCAL_FORBID()   Forbid()
+#define LOCAL_PERMIT()   Permit()
+#define LOCAL_DISABLE()  Disable()
+#define LOCAL_ENABLE()   Enable()
+#define LOCAL_SUSPEND()
+#define LOCAL_RESUME()
+#endif
