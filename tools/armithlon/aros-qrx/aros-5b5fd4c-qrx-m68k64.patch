diff --git a/arch/m68k64-native/qrx/battclock/readbattclock.c b/arch/m68k64-native/qrx/battclock/readbattclock.c
new file mode 100644
index 00000000..f9075513
--- /dev/null
+++ b/arch/m68k64-native/qrx/battclock/readbattclock.c
@@ -0,0 +1,28 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: ReadBattClock() for the 68100EC64: the ARMithlon board's host clock (seconds since 1970,
+          UTC) in its device window, see docs/armithlon/68100ec64.md. There is no MMU, so the
+          resource reads the register directly.
+*/
+
+#include <aros/libcall.h>
+#include <exec/types.h>
+#include <proto/battclock.h>
+
+#include "battclock_intern.h"
+
+#define QEC64_CLOCK_UNIX    (0xFFFFFFFF00000000UL + 0x0308)
+#define AMIGA_EPOCH         252460800UL     /* 1978-01-01 in Unix time */
+
+AROS_LH0(ULONG, ReadBattClock,
+         struct BattClockBase *, BattClockBase, 2, Battclock)
+{
+    AROS_LIBFUNC_INIT
+
+    UQUAD t = *(volatile UQUAD *)QEC64_CLOCK_UNIX;
+
+    return t > AMIGA_EPOCH ? (ULONG)(t - AMIGA_EPOCH) : 0;
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/arch/m68k64-native/qrx/boot/boot.c b/arch/m68k64-native/qrx/boot/boot.c
