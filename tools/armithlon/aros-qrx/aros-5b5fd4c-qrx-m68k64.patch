+# $Id $
+
+include $(SRCDIR)/config/aros.cfg
+
+TARGETDIR       := $(GENDIR)/$(CURDIR)
+FILES           := boot
+USER_CFLAGS     := -Wall $(CFLAGS_NO_BUILTIN)
+KERNEL_LDFLAGS  =
+USER_INCLUDES   := -isystem $(SRCDIR)/$(CURDIR)/include -I$(SRCDIR)/rom/openfirmware
+USER_CPPFLAGS   := -DTARGET_SECTION_COMMENT=\"\n\#\"
+USER_CPPFLAGS   += -DUSE_UBOOT
+OPTIMIZATION_CFLAGS := -O2
+
+M68K64_BSP := aros-$(AROS_TARGET_CPU)-bsp.rom
+M68K64_COREFILE := $(TARGETDIR)/core.bin.o
+
+#MM- distfiles-qrx-m68k64 : distfiles-qrx
+#MM- distfiles-qrx-m68k64-quick : distfiles-qrx
+
+#MM- distfiles-qrx-quick : distfiles-qrx
+
+#MM distfiles-qrx : \
+#MM kernel-qrx-m68k64 \
+#MM kernel-package-qrx-m68k64
+
+#MM- kernel-package-qrx-m68k64-quick: \
+#MM linklibs-stdc-static-quick \
+#MM kernel-package-native-m68k64-quick
+
+#MM kernel-package-qrx-m68k64: \
+#MM linklibs-stdc-static \
+#MM kernel-package-native-m68k64
+
+PKG_LIBS      := aros partition utility oop graphics layers intuition keymap dos poseidon cgxbootpic
+PKG_LIBS_ARCH := expansion
+PKG_RSRC      := openfirmware misc bootloader dosboot lddemon FileSystem shell shellcommands
+PKG_RSRC_ARCH := processor
+PKG_DEVS      := input gameport keyboard console
+PKG_DEVS_ARCH := timer
+PKG_HANDLERS  := con ram cdrom sfs fat afs
+PKG_HIDDS     := gfx mouse keyboard hiddclass i2c
+PKG_CLASSES   := 
+
+%make_package mmake=kernel-package-qrx-m68k64 file=$(AROSDIR)/$(M68K64_BSP) \
+    libs=$(PKG_LIBS) arch_libs=$(PKG_LIBS_ARCH) res=$(PKG_RSRC) \
+    arch_res=$(PKG_RSRC_ARCH) devs=$(PKG_DEVS) arch_devs=$(PKG_DEVS_ARCH) \
+    handlers=$(PKG_HANDLERS) hidds=$(PKG_HIDDS) classes=$(PKG_CLASSES)
+
+#MM
+distfiles-qrx-bootimg: $(AROSDIR)/aros-$(AROS_TARGET_CPU)-qrx.img
+
+#MM
+distfiles-qrx-bootimg-quick: $(AROSDIR)/aros-$(AROS_TARGET_CPU)-qrx.img
+
+$(AROSDIR)/aros-m68k64-qrx.img: $(M68K64_COREFILE) $(foreach f, $(FILES), $(TARGETDIR)/$(f).o $(TARGETDIR)/$(f).d) | $(OSGENDIR)/boot
+	@$(ECHO) "Creating   $@"
+	@$(KERNEL_LD) -Map $(OSGENDIR)/boot/aros-m68k64-qrx.img.map --entry=bootstrap --script=$(SRCDIR)/$(CURDIR)/ldscript.lds $(foreach f, $(FILES), $(TARGETDIR)/$(f).o) $ $(M68K64_COREFILE) -L$(AROS_LIB) -lstdc.static -o $(OSGENDIR)/boot/aros-m68k64-qrx.img.elf
+	@$(TARGET_STRIP) --strip-unneeded -R .note -R .comment $(OSGENDIR)/boot/aros-m68k64-qrx.img.elf
+	@$(TARGET_OBJCOPY) -O binary $(OSGENDIR)/boot/aros-m68k64-qrx.img.elf $@
+
+$(TARGETDIR)/core.bin.o: $(OSGENDIR)/boot/core.elf | $(OSGENDIR)/boot
+	@$(CP) $(OSGENDIR)/boot/core.elf $(TARGETDIR)/core.bin
+	@cd $(TARGETDIR) && $(KERNEL_LD) $(KERNEL_LDFLAGS) -r --format binary core.bin -o $@
+
+#MM
+distfiles-qrx : $(AROSDIR)/aros-m68k64-qrx.img  $(AROSDIR)/$(M68K64_BSP)
+	@$(ECHO) Copying QRX 68100EC64 distfiles...
+	@$(CP) -R $(AROSDIR) $(DISTDIR)/
+
+#MM
+clean ::
+	-$(RM) $(TESTS)
+
+$(TARGETDIR)/%.o : %.c
+	%compile_q
+
+$(TARGETDIR)/%.o : %.S
+	%compile_q
+
+$(TARGETDIR)/%.d : %.c
+	%mkdepend_q
+
+$(OSGENDIR)/boot :
+	%mkdir_q dir=$@
+
+#
+# the following rules are for testing purposes only ..
+#
+
+#MM
+distfiles-qrx-test-imgobjects : $(foreach f, $(FILES), $(TARGETDIR)/$(f).o)
+
+#MM- distfiles-qrx-test-imgobjects-quick : distfiles-qrx-test-imgobjects
+
+#MM
+distfiles-qrx-test-img : $(AROSDIR)/aros-m68k64-qrx.img
+
+#MM- distfiles-qrx-test-img-quick : distfiles-qrx-test-img
+
+#
+#
+#
+
+DEPS	:= $(foreach f, $(FILES), $(TARGETDIR)/$(f).d)
+
+-include $(DEPS)
+
+%common
