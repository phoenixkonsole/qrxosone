diff --git a/arch/m68k64-native/exec/platform_init.c b/arch/m68k64-native/exec/platform_init.c
new file mode 100644
index 00000000..beb02adb
--- /dev/null
+++ b/arch/m68k64-native/exec/platform_init.c
@@ -0,0 +1,252 @@
+/*
+    Copyright (C) 2023, The AROS Development Team. All rights reserved.
+*/
+
+#define DEBUG 0
+
+#include <aros/debug.h>
+#include <aros/cpu.h>
+#include <aros/kernel.h>
+#include <aros/symbolsets.h>
+#include <exec/memory.h>
+#include <exec/tasks.h>
+#include <exec/alerts.h>
+#include <exec/execbase.h>
+#include <exec/pm.h>
+#include <exec/interrupts.h>
+
+#include <proto/exec.h>
+#include <proto/kernel.h>
+
+#include <strings.h>
+#include <stdio.h>
+
+#include "kernel_cpu.h"
+#include <exec/rawfmt.h>
+
+#include "exec_intern.h"
+#if defined(__AROSEXEC_SMP__)
+#include "etask.h"
+#endif
+
+extern void IdleTask(struct ExecBase *);
+
+/*
+    The end of exec's reset callbacks for every action (ShutdownA, ColdReboot): the kernel ends the
+    run on the reference machine, see SC_REBOOT in the kernel's intr.c.
+*/
+AROS_INTH1(Exec_M68K64ShutdownHandler, struct Interrupt *, handler)
+{
+    AROS_INTFUNC_INIT
+
+    register unsigned long sc asm("d0") = 0x100;        /* SC_REBOOT */
+    register unsigned long action asm("d1") = handler->is_Node.ln_Type & SD_ACTION_MASK;
+
+    asm volatile ("trap #0" : "+d"(sc) : "d"(action) : "a0", "a1", "memory", "cc");
+
+    return FALSE;
+
+    AROS_INTFUNC_EXIT
+}
+
+int Exec_M68K64CPUInit(struct ExecBase *SysBase)
+{
+    struct Task *BootTask, *CPUIdleTask;
+    int cpu, cpunum = KrnGetCPUCount();
+    char *taskName;
+
+    D(bug("[Exec] %s()\n", __PRETTY_FUNCTION__));
+
+    BootTask = GET_THIS_TASK;
+
+    PrivExecBase(SysBase)->ShutdownHandler.is_Node.ln_Pri = -128;
+    PrivExecBase(SysBase)->ShutdownHandler.is_Node.ln_Name = "System Shutdown";
+    PrivExecBase(SysBase)->ShutdownHandler.is_Code = (VOID_FUNC)Exec_M68K64ShutdownHandler;
+    PrivExecBase(SysBase)->ShutdownHandler.is_Data = &PrivExecBase(SysBase)->ShutdownHandler;
+    AddResetCallback(&PrivExecBase(SysBase)->ShutdownHandler);
+
+    D(bug("[Exec] %s: launched from %s @ 0x%p, %d cores\n", __PRETTY_FUNCTION__, BootTask->tc_Node.ln_Name, BootTask, cpunum));
+
+#if defined(__AROSEXEC_SMP__)
+    /*
+        As x86 does (cpu_PrepareExec): every task is bound to a core from now on. The tasks that exist
+        stay on core 0, new ones on the core that creates them unless they ask otherwise. exec's
+        Forbid() and the code that relies on it only keep other tasks on the same core out.
+    */
+    {
+        struct Task *t;
+        void *mask = KrnAllocCPUMask();
+
+        KrnGetCPUMask(0, mask);
+        PrivExecBase(SysBase)->CPUMask = mask;
+#define BIND0(task) do { if (!IntETask((task)->tc_UnionETask.tc_ETask)->iet_CpuAffinity) { \
+            IntETask((task)->tc_UnionETask.tc_ETask)->iet_CpuAffinity = KrnAllocCPUMask(); \
+            KrnGetCPUMask(0, IntETask((task)->tc_UnionETask.tc_ETask)->iet_CpuAffinity); } } while (0)
+        BIND0(BootTask);
+        ForeachNode(&SysBase->TaskReady, t)
+            BIND0(t);
+        ForeachNode(&SysBase->TaskWait, t)
+            BIND0(t);
+#undef BIND0
+        PrivExecBase(SysBase)->IntFlags |= EXECF_CPUAffinity;
+    }
+#endif
+
+    /* One idle task per core, bound to it */
+    for (cpu = 0; cpu < cpunum; cpu ++)
+    {
+        IPTR nameArg[1] = { cpu };
+#if defined(__AROSEXEC_SMP__)
+        void *cpuMask = KrnAllocCPUMask();
+
+        KrnGetCPUMask(cpu, cpuMask);
+#endif
+
+        taskName = AllocVec(16, MEMF_CLEAR);
+        if (taskName)
+            RawDoFmt("CPU #%02ld Idle", (RAWARG)nameArg, RAWFMTFUNC_STRING, taskName);
+        CPUIdleTask = NewCreateTask(TASKTAG_NAME   , taskName ? taskName : "System Idle",
+#if defined(__AROSEXEC_SMP__)
+                                TASKTAG_AFFINITY   , cpuMask,
+#endif
+                                TASKTAG_PRI        , -127,
+                                TASKTAG_PC         , IdleTask,
+                                TASKTAG_ARG1       , SysBase,
+                                TAG_DONE);
+
+        if (CPUIdleTask)
+        {
+            D(bug("[Exec] %s: %s Task created @ 0x%p\n", __PRETTY_FUNCTION__, CPUIdleTask->tc_Node.ln_Name, CPUIdleTask));
+        }
+    }
+
+#if defined(__AROSEXEC_SMP__)
+    /* Start the other cores: the kernel does that in supervisor state, through TRAP #3 */
+    if (cpunum > 1)
+    {
+        register unsigned long fn asm("d0") = 1;        /* M68K64_TRAP3_STARTCORES */
+        asm volatile ("trap #3" : "+d"(fn) : : "d1", "a0", "a1", "memory", "cc");
+    }
+#endif
+
+    return TRUE;
+}
+
+#if defined(__AROSEXEC_SMP__)
+struct Hook Exec_TaskSpinLockFailHook;
+
+AROS_UFH3(void, Exec_TaskSpinLockFailFunc,
+    AROS_UFHA(struct Hook *, h, A0),
+    AROS_UFHA(spinlock_t *, thisLock, A1),
+    AROS_UFHA(void *, unused, A2))
+{
+    AROS_USERFUNC_INIT
+
+    struct Task *thisTask = GET_THIS_TASK;
+
+    /* tell the scheduler that the task is waiting on a spinlock */
+    thisTask->tc_State = TS_SPIN;
+    GetIntETask(thisTask)->iet_SpinLock = thisLock;
+
+    AROS_USERFUNC_EXIT
+}
+
+void Exec_TaskSpinUnlock(spinlock_t *thisLock)
+{
+    struct Task *curTask, *nxtTask;
+
+    Kernel_52_KrnSpinLock(&PrivExecBase(SysBase)->TaskSpinningLock, NULL,
+                SPINLOCK_MODE_WRITE, NULL);
+    ForeachNodeSafe(&PrivExecBase(SysBase)->TaskSpinning, curTask, nxtTask)
+    {
+        if (GetIntETask(curTask)->iet_SpinLock == thisLock)
+        {
+            Kernel_52_KrnSpinLock(&PrivExecBase(SysBase)->TaskReadySpinLock, NULL,
+                SPINLOCK_MODE_WRITE, NULL);
+            Disable();
+            Remove(&curTask->tc_Node);
+            Enqueue(&SysBase->TaskReady, &curTask->tc_Node);
+            Kernel_53_KrnSpinUnLock(&PrivExecBase(SysBase)->TaskReadySpinLock, NULL);
+            Enable();
+        }
+    }
+    Kernel_53_KrnSpinUnLock(&PrivExecBase(SysBase)->TaskSpinningLock, NULL);
+}
+
+static spinlock_t *m68k64_ListLock(struct ExecBase *SysBase, ULONG state, struct List **list)
+{
+    switch (state)
+    {
+    case TS_RUN:   *list = &PrivExecBase(SysBase)->TaskRunning;  return &PrivExecBase(SysBase)->TaskRunningSpinLock;
+    case TS_READY: *list = &SysBase->TaskReady;                  return &PrivExecBase(SysBase)->TaskReadySpinLock;
+    case TS_WAIT:  *list = &SysBase->TaskWait;                   return &PrivExecBase(SysBase)->TaskWaitSpinLock;
+    case TS_SPIN:  *list = &PrivExecBase(SysBase)->TaskSpinning; return &PrivExecBase(SysBase)->TaskSpinningLock;
+    default:       *list = NULL;                                 return NULL;
+    }
+}
+
+/* krnSysCallReschedTask(): x86 does this in a syscall, here Disable() keeps this core out */
+void Exec_M68K64ReschedTask(struct Task *task, ULONG state)
+{
+    struct List *list;
+    spinlock_t *lock;
+
+    Disable();
+
+    lock = m68k64_ListLock(SysBase, task->tc_State, &list);
+    if (lock)
+        EXEC_SPINLOCK_LOCK(lock, NULL, SPINLOCK_MODE_WRITE);
+    if (task->tc_State != TS_INVALID && task->tc_State != TS_TOMBSTONED)
+        Remove(&task->tc_Node);
+    if (lock)
+        EXEC_SPINLOCK_UNLOCK(lock);
+
+    if (state == TS_REMOVED)
+        task->tc_State = TS_TOMBSTONED;
+    else
+    {
+        if (state == TS_UNSPIN)
+            state = TS_READY;
+        task->tc_State = state;
+        lock = m68k64_ListLock(SysBase, state, &list);
+        if (list)
+        {
+            if (lock)
+                EXEC_SPINLOCK_LOCK(lock, NULL, SPINLOCK_MODE_WRITE);
+            Enqueue(list, &task->tc_Node);
+            if (lock)
+                EXEC_SPINLOCK_UNLOCK(lock);
+        }
+    }
+
+    Enable();
+}
+
+/* krnSysCallSwitch() in RemTask(NULL), inside its Forbid(): this core keeps running the task */
+void Exec_M68K64DetachTask(void)
+{
+    struct Task *task = GET_THIS_TASK;
+
+    Disable();
+    EXEC_SPINLOCK_LOCK(&PrivExecBase(SysBase)->TaskRunningSpinLock, NULL, SPINLOCK_MODE_WRITE);
+    Remove(&task->tc_Node);
+    EXEC_SPINLOCK_UNLOCK(&PrivExecBase(SysBase)->TaskRunningSpinLock);
+    task->tc_State = TS_TOMBSTONED;
+    Enable();
+}
+
+int Exec_M68K64CPUSMPInit(struct ExecBase *SysBase)
+{
+
+    /* set up the task spinning hook */
+    Exec_TaskSpinLockFailHook.h_Entry = (HOOKFUNC)Exec_TaskSpinLockFailFunc;
+
+    D(bug("[Exec] %s: Task SpinLock Fail hook @ 0x%p initialised (func @ 0x%p)\n", __PRETTY_FUNCTION__, &Exec_TaskSpinLockFailHook, Exec_TaskSpinLockFailHook.h_Entry));
+
+    return TRUE;
+}
+
+ADD2INITLIB(Exec_M68K64CPUSMPInit, -127)
+#endif
+
+ADD2INITLIB(Exec_M68K64CPUInit, 0)
