+++ b/arch/m68k64-native/kernel/kernel_debug.c
@@ -0,0 +1,19 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Debug output of the 68100EC64 kernel. The machine's console is MOVEC $8F0, which is
+    privileged, and bug() runs in user state too, so a character goes through TRAP #1 with the
+    character in D0. intr.c writes it out.
+*/
+
+#include <aros/kernel.h>
+#include <kernel_base.h>
+#include <kernel_debug.h>
+
+int krnPutC(int chr, struct KernelBase *KernelBase)
+{
+    register unsigned long c asm("d0") = (unsigned char)chr;
+
+    asm volatile ("trap #1" : : "d"(c) : "memory", "cc");
+    return 1;
+}
diff --git a/arch/m68k64-native/kernel/kernel_intern.h b/arch/m68k64-native/kernel/kernel_intern.h
new file mode 100644
index 00000000..97e3ffac
--- /dev/null
+++ b/arch/m68k64-native/kernel/kernel_intern.h
@@ -0,0 +1,72 @@
+/*
+    Copyright (C) 2023, The AROS Development Team. All rights reserved.
+*/
+
+#ifndef KERNEL_INTERN_H_
+#define KERNEL_INTERN_H_
+
+#include <aros/libcall.h>
+#include <inttypes.h>
+#include <exec/lists.h>
+#include <exec/execbase.h>
+#include <exec/memory.h>
+#include <utility/tagitem.h>
+#include <stdio.h>
+#include <stdarg.h>
+
+#undef KernelBase
+struct KernelBase;
+
+#define __STR(x) #x
+#define STR(x) __STR(x)
+
+#ifdef D
+#undef D
+#endif
+#if DEBUG
+#define D(x) x
+#define DALLOCMEM(x)
+#else
+#define D(x)
+#define DALLOCMEM(x)
+#endif
+
+AROS_LD2(int, KrnBug,
+         AROS_LDA(const char *, format, A0),
+         AROS_LDA(va_list, args, A1),
+         struct KernelBase *, KernelBase, 12, Kernel);
+
+#ifdef bug
+#undef bug
+#endif
+static inline void _kibug(struct KernelBase *kbase, const char *format, ...)
+{
+    va_list args;
+    va_start(args, format);
+    AROS_SLIB_ENTRY(KrnBug, Kernel, 12)(format, args, kbase);
+    va_end(args);
+}
+#define bug(fmt,args...) _kibug(KernelBase, fmt, ##args)
+
+/*
+    regs_t is struct ExceptionContext, built by the exception entry in intr.c on the
+    supervisor stack, so a task switch copies it whole. a[7] is the task's user stack.
+*/
+#define STORE_TASKSTATE(task, regs)                 \
+    struct ExceptionContext *ctx = task->tc_UnionETask.tc_ETask->et_RegFrame;   \
+    *ctx = *(regs);                                 \
+    task->tc_SPReg = (void *)ctx->a[7];
+
+#define RESTORE_TASKSTATE(task, regs)               \
+    struct ExceptionContext *ctx = task->tc_UnionETask.tc_ETask->et_RegFrame;   \
+    ctx->a[7] = (UQUAD)task->tc_SPReg;              \
+    *(regs) = *ctx;
+
+#include "tls.h"
+
+/* MOVEC $80E is privileged, so the number the kernel read at core start is kept in TLS. */
+static inline int GetCPUNumber(void) {
+    return TLS_GET(CPUNumber);
+}
+
+#endif /*KERNEL_INTERN_H_*/
