+#!/bin/sh
+
+# This is wrapper around AROS-targetted clang needed to create non-relocatable ELF files.
+# It is required to build bootstraps for native AROS.
+# clang has no spec files: the AROS target and the sysroot come from the build's flags.
+
+exec @orig_target_cc@ "$@" -static
