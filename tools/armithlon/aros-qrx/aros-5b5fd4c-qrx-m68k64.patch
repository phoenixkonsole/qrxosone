@@ -0,0 +1,31 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    KrnSpinUnLock on the 68100EC64. See rom/kernel/spinunlock.c for documentation.
+*/
+
+#include <aros/kernel.h>
+#include <aros/libcall.h>
+#include <exec/tasks.h>
+#include <aros/types/spinlock_s.h>
+
+#include <kernel_base.h>
+
+#include <proto/kernel.h>
+
+AROS_LH1(void, KrnSpinUnLock,
+    AROS_LHA(spinlock_t *, lock, A0),
+    struct KernelBase *, KernelBase, 53, Kernel)
+{
+    AROS_LIBFUNC_INIT
+
+    unsigned int v = __atomic_load_n(&lock->lock, __ATOMIC_RELAXED);
+
+    lock->s_Owner = NULL;
+    if (v & SPINLOCKF_WRITE)
+        __atomic_store_n(&lock->lock, SPINLOCK_UNLOCKED, __ATOMIC_RELEASE);
+    else if (v)
+        __atomic_fetch_sub(&lock->lock, 1, __ATOMIC_RELEASE);
+
+    AROS_LIBFUNC_EXIT
+}
