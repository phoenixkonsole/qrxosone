@@ -0,0 +1,247 @@
+/*
+    Copyright (C) 1995-2023, The AROS Development Team. All rights reserved.
+
+    Desc: Class for VESA.
+*/
+
+#include <aros/asmcall.h>
+#include <proto/exec.h>
+#include <proto/oop.h>
+#include <proto/utility.h>
+#include <aros/symbolsets.h>
