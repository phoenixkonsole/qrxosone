# QRX ARMithlon Pi 4: on top of arch/arm64/configs/bcm2711_defconfig (Raspberry Pi Linux 6.6).
# Every driver the appliance uses is built in and its firmware embedded: no modules, no initramfs.
CONFIG_LOCALVERSION="-qrx-pi4"
CONFIG_LOCALVERSION_AUTO=n
# --- display and 3D: KMS (vc4) and the V3D GPU, HDMI audio
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_VC4_HDMI_CEC=y
CONFIG_DRM_V3D=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_SOC=y
CONFIG_SND_DMAENGINE_PCM=y
CONFIG_SND_SOC_GENERIC_DMAENGINE_PCM=y
CONFIG_SND_HDA_CODEC_HDMI=n
# analogue headphone jack (staging bcm2835-audio, through the VCHIQ service)
CONFIG_STAGING=y
CONFIG_BCM2835_VCHIQ=y
CONFIG_SND_BCM2835=y
CONFIG_VCHIQ_CDEV=y
# --- input: USB keyboards, mice, gamepads
CONFIG_PCIE_BRCMSTB=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_DWC2=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
# The image loads no modules: common devices whose drivers bcm2711_defconfig builds as modules
# are built in (receivers and keyboards of Logitech, Apple and Microsoft, touch screens, game
# pads, USB sound)
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_APPLE=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_SONY=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_SND_USB_AUDIO=y
CONFIG_INPUT_JOYDEV=y
CONFIG_USB_STORAGE=y
# --- Ethernet (GENET + Broadcom PHY)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_BCMGENET=y
CONFIG_BROADCOM_PHY=y
CONFIG_MDIO_BCM_UNIMAC=y
# --- WiFi (CYW43455 on SDIO) with embedded firmware and regulatory database
CONFIG_CFG80211=y
# the regulatory database stays signed: regulatory.db.p7s (wireless-regdb) is built in next to it,
# checked against the keys in the kernel (CFG80211_USE_KERNEL_REGDB_KEYS)
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_MMC=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_IPROC=y
# --- Bluetooth over the UART (hci_uart with the Broadcom protocol)
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_UHID=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_AES=y
# --- firmware inside the kernel image
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="brcm/brcmfmac43455-sdio.bin brcm/brcmfmac43455-sdio.clm_blob brcm/brcmfmac43455-sdio.txt brcm/BCM4345C0.hcd regulatory.db regulatory.db.p7s"
CONFIG_EXTRA_FIRMWARE_DIR="firmware-qrx"
# --- file systems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
# --- performance for the emulator
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_1000=y
# core 3 belongs to the 68k CPU thread: no timer tick and no RCU callbacks there while it runs
# alone (cmdline.txt: isolcpus=3 nohz_full=3 rcu_nocbs=3)
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_SCHED_AUTOGROUP=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_BTF=n
# KALLSYMS_ALL and AUDIT stay on: other options of bcm2711_defconfig select them
CONFIG_FTRACE=n
CONFIG_SLUB_DEBUG=n
CONFIG_PROVE_LOCKING=n
