; ThunderCat for AROS (Gecko 153.8.0) on QRX OS One 64, from the QRX App Store (APPS:thundercat)
; Gecko in one process, software rendering, in a window on the desktop.
; a step that fails (a folder that is already there, ...) must not end the script before ThunderCat starts
FailAt 21
Stack 2000000
; PIPE: for Gecko's pipes
If NOT EXISTS PIPE:
  If EXISTS DEVS:DOSDrivers/PIPE
    Mount >NIL: DEVS:DOSDrivers/PIPE
  EndIf
EndIf
; the fonts come with the app; Gecko reads FONTS:TrueType
Assign >NIL: FONTS: EXISTS
If WARN
  Assign >NIL: FONTS: APPS:thundercat/Fonts
Else
  If NOT EXISTS FONTS:TrueType/VeraSans.ttf
    Assign >NIL: FONTS: APPS:thundercat/Fonts ADD
  EndIf
EndIf
; the profile lives outside the app's folder, so an update keeps it
If NOT EXISTS SYS:Home
  MakeDir >NIL: SYS:Home
EndIf
If NOT EXISTS SYS:Home/ThunderCat
  MakeDir >NIL: SYS:Home/ThunderCat
EndIf
; a first start opens a window of 1000 x 700 with the desktop around it; later the size you chose
If NOT EXISTS SYS:Home/ThunderCat/xulstore.json
  Copy >NIL: APPS:thundercat/xulstore.json SYS:Home/ThunderCat/xulstore.json
EndIf
; T: for Gecko's temporary files (TMPDIR /T); EXISTS T: on an unassigned T: would ask for a volume
Assign >NIL: T: EXISTS
If WARN
  If NOT EXISTS SYS:T
    MakeDir >NIL: SYS:T
  EndIf
  Assign >NIL: T: SYS:T
EndIf
Set TMPDIR /T
Set HOME /SYS/Home
; AROS cannot start Gecko's content processes (fork, shared memory handed to a child)
Set MOZ_FORCE_DISABLE_E10S 1
APPS:thundercat/ThunderCat --profile /SYS/Home/ThunderCat {URL$file:///APPS/thundercat/start.html}
