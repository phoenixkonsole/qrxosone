+# QRX OS One 64: AROS has no dynamic linker, so Gecko's "shared libraries" are relocatable objects
+# (ld -r, see build/moz.configure/flags.configure). Each one holds only its own objects and static
+# libraries; next to it, <lib>.deps names the other libraries it needs and its OS_LIBS. A program
+# links the transitive closure: every library once, dependents before their dependencies, then the
+# OS libraries. usage: aros-dso-closure.py <shared libs of the program>...
+import os
+import sys
+
+order, seen, oslibs = [], set(), []
+
+
+def visit(lib):
+    lib = os.path.abspath(lib)
+    if lib in seen:
+        return
+    seen.add(lib)
+    deps = []
+    if os.path.exists(lib + ".deps"):
+        for line in open(lib + ".deps"):
+            line = line.strip()
+            if not line:
+                continue
+            if line.startswith("OS:"):
+                if line[3:] not in oslibs:
+                    oslibs.append(line[3:])
+            else:
+                deps.append(line)
+    order.append(lib)
+    for d in deps:
+        visit(d)
+
+
+for a in sys.argv[1:]:
+    visit(a)
+print(" ".join(order + oslibs))
