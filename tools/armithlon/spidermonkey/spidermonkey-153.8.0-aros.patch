+nsresult HeadlessWidget::SetTitle(const nsAString& aTitle) {
+  // Intuition titles are 8-bit: Latin-1, other characters as '?'
+  mQrxTitle.Truncate();
+  for (const char16_t* c = aTitle.BeginReading(); c != aTitle.EndReading(); ++c) {
+    char16_t ch = *c;
+    if (ch == 0x2013 || ch == 0x2014 || ch == 0x2012 || ch == 0x2212) ch = '-';
+    else if (ch == 0x2018 || ch == 0x2019) ch = '\'';
+    else if (ch == 0x201C || ch == 0x201D) ch = '"';
+    else if (ch == 0x2026) { mQrxTitle.AppendLiteral("..."); continue; }
+    mQrxTitle.Append(ch < 256 ? char(ch) : '?');
+  }
+  if (mQrxWin) qrx_win_title(mQrxWin, mQrxTitle.get());
+  return NS_OK;
