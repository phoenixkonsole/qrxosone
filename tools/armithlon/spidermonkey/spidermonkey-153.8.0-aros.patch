+
+#define QRX_APPSHELL_GECKO 1   /* Gecko events are pending */
+#define QRX_APPSHELL_BREAK 2   /* Ctrl-C: the user asks the program to stop */
+#define QRX_APPSHELL_WINDOW 4  /* a window's port has messages */
+
+int qrx_appshell_init(void);
+void qrx_appshell_shutdown(void);
+void qrx_appshell_wake(void);                       /* any thread */
+void qrx_appshell_add_wait_mask(unsigned long mask);
+unsigned qrx_appshell_wait(int may_wait);           /* main thread: QRX_APPSHELL_* bits */
+
