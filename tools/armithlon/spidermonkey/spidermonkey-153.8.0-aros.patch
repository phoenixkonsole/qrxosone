+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsAppShell.h"
+#include "aros_appshell_glue.h"
+#include "gfxPlatform.h"
+#include "HeadlessScreenHelper.h"
+#include "mozilla/Hal.h"
+#include "mozilla/widget/ScreenManager.h"
+#include "nsCOMPtr.h"
+#include "nsIAppStartup.h"
+#include "nsServiceManagerUtils.h"
+#include "nsXULAppAPI.h"
+
+using namespace mozilla;
+using namespace mozilla::widget;
+
+nsresult nsAppShell::Init() {
+  if (qrx_appshell_init()) return NS_ERROR_FAILURE;
+  hal::Init();
+  if (XRE_IsParentProcess()) {
+    /* the screens: the headless helper until widget/aros has Intuition windows */
+    ScreenManager::GetSingleton().SetHelper(MakeUnique<HeadlessScreenHelper>());
+  }
+  return nsBaseAppShell::Init();
+}
+
+nsAppShell::~nsAppShell() {
+  hal::Shutdown();
+  qrx_appshell_shutdown();
+}
+
+void nsAppShell::ScheduleNativeEventCallback() { qrx_appshell_wake(); }
+
+bool nsAppShell::ProcessNextNativeEvent(bool aMayWait) {
+  unsigned got = qrx_appshell_wait(aMayWait);
+  if (got & QRX_APPSHELL_BREAK) {
+    /* Ctrl-C as on any AROS program: quit the application */
+    nsCOMPtr<nsIAppStartup> appStartup = do_GetService(NS_APPSTARTUP_CONTRACTID);
+    if (appStartup) {
+      bool userAllowedQuit = true;
+      appStartup->Quit(nsIAppStartup::eAttemptQuit, 0, &userAllowedQuit);
+    }
+  }
+  if (got & QRX_APPSHELL_GECKO) {
+    NativeEventCallback();
+    return true;
+  }
+  return got != 0;
+}
