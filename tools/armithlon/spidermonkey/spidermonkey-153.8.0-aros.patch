+PRWord* _MD_HomeGCRegisters(PRThread* t, int isCurrent, int* np) {
+#ifndef _PR_PTHREADS
+  if (isCurrent) {
+    (void)setjmp(CONTEXT(t));
+  }
+  *np = sizeof(CONTEXT(t)) / sizeof(PRWord);
+  return (PRWord*)CONTEXT(t);
+#else
+  *np = 0;
+  return NULL;
+#endif
+}
