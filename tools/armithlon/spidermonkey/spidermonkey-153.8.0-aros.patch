+EXPORT_XPCOM_API(nsresult)
+NS_InvokeByIndex(nsISupports* that, uint32_t methodIndex, uint32_t paramCount,
+                 nsXPTCVariant* params) {
+  if (paramCount + 1 > QRX_XPTC_MAX_SLOTS) {
+    return NS_ERROR_NOT_IMPLEMENTED;
+  }
+  Slot s[QRX_XPTC_MAX_SLOTS];
+  memset(s, 0, sizeof s);
+  s[0] = (Slot)(uintptr_t)that;
+  for (uint32_t i = 0; i < paramCount; i++) {
+    s[i + 1] = SlotOf(params[i]);
+  }
+  void** vtable = *reinterpret_cast<void***>(that);
+  SlotFunc f = reinterpret_cast<SlotFunc>(vtable[methodIndex]);
+  return f(s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7], s[8], s[9], s[10],
+           s[11], s[12], s[13], s[14], s[15], s[16], s[17], s[18], s[19],
+           s[20], s[21], s[22], s[23], s[24], s[25], s[26], s[27], s[28],
+           s[29], s[30], s[31], s[32], s[33], s[34], s[35], s[36], s[37],
+           s[38], s[39], s[40], s[41], s[42], s[43], s[44], s[45], s[46],
+           s[47]);
+}
