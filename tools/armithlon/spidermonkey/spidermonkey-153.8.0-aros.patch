+// ---- QRX OS One 64: input from the Intuition windows (aros_window_glue.c, nsAppShell)
+
+// the widgets with an Intuition window, in the order they opened (popups last, on top)
+static nsTArray<HeadlessWidget*>* sQrxWindows;
+// the widget a press went to: it keeps the pointer until all buttons are up
+static HeadlessWidget* sQrxCapture;
+
+void HeadlessWidget::QrxOpenWindow() {
+  if (gfxPlatform::IsHeadless()) return;
+  bool popup = mWindowType == WindowType::Popup;
+  if (!popup && mWindowType != WindowType::TopLevel && mWindowType != WindowType::Dialog) return;
+  if (!popup) {
+    // a window as large as the screen (Gecko's first size, without a saved one) would hide the
+    // desktop: it opens at 1000 x 700 instead, set in from the top left; a size the user chose
+    // and Gecko saved is kept
+    int sw = 0, sh = 0;
+    qrx_win_screen_size(&sw, &sh);
+    if (sw > 400 && sh > 300 && (mBounds.width > sw - 120 || mBounds.height > sh - 120)) {
+      ResizeInternal(std::min(1000, sw - 160), std::min(700, sh - 160), false);
+      mBounds.MoveTo(60, 40);
+    }
+  }
+  LayoutDeviceIntPoint p = popup ? WidgetToScreenOffset() : mBounds.TopLeft();
+  mQrxWin = qrx_win_open(p.x, p.y, mBounds.width, mBounds.height,
+                         mQrxTitle.IsEmpty() ? "ThunderCat" : mQrxTitle.get(), popup, this);
+  if (!mQrxWin) return;
+  if (!sQrxWindows) {
+    sQrxWindows = new nsTArray<HeadlessWidget*>();
+  }
+  sQrxWindows->AppendElement(this);
+  if (!popup) {
+    // the window sits where Intuition put it (below the screen's bar, inside its border)
+    int x, y;
+    qrx_win_position(mQrxWin, &x, &y);
+    mQrxMoving = true;
+    MoveInternal(x, y);
+    mQrxMoving = false;
+  }
+}
+
+void HeadlessWidget::QrxForget(HeadlessWidget* aWidget) {
+  if (sQrxWindows) sQrxWindows->RemoveElement(aWidget);
+  if (sQrxCapture == aWidget) sQrxCapture = nullptr;
+  if (aWidget->mWindowType == WindowType::Popup) {
+    // Intuition activated the popup's window when it was clicked: the top-level window takes the
+    // keyboard again
+    nsIWidget* top = aWidget->GetTopLevelWidget();
+    if (top && top != aWidget) {
+      HeadlessWidget* t = static_cast<HeadlessWidget*>(top);
+      if (t->mQrxWin) qrx_win_front(t->mQrxWin);
+    }
+  }
+}
+
+static Modifiers QrxModifiers(unsigned aMods) {
+  Modifiers m = MODIFIER_NONE;
+  if (aMods & QRX_MOD_SHIFT) m |= MODIFIER_SHIFT;
+  if (aMods & QRX_MOD_CTRL) m |= MODIFIER_CONTROL;
+  if (aMods & QRX_MOD_ALT) m |= MODIFIER_ALT;
+  if (aMods & QRX_MOD_META) m |= MODIFIER_META;
+  if (aMods & QRX_MOD_CAPS) m |= MODIFIER_CAPSLOCK;
+  return m;
+}
+
+static int16_t QrxButtons(unsigned aButtons) {
+  int16_t b = 0;
+  if (aButtons & QRX_BTN_LEFT) b |= MouseButtonsFlag::ePrimaryFlag;
+  if (aButtons & QRX_BTN_RIGHT) b |= MouseButtonsFlag::eSecondaryFlag;
+  if (aButtons & QRX_BTN_MIDDLE) b |= MouseButtonsFlag::eMiddleFlag;
+  return b;
+}
+
+// a press outside the open popups closes them, as GTK's nsWindow::CheckForRollup does; true when
+// the press is used up by that
+static bool QrxRollup(const LayoutDeviceIntPoint& aScreenPoint, bool aWheel) {
+  nsIRollupListener* listener = nsIWidget::GetActiveRollupListener();
+  if (!listener) return false;
+  nsCOMPtr<nsIWidget> rollupWidget = listener->GetRollupWidget();
+  if (!rollupWidget) return false;
+  if (rollupWidget->GetScreenBounds().Contains(aScreenPoint)) return false;
+  bool consume = false;
+  if (aWheel) {
+    consume = listener->ShouldConsumeOnMouseWheelEvent();
+    if (!listener->ShouldRollupOnMouseWheelEvent()) return consume;
+  }
+  nsIRollupListener::RollupOptions options;
+  AutoTArray<nsIWidget*, 5> chain;
+  uint32_t sameTypeCount = listener->GetSubmenuWidgetChain(&chain);
+  for (uint32_t i = 0; i < chain.Length(); i++) {
+    if (chain[i]->GetScreenBounds().Contains(aScreenPoint)) {
+      if (i < sameTypeCount) return consume;
+      options.mCount = sameTypeCount;
+      break;
+    }
+  }
+  LayoutDeviceIntPoint point = aScreenPoint;
+  if (!aWheel) options.mPoint = &point;
+  if (listener->Rollup(options)) consume = true;
+  return consume;
+}
+
+// the widget under a point of the screen: the newest popup there, else a top-level window
+static HeadlessWidget* QrxWidgetAt(const LayoutDeviceIntPoint& aScreenPoint,
+                                   HeadlessWidget* aFallback) {
+  if (!sQrxWindows) return aFallback;
+  for (size_t i = sQrxWindows->Length(); i-- > 0;) {
+    HeadlessWidget* w = (*sQrxWindows)[i];
+    if (w->GetScreenBounds().Contains(aScreenPoint)) return w;
+  }
+  return aFallback;
+}
+
+void HeadlessWidget::QrxMouse(EventMessage aMsg, const ::qrx_input& aIn) {
+  WidgetMouseEvent event(true, aMsg, this, WidgetMouseEvent::eReal);
+  event.mRefPoint = LayoutDeviceIntPoint(aIn.x, aIn.y);
+  event.mModifiers = QrxModifiers(aIn.mods);
+  event.mButtons = QrxButtons(aIn.buttons);
+  if (aMsg != eMouseMove) {
+    event.mButton = aIn.button == 1   ? MouseButton::eSecondary
+                    : aIn.button == 2 ? MouseButton::eMiddle
+                                      : MouseButton::ePrimary;
+    event.mClickCount = mQrxClickCount;
+  }
+  event.AssignEventTime(WidgetEventTime());
+  DispatchInputEvent(&event);
+  if (aMsg == eMouseDown && aIn.button == 1 && !Destroyed()) {
+    WidgetPointerEvent contextMenu(true, eContextMenu, this);
+    contextMenu.mRefPoint = event.mRefPoint;
+    contextMenu.mModifiers = event.mModifiers;
+    contextMenu.mButton = MouseButton::eSecondary;
+    contextMenu.mButtons = event.mButtons;
+    contextMenu.mClickCount = 1;
+    contextMenu.AssignEventTime(WidgetEventTime());
+    DispatchInputEvent(&contextMenu);
+  }
+}
+
+// Amiga raw keys that are not characters
+static KeyNameIndex QrxKeyName(int aRaw) {
+  switch (aRaw) {
+    case 0x41: return KEY_NAME_INDEX_Backspace;
+    case 0x42: return KEY_NAME_INDEX_Tab;
+    case 0x43:
+    case 0x44: return KEY_NAME_INDEX_Enter;
+    case 0x45: return KEY_NAME_INDEX_Escape;
+    case 0x46: return KEY_NAME_INDEX_Delete;
+    case 0x47: return KEY_NAME_INDEX_Insert;
+    case 0x48: return KEY_NAME_INDEX_PageUp;
+    case 0x49: return KEY_NAME_INDEX_PageDown;
+    case 0x4C: return KEY_NAME_INDEX_ArrowUp;
+    case 0x4D: return KEY_NAME_INDEX_ArrowDown;
+    case 0x4E: return KEY_NAME_INDEX_ArrowRight;
+    case 0x4F: return KEY_NAME_INDEX_ArrowLeft;
+    case 0x50: return KEY_NAME_INDEX_F1;
+    case 0x51: return KEY_NAME_INDEX_F2;
+    case 0x52: return KEY_NAME_INDEX_F3;
+    case 0x53: return KEY_NAME_INDEX_F4;
+    case 0x54: return KEY_NAME_INDEX_F5;
+    case 0x55: return KEY_NAME_INDEX_F6;
+    case 0x56: return KEY_NAME_INDEX_F7;
+    case 0x57: return KEY_NAME_INDEX_F8;
+    case 0x58: return KEY_NAME_INDEX_F9;
+    case 0x59: return KEY_NAME_INDEX_F10;
+    case 0x4B: return KEY_NAME_INDEX_F11;
+    case 0x6F: return KEY_NAME_INDEX_F12;
+    case 0x5F: return KEY_NAME_INDEX_Help;
+    case 0x70: return KEY_NAME_INDEX_Home;
+    case 0x71: return KEY_NAME_INDEX_End;
+    default: return KEY_NAME_INDEX_USE_STRING;
+  }
+}
+
+void HeadlessWidget::QrxKey(const ::qrx_input& aIn) {
+  RefPtr<TextEventDispatcher> dispatcher = GetTextEventDispatcher();
+  if (!dispatcher || NS_FAILED(dispatcher->BeginNativeInputTransaction())) return;
+  WidgetKeyboardEvent event(true, aIn.down ? eKeyDown : eKeyUp, this);
+  event.mModifiers = QrxModifiers(aIn.mods);
+  KeyNameIndex name = QrxKeyName(aIn.rawkey);
+  if (name == KEY_NAME_INDEX_USE_STRING) {
+    unsigned ch = aIn.ch;
+    if (!ch) return;   // a dead key, or nothing on the keymap
+    event.mKeyNameIndex = KEY_NAME_INDEX_USE_STRING;
+    event.mKeyValue.Assign(char16_t(ch));
+    unsigned up = aIn.ch_plain >= 'a' && aIn.ch_plain <= 'z' ? aIn.ch_plain - 32 : aIn.ch_plain;
+    if (up >= 'A' && up <= 'Z') {
+      event.mKeyCode = dom::KeyboardEvent_Binding::DOM_VK_A + (up - 'A');
+    } else if (up >= '0' && up <= '9') {
+      event.mKeyCode = dom::KeyboardEvent_Binding::DOM_VK_0 + (up - '0');
+    } else if (up == ' ') {
+      event.mKeyCode = dom::KeyboardEvent_Binding::DOM_VK_SPACE;
+    }
+  } else {
+    event.mKeyNameIndex = name;
+    event.mKeyCode = WidgetKeyboardEvent::ComputeKeyCodeFromKeyNameIndex(name);
+  }
+  if (aIn.rawkey >= 0x0F && aIn.rawkey <= 0x5E &&
+      (aIn.rawkey == 0x0F || (aIn.rawkey >= 0x1D && aIn.rawkey <= 0x1F) ||
+       (aIn.rawkey >= 0x2D && aIn.rawkey <= 0x2F) || (aIn.rawkey >= 0x3C && aIn.rawkey <= 0x3F) ||
+       aIn.rawkey == 0x43 || aIn.rawkey == 0x4A || (aIn.rawkey >= 0x5A && aIn.rawkey <= 0x5E))) {
+    event.mLocation = dom::KeyboardEvent_Binding::DOM_KEY_LOCATION_NUMPAD;
+  }
+  event.AssignEventTime(WidgetEventTime());
+  nsEventStatus status = nsEventStatus_eIgnore;
+  if (!aIn.down) {
+    dispatcher->DispatchKeyboardEvent(eKeyUp, event, status);
+    return;
+  }
+  if (dispatcher->DispatchKeyboardEvent(eKeyDown, event, status)) {
+    dispatcher->MaybeDispatchKeypressEvents(event, status);
+  }
+}
+
+void HeadlessWidget::QrxInput(const ::qrx_input& aIn) {
+  RefPtr<HeadlessWidget> kungFuDeathGrip(this);
+  if (Destroyed()) return;
+  static const bool sLog = !!getenv("QRX_INPUT_LOG");
+  if (sLog) {
+    printf_stderr("QRXIN %p type %d x %d y %d button %d down %d steps %d raw %02x ch %u mods %x\n",
+                  this, aIn.type, aIn.x, aIn.y, aIn.button, aIn.down, aIn.steps, aIn.rawkey, aIn.ch,
+                  aIn.mods);
+  }
+  LayoutDeviceIntPoint screen = WidgetToScreenOffset() + LayoutDeviceIntPoint(aIn.x, aIn.y);
+  switch (aIn.type) {
+    case QRX_IN_MOVE:
+    case QRX_IN_BUTTON: {
+      // the window under the pointer gets it (Intuition reports the pointer to the active window
+      // wherever it is), the pressed one while a button is held
+      HeadlessWidget* target = sQrxCapture ? sQrxCapture : QrxWidgetAt(screen, this);
+      RefPtr<HeadlessWidget> t = target;
+      LayoutDeviceIntPoint local = screen - t->WidgetToScreenOffset();
+      ::qrx_input in = aIn;
+      in.x = local.x;
+      in.y = local.y;
+      if (aIn.type == QRX_IN_MOVE) {
+        t->QrxMouse(eMouseMove, in);
+        return;
+      }
+      if (aIn.down) {
+        if (QrxRollup(screen, false)) return;
+        // a second press of the same button soon at the same place: a double click
+        unsigned dt = (aIn.secs - t->mQrxClickSecs) * 1000u + aIn.micros / 1000u - t->mQrxClickMicros / 1000u;
+        if (aIn.button == t->mQrxClickButton && dt < 500u &&
+            std::abs(local.x - t->mQrxClickPoint.x) < 5 && std::abs(local.y - t->mQrxClickPoint.y) < 5) {
+          t->mQrxClickCount++;
+        } else {
+          t->mQrxClickCount = 1;
+        }
+        t->mQrxClickButton = aIn.button;
+        t->mQrxClickPoint = local;
+        t->mQrxClickSecs = aIn.secs;
+        t->mQrxClickMicros = aIn.micros;
