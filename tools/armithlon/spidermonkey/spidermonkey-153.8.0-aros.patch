+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Platform specific code to invoke XPCOM methods on native objects.
+ * QRX OS One 64 (m68k64 AROS, the ec64 LLVM backend): every argument goes on
+ * the stack in an 8-byte slot (integers below 64 bits extended, float and
+ * double as their bit patterns: soft-float), the caller removes them, the
+ * result (nsresult) comes back in d0. So the call is a plain C++ call through
+ * a function pointer with a fixed number of slots: a callee ignores the slots
+ * above its own parameters. Tested in the guest (spidermonkey/tests/xptcall). */
+
+#include "xptcprivate.h"
+#include <string.h>
+
+typedef uint64_t Slot;
+
+#define QRX_XPTC_MAX_SLOTS 48
+
+typedef nsresult (*SlotFunc)(
+    Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot,
+    Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot,
+    Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot,
+    Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot, Slot);
+
+static Slot SlotOf(const nsXPTCVariant& s) {
+  if (s.IsIndirect()) {
+    return (Slot)(uintptr_t)&s.val;
+  }
+  switch (s.type) {
+    case nsXPTType::T_I8:
+      return (Slot)(int64_t)s.val.i8;
+    case nsXPTType::T_I16:
+      return (Slot)(int64_t)s.val.i16;
+    case nsXPTType::T_I32:
+      return (Slot)(int64_t)s.val.i32;
+    case nsXPTType::T_I64:
+      return (Slot)s.val.i64;
+    case nsXPTType::T_U8:
+      return (Slot)s.val.u8;
+    case nsXPTType::T_U16:
+      return (Slot)s.val.u16;
+    case nsXPTType::T_U32:
+      return (Slot)s.val.u32;
+    case nsXPTType::T_U64:
+      return (Slot)s.val.u64;
+    case nsXPTType::T_BOOL:
+      return (Slot)(s.val.b ? 1 : 0);
+    case nsXPTType::T_CHAR:
+      return (Slot)(uint8_t)s.val.c;
+    case nsXPTType::T_WCHAR:
+      return (Slot)(uint16_t)s.val.wc;
+    case nsXPTType::T_FLOAT: {
+      uint32_t bits;
+      memcpy(&bits, &s.val.f, sizeof bits);
+      return (Slot)bits;
+    }
+    case nsXPTType::T_DOUBLE: {
+      Slot bits;
+      memcpy(&bits, &s.val.d, sizeof bits);
+      return bits;
+    }
+    default:
+      return (Slot)(uintptr_t)s.val.p;
+  }
+}
