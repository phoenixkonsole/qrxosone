+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/*
+ * QRX OS One 64 (AROS): the Exec side of nsAppShell. Kept in C and apart from Gecko's C++: AROS's
+ * exec headers define Wait(), Signal() and others as macros, which would clash with Gecko's own
+ * names. The main thread's task waits on one signal bit that any thread may set to tell it that
+ * Gecko events are pending (nsBaseAppShell::ScheduleNativeEventCallback).
+ */
+#include <proto/exec.h>
+#include <exec/tasks.h>
+#include <dos/dos.h>
+#include "aros_appshell_glue.h"
+
+static struct Task *main_task;
+static BYTE wake_bit = -1;
+static volatile ULONG extra_mask;      /* window ports later (nsWindow on Intuition) */
+
+int qrx_appshell_init(void)
+{
+    main_task = FindTask(NULL);
+    wake_bit = AllocSignal(-1);
+    return wake_bit >= 0 ? 0 : -1;
+}
+
+void qrx_appshell_shutdown(void)
+{
+    if (wake_bit >= 0) FreeSignal(wake_bit);
+    wake_bit = -1;
+}
+
+void qrx_appshell_wake(void)
+{
+    if (main_task && wake_bit >= 0) Signal(main_task, 1UL << wake_bit);
+}
+
+void qrx_appshell_add_wait_mask(unsigned long mask) { extra_mask |= mask; }
+
+unsigned qrx_appshell_wait(int may_wait)
+{
+    ULONG wake = wake_bit >= 0 ? 1UL << wake_bit : 0;
+    ULONG mask = wake | extra_mask | SIGBREAKF_CTRL_C;
+    ULONG got = may_wait ? Wait(mask) : SetSignal(0, mask) & mask;
+    unsigned r = 0;
+    if (got & wake) r |= QRX_APPSHELL_GECKO;
+    if (got & SIGBREAKF_CTRL_C) r |= QRX_APPSHELL_BREAK;
+    if (got & extra_mask) r |= QRX_APPSHELL_WINDOW;
+    return r;
+}
