+        t->QrxMouse(eMouseUp, in);
+      }
+      return;
+    }
+    case QRX_IN_WHEEL: {
+      if (QrxRollup(screen, true)) return;
+      RefPtr<HeadlessWidget> t = QrxWidgetAt(screen, this);
+      WidgetWheelEvent event(true, eWheel, t);
+      event.mRefPoint = screen - t->WidgetToScreenOffset();
+      event.mModifiers = QrxModifiers(aIn.mods);
+      event.mDeltaMode = dom::WheelEvent_Binding::DOM_DELTA_LINE;
+      event.mDeltaY = aIn.steps * 3;
+      event.mLineOrPageDeltaY = aIn.steps * 3;
+      event.AssignEventTime(WidgetEventTime());
+      t->DispatchInputEvent(&event);
+      return;
+    }
+    case QRX_IN_KEY: {
+      // keys are for the top-level window, also while Intuition has a popup's window active
+      nsIWidget* top = mWindowType == WindowType::Popup ? GetTopLevelWidget() : this;
+      RefPtr<HeadlessWidget> t = static_cast<HeadlessWidget*>(top ? top : this);
+      t->QrxKey(aIn);
+      return;
+    }
+    case QRX_IN_CLOSE:
+      if (mWidgetListener) mWidgetListener->RequestWindowClose(this);
+      return;
+    case QRX_IN_SIZE:
+      if (aIn.w != mBounds.width || aIn.h != mBounds.height) {
+        mQrxUserSized = true;
+        ResizeInternal(aIn.w, aIn.h, true);
+      }
+      return;
+    case QRX_IN_MOVED:
+      mQrxMoving = true;
+      MoveInternal(aIn.x, aIn.y);
+      if (aIn.w != mBounds.width || aIn.h != mBounds.height) {
+        mQrxUserSized = true;
+        ResizeInternal(aIn.w, aIn.h, true);
+      }
+      mQrxMoving = false;
+      return;
+    case QRX_IN_ACTIVE:
+      // the window's activation is Gecko's; a popup's window taking it from Intuition is not a
+      // deactivation of the browser
+      if (aIn.down && mWindowType != WindowType::Popup) RaiseWindow();
+      return;
+  }
+}
