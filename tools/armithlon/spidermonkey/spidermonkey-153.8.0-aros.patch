+/* AROS (QRX OS One 64): the md code of the RISC OS port, which also runs NSPR on pthreads with
+ * poll(). The number of processors comes from kernel.resource (KrnGetCPUCount, vector 40; its
+ * header is in AROS's private SDK). QRX OS One 64 has no processor.resource. */
+PRInt32 _MD_AROS_NumCPUs(void) {
+  APTR KernelBase = OpenResource("kernel.resource");
+  unsigned int n;
+  if (!KernelBase) return 1;
+  n = AROS_LC0(unsigned int, KrnGetCPUCount, APTR, KernelBase, 40, Kernel);
+  return n ? (PRInt32)n : 1;
+}
