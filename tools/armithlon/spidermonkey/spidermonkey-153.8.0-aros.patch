+++ b/widget/aros/aros_window_glue.c
@@ -0,0 +1,324 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/*
+ * QRX OS One 64 (AROS): the Intuition side of Gecko's windows. HeadlessWidget opens one of these
+ * for a top-level widget or a popup when Firefox is not headless; HeadlessCompositorWidget gives SWGL
+ * a pixel buffer and copies each finished frame here with cybergraphics' WritePixelArray. A window's
+ * semaphore over the list of open windows keeps the compositor's copy and the main thread's close
+ * apart: a copy goes only to a window still in the list.
+ *
+ * Input: all windows share one IDCMP port, made by and signalling Gecko's main thread; its signal is
+ * in the main thread's wait mask (aros_appshell_glue.c), and nsAppShell takes the messages with
+ * qrx_win_poll and hands them to the widget each window belongs to.
+ */
+#include <proto/exec.h>
+#include <proto/intuition.h>
+#include <proto/graphics.h>
+#include <proto/cybergraphics.h>
+#include <proto/keymap.h>
+#include <exec/memory.h>
+#include <exec/semaphores.h>
+#include <devices/inputevent.h>
+#include <intuition/intuition.h>
+#include <intuition/screens.h>
+#include <cybergraphx/cybergraphics.h>
+#include <string.h>
+#include "aros_window_glue.h"
+#include "aros_appshell_glue.h"
+
+struct IntuitionBase *IntuitionBase;
+struct GfxBase *GfxBase;
+struct Library *CyberGfxBase;
+struct Library *KeymapBase;
+
+struct qrx_win {
+    struct qrx_win *next;
+    struct Window *w;
+    struct SignalSemaphore lock;
+    void *owner;
+    int popup;
+    char title[128];
+};
+
+static struct MsgPort *port;    /* the windows' shared IDCMP port */
+static struct qrx_win *wins;    /* the open windows */
+static struct SignalSemaphore wins_lock;
+static int wins_lock_ready;
+
+#define TOP_IDCMP (IDCMP_MOUSEBUTTONS | IDCMP_MOUSEMOVE | IDCMP_RAWKEY | IDCMP_CLOSEWINDOW | \
+                   IDCMP_NEWSIZE | IDCMP_CHANGEWINDOW | IDCMP_ACTIVEWINDOW | IDCMP_INACTIVEWINDOW)
+#define POPUP_IDCMP (IDCMP_MOUSEBUTTONS | IDCMP_MOUSEMOVE | IDCMP_RAWKEY)
+
+static int open_libs(void)
+{
+    if (!IntuitionBase) IntuitionBase = (struct IntuitionBase *)OpenLibrary("intuition.library", 39);
+    if (!GfxBase) GfxBase = (struct GfxBase *)OpenLibrary("graphics.library", 39);
+    if (!CyberGfxBase) CyberGfxBase = OpenLibrary("cybergraphics.library", 40);
+    if (!KeymapBase) KeymapBase = OpenLibrary("keymap.library", 37);
+    if (!wins_lock_ready) { InitSemaphore(&wins_lock); wins_lock_ready = 1; }
+    if (!port && (port = CreateMsgPort()) != NULL) qrx_appshell_add_wait_mask(1UL << port->mp_SigBit);
+    return IntuitionBase && GfxBase && CyberGfxBase && port;
+}
+
+void qrx_win_screen_size(int *w, int *h)
+{
+    *w = *h = 0;
+    if (!open_libs()) return;
+    struct Screen *s = LockPubScreen(NULL);
+    if (!s) return;
+    *w = s->Width;
+    *h = s->Height;
+    UnlockPubScreen(NULL, s);
+}
+
+qrx_win *qrx_win_open(int x, int y, int w, int h, const char *title, int popup, void *owner)
+{
+    if (!open_libs()) return NULL;
+    qrx_win *q = AllocVec(sizeof *q, MEMF_ANY | MEMF_CLEAR);
+    if (!q) return NULL;
+    InitSemaphore(&q->lock);
+    q->owner = owner;
+    q->popup = popup;
+    strncpy(q->title, title ? title : "", sizeof q->title - 1);
+    struct Screen *s = LockPubScreen(NULL);
+    if (!s) { FreeVec(q); return NULL; }
+    if (w < 1) w = 1;
+    if (h < 1) h = 1;
+    if (popup) {
+        q->w = OpenWindowTags(NULL,
+                              WA_Left, x, WA_Top, y, WA_Width, w, WA_Height, h,
+                              WA_PubScreen, (IPTR)s, WA_Borderless, TRUE, WA_Activate, FALSE,
+                              WA_SmartRefresh, TRUE, WA_NoCareRefresh, TRUE, WA_RMBTrap, TRUE,
+                              WA_ReportMouse, TRUE, WA_IDCMP, 0, TAG_DONE);
+    } else {
+        /* x, y is the inside's top left: the border goes around it, and stays below the screen's bar */
+        int bl = s->WBorLeft, bt = s->WBorTop + s->Font->ta_YSize + 1;
+        x -= bl;
+        y -= bt;
+        if (x < 0) x = 0;
+        if (y < s->BarHeight + 1) y = s->BarHeight + 1;
+        q->w = OpenWindowTags(NULL,
+                              WA_Left, x, WA_Top, y, WA_InnerWidth, w, WA_InnerHeight, h,
+                              WA_Title, (IPTR)q->title, WA_PubScreen, (IPTR)s,
+                              WA_DragBar, TRUE, WA_DepthGadget, TRUE, WA_CloseGadget, TRUE, WA_SizeGadget, TRUE,
+                              WA_SmartRefresh, TRUE, WA_Activate, TRUE, WA_NoCareRefresh, TRUE,
+                              WA_RMBTrap, TRUE, WA_ReportMouse, TRUE,
+                              WA_MinWidth, 200, WA_MinHeight, 120, WA_MaxWidth, -1, WA_MaxHeight, -1,
+                              WA_IDCMP, 0, TAG_DONE);
+    }
+    UnlockPubScreen(NULL, s);
+    if (!q->w) { FreeVec(q); return NULL; }
+    q->w->UserPort = port;
+    q->w->UserData = (APTR)q;
+    ModifyIDCMP(q->w, popup ? POPUP_IDCMP : TOP_IDCMP);
+    ObtainSemaphore(&wins_lock);
+    q->next = wins;
+    wins = q;
+    ReleaseSemaphore(&wins_lock);
+    return q;
+}
+
+void qrx_win_close(qrx_win *q)
+{
+    if (!q) return;
+    ObtainSemaphore(&wins_lock);
+    for (struct qrx_win **p = &wins; *p; p = &(*p)->next)
+        if (*p == q) { *p = q->next; break; }
+    ReleaseSemaphore(&wins_lock);
+    ObtainSemaphore(&q->lock);
+    if (q->w) {
+        /* the shared port: take this window's messages back before it closes */
+        Forbid();
+        struct Node *n = port->mp_MsgList.lh_Head, *next;
+        for (; (next = n->ln_Succ) != NULL; n = next) {
+            struct IntuiMessage *m = (struct IntuiMessage *)n;
+            if (m->IDCMPWindow == q->w) { Remove(n); ReplyMsg(&m->ExecMessage); }
+        }
+        q->w->UserPort = NULL;
+        ModifyIDCMP(q->w, 0);
+        Permit();
+        CloseWindow(q->w);
+    }
+    q->w = NULL;
+    ReleaseSemaphore(&q->lock);
+    FreeVec(q);
+}
+
+void qrx_win_title(qrx_win *q, const char *title)
+{
+    if (!q || !q->w || q->popup) return;
+    ObtainSemaphore(&q->lock);
+    strncpy(q->title, title ? title : "", sizeof q->title - 1);
+    SetWindowTitles(q->w, q->title, (CONST_STRPTR)~0);
+    ReleaseSemaphore(&q->lock);
+}
+
+void qrx_win_size(qrx_win *q, int w, int h)
+{
+    if (!q || !q->w) return;
+    ObtainSemaphore(&q->lock);
+    struct Window *win = q->w;
+    int ow = win->Width - win->BorderLeft - win->BorderRight, oh = win->Height - win->BorderTop - win->BorderBottom;
+    if (w < 1) w = 1;
+    if (h < 1) h = 1;
+    if (ow != w || oh != h) SizeWindow(win, w - ow, h - oh);
+    ReleaseSemaphore(&q->lock);
+}
+
+void qrx_win_move(qrx_win *q, int x, int y)
+{
+    if (!q || !q->w) return;
+    struct Window *win = q->w;
+    int dx = x - (win->LeftEdge + win->BorderLeft), dy = y - (win->TopEdge + win->BorderTop);
+    if (dx || dy) MoveWindow(win, dx, dy);
+}
+
+void qrx_win_position(qrx_win *q, int *x, int *y)
+{
+    *x = *y = 0;
+    if (!q || !q->w) return;
+    *x = q->w->LeftEdge + q->w->BorderLeft;
+    *y = q->w->TopEdge + q->w->BorderTop;
+}
+
+void qrx_win_front(qrx_win *q)
+{
+    if (!q || !q->w) return;
+    WindowToFront(q->w);
+    if (!q->popup) ActivateWindow(q->w);
+}
+
+void qrx_win_blit(qrx_win *q, const void *pixels, int stride, int x, int y, int w, int h)
+{
+    if (!q || !wins_lock_ready) return;
+    /* the compositor's thread may still hold a window the main thread closed */
+    ObtainSemaphore(&wins_lock);
+    struct qrx_win *o = wins;
+    while (o && o != q) o = o->next;
+    if (!o) { ReleaseSemaphore(&wins_lock); return; }
+    ObtainSemaphore(&q->lock);
+    struct Window *win = q->w;
+    if (win && w > 0 && h > 0) {
+        int iw = win->Width - win->BorderLeft - win->BorderRight, ih = win->Height - win->BorderTop - win->BorderBottom;
+        if (x + w > iw) w = iw - x;
+        if (y + h > ih) h = ih - y;
+        if (w > 0 && h > 0)
+            WritePixelArray((APTR)pixels, x, y, stride, win->RPort, win->BorderLeft + x, win->BorderTop + y, w, h, RECTFMT_BGRA32);
+    }
+    ReleaseSemaphore(&q->lock);
+    ReleaseSemaphore(&wins_lock);
+}
+
+static unsigned mods_of(UWORD q)
+{
+    unsigned m = 0;
+    if (q & (IEQUALIFIER_LSHIFT | IEQUALIFIER_RSHIFT)) m |= QRX_MOD_SHIFT;
+    if (q & IEQUALIFIER_CONTROL) m |= QRX_MOD_CTRL;
+    if (q & (IEQUALIFIER_LALT | IEQUALIFIER_RALT)) m |= QRX_MOD_ALT;
+    if (q & (IEQUALIFIER_LCOMMAND | IEQUALIFIER_RCOMMAND)) m |= QRX_MOD_META;
+    if (q & IEQUALIFIER_CAPSLOCK) m |= QRX_MOD_CAPS;
+    return m;
+}
+
+static unsigned buttons_of(UWORD q)
+{
+    unsigned b = 0;
+    if (q & IEQUALIFIER_LEFTBUTTON) b |= QRX_BTN_LEFT;
+    if (q & IEQUALIFIER_RBUTTON) b |= QRX_BTN_RIGHT;
+    if (q & IEQUALIFIER_MIDBUTTON) b |= QRX_BTN_MIDDLE;
+    return b;
+}
+
+/* the character a raw key gives with these qualifiers (the keymap's, with dead keys), 0 for none */
+static unsigned char_of(struct IntuiMessage *m, UWORD qual)
+{
+    struct InputEvent ie;
+    UBYTE buf[8];
+    if (!KeymapBase) return 0;
+    memset(&ie, 0, sizeof ie);
+    ie.ie_Class = IECLASS_RAWKEY;
+    ie.ie_Code = m->Code & 0x7f;
+    ie.ie_Qualifier = qual;
+    ie.ie_EventAddress = m->IAddress ? *(APTR *)m->IAddress : NULL;
+    LONG n = MapRawKey(&ie, (STRPTR)buf, sizeof buf, NULL);
+    return n == 1 ? buf[0] : 0;
+}
+
+int qrx_win_poll(qrx_input *in)
+{
+    struct IntuiMessage *m;
+    if (!port) return 0;
+    while ((m = (struct IntuiMessage *)GetMsg(port)) != NULL) {
+        struct Window *w = m->IDCMPWindow;
+        qrx_win *q = (qrx_win *)w->UserData;
+        ULONG cls = m->Class;
+        UWORD code = m->Code, qual = m->Qualifier;
+        memset(in, 0, sizeof *in);
+        in->owner = q ? q->owner : NULL;
+        in->x = m->MouseX - w->BorderLeft;
+        in->y = m->MouseY - w->BorderTop;
+        in->mods = mods_of(qual);
+        in->buttons = buttons_of(qual);
+        in->secs = (unsigned)m->Seconds;
+        in->micros = (unsigned)m->Micros;
+        int keep = 1;
+        switch (cls) {
+        case IDCMP_MOUSEMOVE: {
+            /* only the last of a run of moves */
+            struct Node *n = port->mp_MsgList.lh_Head;
+            if (n->ln_Succ && ((struct IntuiMessage *)n)->Class == IDCMP_MOUSEMOVE &&
+                ((struct IntuiMessage *)n)->IDCMPWindow == w) keep = 0;
+            in->type = QRX_IN_MOVE;
+            break;
+        }
+        case IDCMP_MOUSEBUTTONS:
+            in->type = QRX_IN_BUTTON;
+            in->down = !(code & IECODE_UP_PREFIX);
+            switch (code & ~IECODE_UP_PREFIX) {
+            case IECODE_LBUTTON: in->button = 0; break;
+            case IECODE_RBUTTON: in->button = 1; break;
+            case IECODE_MBUTTON: in->button = 2; break;
+            default: keep = 0;
+            }
+            break;
+        case IDCMP_RAWKEY:
+            if (code == 0x7A || code == 0x7B) {          /* NM_WHEEL_UP, NM_WHEEL_DOWN */
+                in->type = QRX_IN_WHEEL;
+                in->steps = code == 0x7A ? -1 : 1;
+                break;
+            }
+            if ((code & 0x7f) >= 0x60 && (code & 0x7f) <= 0x67) { keep = 0; break; }   /* qualifier keys */
+            if ((code & 0x7f) >= 0x78) { keep = 0; break; }   /* other mouse and wheel codes */
+            in->type = QRX_IN_KEY;
+            in->rawkey = code & 0x7f;
+            in->down = !(code & IECODE_UP_PREFIX);
+            in->ch = char_of(m, qual & ~(IEQUALIFIER_CONTROL | IEQUALIFIER_LALT | IEQUALIFIER_LCOMMAND | IEQUALIFIER_RCOMMAND));
+            in->ch_plain = char_of(m, qual & (IEQUALIFIER_LSHIFT | IEQUALIFIER_RSHIFT | IEQUALIFIER_CAPSLOCK));
+            /* Ctrl and the left Alt give the plain letter (shortcuts, menu access keys, as on other
+             * systems); the right Alt keeps the keymap's character, like AltGr */
+            if (qual & (IEQUALIFIER_CONTROL | IEQUALIFIER_LALT)) in->ch = in->ch_plain;
+            break;
+        case IDCMP_CLOSEWINDOW: in->type = QRX_IN_CLOSE; break;
+        case IDCMP_NEWSIZE:
+            in->type = QRX_IN_SIZE;
+            in->w = w->Width - w->BorderLeft - w->BorderRight;
+            in->h = w->Height - w->BorderTop - w->BorderBottom;
+            break;
+        case IDCMP_CHANGEWINDOW:
+            in->type = QRX_IN_MOVED;
+            in->x = w->LeftEdge + w->BorderLeft;
+            in->y = w->TopEdge + w->BorderTop;
+            in->w = w->Width - w->BorderLeft - w->BorderRight;
+            in->h = w->Height - w->BorderTop - w->BorderBottom;
+            break;
+        case IDCMP_ACTIVEWINDOW: in->type = QRX_IN_ACTIVE; in->down = 1; break;
+        case IDCMP_INACTIVEWINDOW: in->type = QRX_IN_ACTIVE; in->down = 0; break;
+        default: keep = 0;
+        }
+        ReplyMsg(&m->ExecMessage);
+        if (keep && in->owner) return 1;
+    }
+    return 0;
+}
