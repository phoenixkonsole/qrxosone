+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* QRX OS One 64 (AROS): Intuition windows for Gecko's top-level widgets and popups
+ * (aros_window_glue.c). Kept in C, apart from Gecko's C++, for the same reason as
+ * aros_appshell_glue.c. All of it runs on Gecko's main thread except qrx_win_blit. */
+#ifndef aros_window_glue_h
+#define aros_window_glue_h
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct qrx_win qrx_win;
+
+/* a window on the default public screen (QRX OS One's desktop): inner size w x h with its inner
+ * top left at x, y on the screen. A popup (menus, lists, tooltips) has no border and is not
+ * activated. owner: what qrx_win_poll hands back for this window's input (the widget). */
+qrx_win* qrx_win_open(int x, int y, int w, int h, const char* title, int popup, void* owner);
+void qrx_win_close(qrx_win* win);
+void qrx_win_title(qrx_win* win, const char* title);
+void qrx_win_size(qrx_win* win, int w, int h);
+void qrx_win_move(qrx_win* win, int x, int y);       /* inner top left on the screen */
+void qrx_win_position(qrx_win* win, int* x, int* y); /* the same, as the window is now */
+void qrx_win_front(qrx_win* win);                    /* to the front */
+/* pixels: the whole buffer, 32-bit B, G, R, A in memory order (what SWGL writes), stride bytes per row;
+ * the rectangle x, y, w, h of them to the same place inside the window. From any thread. */
+void qrx_win_blit(qrx_win* win, const void* pixels, int stride, int x, int y, int w, int h);
+/* the default public screen's size, 0 when there is none */
+void qrx_win_screen_size(int* w, int* h);
+
+/* input from the windows' IDCMP ports, for the main thread's event loop (nsAppShell) */
+enum {
+  QRX_IN_MOVE = 1, /* the pointer moved: x, y inside the window */
+  QRX_IN_BUTTON,   /* button 0 left, 1 right, 2 middle; down 1 or 0; x, y */
+  QRX_IN_WHEEL,    /* steps, positive towards the user (the page moves up); x, y */
+  QRX_IN_KEY,      /* rawkey (Amiga raw key without the up bit), down, ch (the character, Latin-1,
+                      0 for none) and ch_plain (the same without Ctrl and Alt) */
+  QRX_IN_CLOSE,    /* the close gadget */
+  QRX_IN_SIZE,     /* new inner size w, h */
+  QRX_IN_MOVED,    /* the window moved: inner top left x, y on the screen */
+  QRX_IN_ACTIVE    /* the window became active (down 1) or inactive (0) */
+};
+#define QRX_MOD_SHIFT 1u
+#define QRX_MOD_CTRL 2u
+#define QRX_MOD_ALT 4u
+#define QRX_MOD_META 8u /* the Amiga keys */
+#define QRX_MOD_CAPS 16u
+#define QRX_BTN_LEFT 1u /* buttons held */
+#define QRX_BTN_RIGHT 2u
+#define QRX_BTN_MIDDLE 4u
+typedef struct qrx_input {
+  void* owner;
+  int type;
+  int x, y, w, h;
+  int button, down, steps;
+  int rawkey;
+  unsigned ch, ch_plain;
+  unsigned mods, buttons;
+  unsigned secs, micros; /* Intuition's time of the event */
+} qrx_input;
+/* the next input of any window, 1 when there was one; mouse moves come merged */
+int qrx_win_poll(qrx_input* in);
+#ifdef __cplusplus
+}
+#endif
+#endif
