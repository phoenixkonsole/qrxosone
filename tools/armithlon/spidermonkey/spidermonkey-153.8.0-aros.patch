+
+nsresult nsAppShell::Init() {
+  if (qrx_appshell_init()) return NS_ERROR_FAILURE;
+  hal::Init();
+  if (XRE_IsParentProcess()) {
+    /* the screen: the headless helper, given the size of the public screen the windows open on */
+    int w = 0, h = 0;
+    if (!gfxPlatform::IsHeadless()) qrx_win_screen_size(&w, &h);
+    if (w > 0 && h > 0 && !getenv("MOZ_HEADLESS_WIDTH")) {
+      char v[16];
+      snprintf(v, sizeof v, "%d", w);
+      setenv("MOZ_HEADLESS_WIDTH", v, 1);
+      snprintf(v, sizeof v, "%d", h);
+      setenv("MOZ_HEADLESS_HEIGHT", v, 1);
+    }
+    ScreenManager::GetSingleton().SetHelper(MakeUnique<HeadlessScreenHelper>());
+  }
+  return nsBaseAppShell::Init();
+}
+
+nsAppShell::~nsAppShell() {
+  hal::Shutdown();
+  qrx_appshell_shutdown();
+}
+
+void nsAppShell::ScheduleNativeEventCallback() { qrx_appshell_wake(); }
+
+bool nsAppShell::ProcessNextNativeEvent(bool aMayWait) {
+  unsigned got = qrx_appshell_wait(aMayWait);
+  if (got & QRX_APPSHELL_BREAK) {
+    /* Ctrl-C as on any AROS program: quit the application */
+    nsCOMPtr<nsIAppStartup> appStartup = do_GetService("@mozilla.org/toolkit/app-startup;1");
+    if (appStartup) {
+      bool userAllowedQuit = true;
+      appStartup->Quit(nsIAppStartup::eAttemptQuit, 0, &userAllowedQuit);
+    }
+  }
+  if (got & QRX_APPSHELL_WINDOW) {
+    /* mouse, keyboard and window changes of the Intuition windows, to their widgets */
+    ::qrx_input in;
+    while (qrx_win_poll(&in)) QrxWindowInput(in);
+  }
+  if (got & QRX_APPSHELL_GECKO) {
+    NativeEventCallback();
+    return true;
+  }
+  return got != 0;
+}
