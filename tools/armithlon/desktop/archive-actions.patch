+/* ZIP / 7z / LHA(LZH) / RAR right-click support: unpack archives here,
+ * pack files and drawers. RAR packing needs the commercial rar tool, so
+ * only unpack is offered for .rar. External tools (UnZip, 7z, Lha, UnRAR,
+ * Zip) must be reachable via the AmigaDOS path; missing tools report via
+ * the terminal capture instead of failing silently. */
+enum { QRX_ARCH_NONE = 0, QRX_ARCH_ZIP, QRX_ARCH_7Z, QRX_ARCH_LHA, QRX_ARCH_RAR, QRX_ARCH_SIT, QRX_ARCH_IMAGE };
+enum { QRX_IMAGE_NONE = 0, QRX_IMAGE_ISO, QRX_IMAGE_HFS };
+static int qrx_archive_kind(const char *name) {
+    if (!name) return QRX_ARCH_NONE;
+    if (qrx_ci_ends(name, ".zip")) return QRX_ARCH_ZIP;
+    if (qrx_ci_ends(name, ".7z")) return QRX_ARCH_7Z;
+    if (qrx_ci_ends(name, ".lha") || qrx_ci_ends(name, ".lzh")) return QRX_ARCH_LHA;
+    if (qrx_ci_ends(name, ".rar")) return QRX_ARCH_RAR;
+    if (qrx_ci_ends(name, ".sit")) return QRX_ARCH_SIT;
+    if (qrx_ci_ends(name, ".iso") || qrx_ci_ends(name, ".dmg") ||
+        qrx_ci_ends(name, ".img") || qrx_ci_ends(name, ".dsk"))
+        return QRX_ARCH_IMAGE;
+    return QRX_ARCH_NONE;
+}
+static int qrx_image_kind(const char *name) {
+    if (!name) return QRX_IMAGE_NONE;
+    if (qrx_ci_ends(name, ".iso")) return QRX_IMAGE_ISO;
+    if (qrx_ci_ends(name, ".dmg") || qrx_ci_ends(name, ".img") ||
+        qrx_ci_ends(name, ".dsk")) return QRX_IMAGE_HFS;
+    return QRX_IMAGE_NONE;
+}
+static const char *qrx_image_device(const char *name) {
+    return qrx_image_kind(name) == QRX_IMAGE_ISO ? "ICD0:" : "HFS0:";
+}
+static int qrx_image_unit(const char *name) {
+    return qrx_image_kind(name) == QRX_IMAGE_ISO ? 4 : 0;
+}
+static void qrx_image_mount(int index) {
+    struct QRXFileEntry *e;
+    char full[FILE_PATH_LEN + 128];
+    char command[FILE_PATH_LEN + 256];
+    const char *device;
+    if (index < 0 || index >= g_file_count) return;
+    e = &g_file_entries[index];
+    if (e->dir_type > 0 || qrx_image_kind(e->name) == QRX_IMAGE_NONE) return;
+    qrx_join_path(full, sizeof(full), g_files_path, e->name);
+    device = qrx_image_device(e->name);
+    snprintf(command, sizeof(command), "Mount %s >NIL:", device);
+    execute_capture(command);
+    snprintf(command, sizeof(command), "C:QRXMountImage %d \"%s\"", qrx_image_unit(e->name), full);
+    if (!execute_capture(command)) {
+        qrx_set_status("Image: native diskimage insert failed.");
+        return;
+    }
+    snprintf(command, sizeof(command), "Mount %s", device);
+    execute_capture(command);
+    {
+        BPTR volume = Lock((STRPTR)device, ACCESS_READ);
+        if (volume) {
+            UnLock(volume);
+            qrx_set_status("Image mounted. Open the new volume in QRX Drive.");
+        } else {
+            qrx_set_status("Image inserted, but no readable HFS/HFS+ volume appeared.");
+        }
+    }
+}
+static void qrx_image_eject(int index) {
+    struct QRXFileEntry *e;
+    char command[FILE_PATH_LEN + 192];
+    const char *device;
+    if (index < 0 || index >= g_file_count) return;
+    e = &g_file_entries[index];
+    if (qrx_image_kind(e->name) == QRX_IMAGE_NONE) return;
+    device = qrx_image_device(e->name);
+    snprintf(command, sizeof(command), "C:QRXMountImage %d --eject", qrx_image_unit(e->name));
+    if (execute_capture(command))
+        qrx_set_status("Image ejected.");
+    else
+        qrx_set_status("Image: eject failed or no image is mounted.");
+}
+static LONG qrx_run_in_dir(const char *dir, const char *cmd) {
+    BPTR lock, old;
+    LONG rc;
+    if (!dir || !*dir || !cmd) return 0;
+    lock = Lock((STRPTR)dir, ACCESS_READ);
+    if (!lock) { qrx_set_status("Archive: cannot lock drawer."); return 0; }
+    old = CurrentDir(lock);
+    rc = execute_capture(cmd);
+    CurrentDir(old);
+    UnLock(lock);
+    return rc;
+}
+static void qrx_archive_unpack(int index) {
+    struct QRXFileEntry *e;
+    char full[FILE_PATH_LEN + 128];
+    char command[FILE_PATH_LEN + 256];
+    int kind;
+    if (index < 0 || index >= g_file_count) return;
+    e = &g_file_entries[index];
+    if (e->dir_type > 0) { qrx_set_status("Archive: drawers cannot be unpacked."); return; }
+    kind = qrx_archive_kind(e->name);
+    if (kind == QRX_ARCH_NONE) { qrx_set_status("Archive: not a .zip/.7z/.lha/.rar/.sit file."); return; }
+    if (kind == QRX_ARCH_IMAGE) { qrx_set_status("Image: use Mount image."); return; }
+    qrx_join_path(full, sizeof(full), g_files_path, e->name);
+    if (kind == QRX_ARCH_SIT)
+        snprintf(command, sizeof(command), "xadUnFile \"%s\" DEST \"%s\" OW QUIET", full, g_files_path);
+    else if (kind == QRX_ARCH_ZIP)
+        snprintf(command, sizeof(command), "UnZip -o \"%s\" -d \"%s\"", full, g_files_path);
+    else if (kind == QRX_ARCH_7Z)
+        snprintf(command, sizeof(command), "7z x \"%s\" -o\"%s\"", full, g_files_path);
+    else if (kind == QRX_ARCH_LHA)
+        snprintf(command, sizeof(command), "Lha x \"%s\" \"%s/\"", full, g_files_path);
+    else
+        snprintf(command, sizeof(command), "UnRAR x \"%s\" \"%s/\"", full, g_files_path);
+    if (qrx_run_in_dir(g_files_path, command)) {
+        qrx_load_directory(g_files_path);
+        qrx_set_status("Archive unpacked. Refresh shows new objects.");
+    } else {
+        qrx_set_status(kind == QRX_ARCH_ZIP ? "Archive: needs UnZip in the command path."
+                     : kind == QRX_ARCH_7Z ? "Archive: needs 7z in the command path."
+                     : kind == QRX_ARCH_LHA ? "Archive: needs Lha in the command path."
+                     : kind == QRX_ARCH_SIT ? "Archive: needs xadUnFile and xadmaster.library."
+                     : "Archive: needs UnRAR in the command path.");
+    }
+}
+static void qrx_archive_pack(int index, int kind) {
+    struct QRXFileEntry *e;
+    char target[FILE_PATH_LEN + 128];
+    char command[FILE_PATH_LEN + 256];
+    const char *ext;
+    if (index < 0 || index >= g_file_count) return;
+    e = &g_file_entries[index];
+    ext = kind == QRX_ARCH_ZIP ? "zip" : kind == QRX_ARCH_LHA ? "lha" : "7z";
+    snprintf(target, sizeof(target), "%s.%s", e->name, ext);
+    if (qrx_ci_ends(e->name, ".zip") || qrx_ci_ends(e->name, ".7z") ||
+        qrx_ci_ends(e->name, ".lha") || qrx_ci_ends(e->name, ".lzh") ||
+        qrx_ci_ends(e->name, ".rar") || qrx_ci_ends(e->name, ".sit") ||
+        qrx_image_kind(e->name) != QRX_IMAGE_NONE) {
+        qrx_set_status("Archive: packing an archive or image again is refused.");
+        return;
+    }
+    if (kind == QRX_ARCH_ZIP)
+        snprintf(command, sizeof(command), "Zip -r \"%s\" \"%s\"", target, e->name);
+    else if (kind == QRX_ARCH_LHA)
+        snprintf(command, sizeof(command), "Lha a \"%s\" \"%s\"", target, e->name);
+    else
+        snprintf(command, sizeof(command), "7z a \"%s\" \"%s\"", target, e->name);
+    if (qrx_run_in_dir(g_files_path, command)) {
+        qrx_load_directory(g_files_path);
+        qrx_set_status("Archive packed.");
+    } else {
+        qrx_set_status(kind == QRX_ARCH_ZIP ? "Archive: needs Zip in the command path."
+                     : kind == QRX_ARCH_LHA ? "Archive: needs Lha in the command path."
+                     : "Archive: needs 7z in the command path.");
+    }
 }
+#define QRX_ARCH_ROW_H 20
+#define QRX_ARCH_MENU_W 150
+static int qrx_archive_item_count(int index) {
+    if (index < 0 || index >= g_file_count) return 0;
+    return qrx_archive_kind(g_file_entries[index].name) != QRX_ARCH_NONE ? 2 : 4;
+}
+static const char *qrx_archive_item_label(int index, int row) {
+    if (index < 0 || index >= g_file_count) return "";
+    if (qrx_archive_kind(g_file_entries[index].name) == QRX_ARCH_IMAGE)
+        return row == 0 ? "Mount image" : "Eject image";
+    if (qrx_archive_kind(g_file_entries[index].name) != QRX_ARCH_NONE)
+        return row == 0 ? "Unpack here" : "Cancel";
+    if (row == 0) return "Pack as .zip";
+    if (row == 1) return "Pack as .lha";
+    if (row == 2) return "Pack as .7z";
+    return "Cancel";
+}
+static void qrx_draw_archive_menu(struct RastPort *rp) {
+    WORD x, y, w, h;
+    int i, n;
+    if (!g_archive_menu || !g_files) return;
+    if (g_archive_index < 0 || g_archive_index >= g_file_count) return;
+    n = qrx_archive_item_count(g_archive_index);
+    if (!n) return;
+    x = g_archive_x; y = g_archive_y;
+    w = QRX_ARCH_MENU_W; h = (WORD)(n * QRX_ARCH_ROW_H + 8);
+    if (x + w > g_files->Width - 4) x = g_files->Width - 4 - w;
+    if (y + h > g_files->Height - 4) y = g_files->Height - 4 - h;
+    if (x < 4) x = 4;
+    if (y < 30) y = 30;
+    fill(rp, PEN_PANEL, x, y, x + w, y + h);
+    outline(rp, PEN_EDGE, x, y, x + w, y + h);
+    for (i = 0; i < n; ++i) {
+        WORD ry = (WORD)(y + 4 + i * QRX_ARCH_ROW_H);
+        if (i == n - 1)
+            fill(rp, PEN_BUTTON, x + 4, ry, x + w - 4, ry + QRX_ARCH_ROW_H - 2);
+        else
+            fill(rp, PEN_ACCENT, x + 4, ry, x + w - 4, ry + QRX_ARCH_ROW_H - 2);
+        text_at(rp, i == n - 1 ? PEN_TEXT : PEN_BLACK, x + 12, ry + 14,
+                qrx_archive_item_label(g_archive_index, i));
+    }
+}
+static void qrx_archive_menu_click(WORD x, WORD y) {
+    WORD mx, my, w, h;
+    int i, n, row;
+    if (!g_archive_menu || !g_files) return;
+    n = qrx_archive_item_count(g_archive_index);
+    if (!n) { g_archive_menu = 0; g_archive_index = -1; redraw_filemanager(); return; }
+    mx = g_archive_x; my = g_archive_y;
+    w = QRX_ARCH_MENU_W; h = (WORD)(n * QRX_ARCH_ROW_H + 8);
+    if (mx + w > g_files->Width - 4) mx = g_files->Width - 4 - w;
+    if (my + h > g_files->Height - 4) my = g_files->Height - 4 - h;
+    if (mx < 4) mx = 4;
+    if (my < 30) my = 30;
+    row = -1;
+    if (x >= mx + 4 && x <= mx + w - 4 && y >= my + 4 && y <= my + 4 + n * QRX_ARCH_ROW_H)
+        row = (y - (my + 4)) / QRX_ARCH_ROW_H;
+    if (row < 0 || row >= n) {
+        g_archive_menu = 0; g_archive_index = -1;
+        qrx_set_status("");
+        redraw_filemanager();
+        return;
+    }
+    i = g_archive_index;
+    g_archive_menu = 0; g_archive_index = -1;
+    if (qrx_archive_kind(g_file_entries[i].name) == QRX_ARCH_IMAGE) {
+        if (row == 0) qrx_image_mount(i);
+        else qrx_image_eject(i);
+    } else if (qrx_archive_kind(g_file_entries[i].name) != QRX_ARCH_NONE) {
+        if (row == 0) qrx_archive_unpack(i);
+    } else {
+        if (row == 0) qrx_archive_pack(i, QRX_ARCH_ZIP);
+        else if (row == 1) qrx_archive_pack(i, QRX_ARCH_LHA);
+        else if (row == 2) qrx_archive_pack(i, QRX_ARCH_7Z);
+    }
+    redraw_filemanager();
+}
 
