# Cross toolchain for Blender 2.79b on QRX OS One. UNIX path of Blender's CMake, no Linux in the build.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR m68k)
set(CMAKE_C_COMPILER ${CMAKE_CURRENT_LIST_DIR}/aros_cc.py)
set(CMAKE_CXX_COMPILER ${CMAKE_CURRENT_LIST_DIR}/aros-c++)
# configure.sh exports these from qrxenv.py (toolchain.json)
set(CMAKE_AR $ENV{QRX_XAR} CACHE FILEPATH "")
set(CMAKE_RANLIB $ENV{QRX_XRANLIB} CACHE FILEPATH "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_CROSSCOMPILING_EMULATOR ${CMAKE_CURRENT_LIST_DIR}/run_tool.py)
set(SDK $ENV{QRX_SDK_DEV})
set(CMAKE_FIND_ROOT_PATH ${SDK})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_INCLUDE_PATH ${SDK}/include)
set(CMAKE_LIBRARY_PATH ${SDK}/lib)
