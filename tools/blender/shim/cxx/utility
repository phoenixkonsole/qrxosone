#ifndef QRX_UTILITY
#define QRX_UTILITY
namespace std {
template<class A, class B> struct pair {
	A first; B second;
	pair() : first(), second() {}
	pair(const A &a, const B &b) : first(a), second(b) {}
	bool operator<(const pair &o) const { return first < o.first || (!(o.first < first) && second < o.second); }
};
template<class A, class B> inline pair<A, B> make_pair(A a, B b) { return pair<A, B>(a, b); }
}
#endif
