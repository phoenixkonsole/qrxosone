/* The little of <algorithm> the Blender Internal ray tracer and physics use: no libstdc++ in this SDK. */
#ifndef QRX_ALGORITHM
#define QRX_ALGORITHM
#include <utility>
#include <stdlib.h>
#include <stddef.h>
namespace std {
template<class T> inline const T &min(const T &a, const T &b) { return b < a ? b : a; }
template<class T> inline const T &max(const T &a, const T &b) { return a < b ? b : a; }
template<class T> inline void swap(T &a, T &b) { T t = a; a = b; b = t; }
template<class It, class Cmp> void __insertion(It f, It l, Cmp c) {
	for (It i = f; i != l; ++i) { auto v = *i; It j = i; while (j != f && c(v, *(j - 1))) { *j = *(j - 1); --j; } *j = v; }
}
template<class It, class Cmp> void sort(It f, It l, Cmp c) {
	while (l - f > 16) {
		auto p = *(f + (l - f) / 2); It i = f, j = l - 1;
		while (i <= j) { while (c(*i, p)) ++i; while (c(p, *j)) --j; if (i <= j) { swap(*i, *j); ++i; --j; } }
		if (j - f < l - i) { sort(f, j + 1, c); f = i; } else { sort(i, l, c); l = j + 1; }
	}
	__insertion(f, l, c);
}
template<class It> void sort(It f, It l) { auto c = [](decltype(*f) a, decltype(*f) b) { return a < b; }; sort(f, l, c); }
template<class In, class Out> inline Out copy(In f, In l, Out o) { for (; f != l; ++f, ++o) *o = *f; return o; }
template<class It, class Pred> It stable_partition(It f, It l, Pred p) {
	size_t n = l - f, a = 0, b = 0;
	auto *tmp = (decltype(&*f))malloc(n * sizeof(*f));
	for (It i = f; i != l; ++i) if (p(*i)) f[a++] = *i; else tmp[b++] = *i;
	for (size_t i = 0; i < b; i++) f[a + i] = tmp[i];
	free(tmp);
	return f + a;
}
template<class It, class Cmp> void partial_sort(It f, It m, It l, Cmp c) { (void)m; sort(f, l, c); }
}
#endif
