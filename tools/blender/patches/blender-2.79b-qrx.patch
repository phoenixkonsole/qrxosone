new file mode 100644
index 0000000..8d92783
--- /dev/null
+++ b/intern/qrx/CMakeLists.txt
@@ -0,0 +1,4 @@
+# QRX OS One: the window layer until GHOST has an AROS system.
+# See docs/BLENDER_AROS68K.md in the QRX OS One repository.
+set(INC ../guardedalloc ../ghost ../memutil ../eigen)
+blender_add_lib(bf_intern_ghost "qrx_ghost_stub.c;qrx_ghost_paths.c" "${INC}" "")
diff --git a/intern/qrx/qrx_ghost_paths.c b/intern/qrx/qrx_ghost_paths.c
new file mode 100644
index 0000000..e3a6f43
--- /dev/null
+++ b/intern/qrx/qrx_ghost_paths.c
@@ -0,0 +1,21 @@
+/* The few GHOST calls `blender -b` makes on QRX OS One: where Blender keeps its files.
+ * The rest of GHOST (windows, events) waits for the GUI stage, see docs/BLENDER_AROS68K.md. */
+#include "GHOST_Path-api.h"
+
+GHOST_TSuccess GHOST_CreateSystemPaths(void) { return GHOST_kSuccess; }
+GHOST_TSuccess GHOST_DisposeSystemPaths(void) { return GHOST_kSuccess; }
+const GHOST_TUns8 *GHOST_getSystemDir(int version, const char *versionstr)
+{
+	(void)version; (void)versionstr;
+	return (const GHOST_TUns8 *)"PROGDIR:";
+}
+const GHOST_TUns8 *GHOST_getUserDir(int version, const char *versionstr)
+{
+	(void)version; (void)versionstr;
+	return (const GHOST_TUns8 *)"PROGDIR:user";
+}
+const GHOST_TUns8 *GHOST_getBinaryDir(void)
+{
+	return (const GHOST_TUns8 *)"PROGDIR:";
+}
+void GHOST_addToSystemRecentFiles(const char *filename) { (void)filename; }
