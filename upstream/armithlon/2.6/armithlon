#!/usr/bin/env bash
# ARMITHLON 2.6: QRX68 AmigaOS 3.x ABI compatibility expansion (partial).
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA="${ARMITHLON_DATA_DIR:-$ROOT/data}"
REPO_DIR="$DATA/qrxosone"
AROS_ASSETS="upstream/aros-deadwood/m68k-build-5b5fd4c"
PINNED_SHA="cc2ba06a0cc76a87bdd49edcd4b475df4227e716"
QRX_BRANCH="claude/qrx-22.5.11"
BASE_ISO="$DATA/images/aros-amiga-m68k.iso"
PREVIEW_ISO="$DATA/images/ARMITHLON-AROS-QRX-tools-preview.iso"
QRX_ISO="$DATA/images/QRX-OS-One.iso"
ROM="$REPO_DIR/$AROS_ASSETS/aros-amiga-m68k-rom.bin"
EXT="$REPO_DIR/$AROS_ASSETS/aros-amiga-m68k-ext.bin"
ADF="$REPO_DIR/$AROS_ASSETS/bootdisk-amiga-m68k-3520.adf"
EXPECTED_XZ=11569c3364032a33b4e12b9c0cebadcaec2ea3a8decf7849d4a9d92bb763fded
EXPECTED_ISO=352a87fa2a1e378dbe879cac3ac15feb42088906ee0a8c480f3b22e136ea13bb
EXPECTED_HUNK=51ceca2ba8ac0e3e75947836d695061d581829e46daa15d8bad481e4c6907299
say(){ printf '[ARMITHLON] %s\n' "$*" >&2; }
die(){ say "ERROR: $*"; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Missing '$1'. See README-DE.md for installation."; }
sha256(){ if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'; elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else die 'Need shasum or sha256sum'; fi; }
verify_file(){ [[ -f "$1" ]] || die "Missing file: $1"; local got; got="$(sha256 "$1")"; [[ "$got" == "$2" ]] || die "SHA-256 mismatch for $1: got $got expected $2"; }
usage(){ cat <<'EOF'
ARMITHLON 2.6 macOS/ARM64 QRX OS One integration development kit
  ./armithlon qrx68 APP.HUNK [--share DIR] [--share-rw]  isolated AmigaOS 3.x Exec/DOS HLE
  ./armithlon qrx68-service            run QRX68/1 host service on QRXBRIDGE: share
  ./armithlon qrx68-aros-build          cross-compile AROS/68k QRX68Run via QRX_AROS_CC
  ./armithlon qrx68-aros-install SYS_DIR  install QRX68Run in extracted AROS SYS:
  ./armithlon qrx68-aros-start [SYS_DIR]   QRX68/2 live service + FS-UAE (requires AROS toolchain)
  ./armithlon qrx68-demo               run real Amiga HUNK/Exec/DOS-HLE demo offline
  ./armithlon qrx68-live-test          verify two concurrent interactive HUNK apps + IDCMP frames
  ./armithlon qrx68-compat-test        test Exec signals/ports, menus/gadgets, layered GUI + DOS ABI
  ./armithlon qrx68-compat-scan DIR    bounded batch scan of owned Amiga HUNK programs
  ./armithlon qrx68-musashi APP.HUNK     use the complete, pinned Musashi 68040 engine
  ./armithlon qrx68-gui-demo [IMAGE.ppm] opt-in Intuition+graphics offscreen demo
  ./armithlon qrx68-test               verify Amiga HUNK, Exec/DOS ABI, host files and strict failure
  ./armithlon workstation              boot one-click QRX workspace (native firmware; Mac GUI or CLI)
  ./armithlon amigaos3 --kickstart ROM --system-dir FOLDER [--share DIR]  real AmigaOS3 guest in FS-UAE
  ./armithlon gui                     boot QRX68100 firmware in a Cocoa desktop window (Mac)
  ./armithlon build-qrx-app           build Finder-launchable QRX OS One .app (Mac)
  ./armithlon boot                    boot usable QRX68100 68k firmware shell (offline)
  ./armithlon boot --share DIR        mount a real host directory read-only as HOST:
  ./armithlon boot --volatile-disk --share DIR  boot with no disk image at all
  ./armithlon boot --share DIR --share-rw  explicitly opt in to guest writes
  ./armithlon boot --ram auto         default: min(host/4, 3840 MiB); sparse reservation
  ./armithlon boot --ram-mib 2048     manual guest 32-bit RAM size up to 3840 MiB
  ./armithlon boot --script FILE      run commands through the actual 68k guest
  ./armithlon boot-full               same shell with optional Musashi 68040 backend
  ./armithlon boot-full --dual        two real Musashi guest CPU contexts (diagnostic, not OS SMP)
  ./armithlon app-inspect PATH        recognize PE32/ELF32/QEX1/HUNK by binary header
  ./armithlon app-launch PATH         launch PE32/i386 or Linux/i386 through built QRX86 runtime
  ./armithlon qrxdesktop-patch       patch existing QRXDesktop source (does not replace GUI)
  ./armithlon qrxdesktop-qrx68-patch guarded QRXMODE=QRX68 ToolType extension (needs AROS guest handler)
  ./armithlon aros-native-status     machine-readable missing prerequisites for native AROS on QRX68100
  ./armithlon hostfs-test            test real shared filesystem MMIO and safety
  ./armithlon smp-ready-test         test affinity/shared ready queue (not AROS Exec SMP)
  ./armithlon boot-rom                create reproducible 256-KB guest boot-RAM image
  ./armithlon boot-test               boot and exercise shell + persistent disk offline
  ./armithlon desktop                 start AROS GUI via FS-UAE (verified external files required)
  ./armithlon vampire-test            68080-inspired L1/vector64/legacy tests (CPU mock)
  ./armithlon vampire-bench [N]       native host SIMD API microbenchmark, not 68k MHz
  ./armithlon dualcore-demo [dual]   2x 68040 demo (dual requires QRX mode; default 1 core)
  ./armithlon dualcore-test          68040 SMP + cache tests (Musashi required)
  ./armithlon dualcore-parallel-test  2 host workers fast 68k loops (stub-based portable check)
  ./armithlon dualcore-parallel-bench [N]  real Musashi contexts + 2 native ARM64 JIT loops (Mac)
  ./armithlon full68k-setup          fetch SHA-pinned open-source Musashi 68000–68040 CPU
  ./armithlon full68k-build          compile full 680x0 backend with QRX bus and IRQ
  ./armithlon full68k-test           run real 680x0 instruction, ROM, timer and IRQ tests
  ./armithlon full68k-run [ARGS]    run QRX monitor on Musashi CPU (default 68040)
  ./armithlon full68k-probe-rom ROM  diagnostic ROM probe ONLY (no AROS boot claim)
  ./armithlon build-crossbench        compile matching native/ELF32/PE32 workload
  ./armithlon benchmark-qrx86 [N]    compare actual PE32 and ELF32 QRX86 execution (median N runs)
  ./armithlon bench-prboom [args...]  launch real guest Windows/Linux PrBoom tests (requires game files)
  ./armithlon boot-qrx-compat        boot real AROS 68k with checked QRX 22.5.12 tools under FS-UAE
  ./armithlon x11-input-test        check new bidirectional Linux/X11 input patch
  ./armithlon doctor              inspect local tools
  ./armithlon build               build experimental QRX68100 CPU/JIT with CMake
  ./armithlon test                run CTest and QRX CPU boot-monitor smoke
  ./armithlon demo                run chipset-less monitor with JIT enabled
  ./armithlon run-native          START Metal/CoreAudio/Cocoa diagnostic window (macOS only)
  ./armithlon build-app           build a Finder-launchable ARMITHLON-Native.app (macOS only)
  ./armithlon run-app             open ARMITHLON-Native.app in Finder
  ./armithlon gpu-test            dedicated 68k GPU mailbox + DMA test
  ./armithlon glide-test          QRX3D 3dfx-style triangle/texture/depth/alpha tests
  ./armithlon qrx86-gpu-test      native QRX86 Win32 DirectDraw surface -> Metal packet tests
  ./armithlon build-qrx86-host    compile QRX86 22.5.12 PE interpreter with GPU + input hooks
  ./armithlon build-qrx86-linux-host    NEW compile latest QRX i386+X11 host GPU bridge
  ./armithlon run-linux-x11 PROGRAM [ARGS]  NEW run Linux i386 GUI -> macOS Metal
  ./armithlon x11-bridge-test      X11 native GPU socket and patch checks
  ./armithlon run-native-qrx86    start Metal window and receive QRX86 Win32 frames via Unix socket
  ./armithlon run-qrx86 EXE ...  run PE through QRX86 host GDI/DirectDraw + interactive input
  ./armithlon send-qrx86-demo    send animated synthetic Win32 surface to the Metal window
  ./armithlon vulkan-test         Vulkan 0.8 transfer-only 2D clear/rect/image + GPU readback
  ./armithlon vulkan3d-test       NEW Vulkan offscreen actual triangle graphics pipeline + depth/blend state
  ./armithlon qrx86-gl-test       NEW OpenGL 1.x subset and Q86C command socket regression tests
  ./armithlon benchmark [N]     QRX3D/GL/CPU + actual Metal/Vulkan GPU comparisons;
                                  report in reports/latest (N=frames, default 60)
  ./armithlon benchmark-quick   fast diagnostic, 10 measured frames
  ./armithlon benchmark-all [N]  internal suite + glmark2/vkmark if installed, keep Geekbench manual
  ./armithlon build-pe32-gl-benchmark    compile new real PE32 OpenGL guest benchmark (MinGW)
  ./armithlon run-pe32-gl-benchmark [N]  send real guest OpenGL commands to Metal (Mac, server required)
  ./armithlon benchmark-tools status                 list glmark2/vkmark/Geekbench state
  ./armithlon benchmark-tools fetch [all|glmark2|vkmark]  opt-in upstream source checkout
  ./armithlon benchmark-tools build [all|glmark2|vkmark]  build sources (Linux only)
  ./armithlon benchmark-tools run [all|glmark2|vkmark]    native host GPU tests
  ./armithlon benchmark-geekbench            launch installed Geekbench 7 GUI (Mac)
  ./armithlon benchmark-import-geekbench [--cpu-single N --cpu-multi N --gpu-metal N --gpu-vulkan N --source "note or URL"]
  ./armithlon vulkan-probe        dynamically open Vulkan loader and create a device (legacy probe)
  ./armithlon glide-demo          run the native 68k demo with a colored 3D triangle
  ./armithlon media-test          headless 68k media-MMIO demo and optional PPM dump
  ./armithlon fetch               authenticated sparse checkout of pinned private QRX branch, prepare AROS ISO
  ./armithlon run-aros            launch REAL m68k AROS LiveCD + AROS ROMs in FS-UAE (NOT QRX desktop)
  ./armithlon preview-iso         create AROS LiveCD copy with QRX 22.5.11 tools attached (NOT full QRX)
  ./armithlon run-preview         launch preview ISO in FS-UAE
  ./armithlon run-qrx             launch a REAL QRX build supplied at data/images/QRX-OS-One.iso
  ./armithlon status              show checked artifacts

Important: QRX68100 with optional Musashi expands CPU ISA to 68040; AROS desktop still needs an Amiga-compatible machine.
Full QRX ISO requires external v0.20 payload builder + verified Deadwood reference tar;
see docs/QRX-RELEASE-BUILD.md. No bogus release ISO is generated.
EOF
}
doctor(){
  printf 'Platform: %s / %s\n' "$(uname -s)" "$(uname -m)"
  for c in cmake clang ctest gh git xz unzip fs-uae xorriso python3 meson ninja glmark2 vkmark; do
    if command -v "$c" >/dev/null 2>&1; then printf 'OK      %-12s %s\n' "$c" "$(command -v "$c")";
    else printf 'MISSING %-12s\n' "$c"; fi
  done
  [[ -f "$ROM" ]] && echo 'AROS ROM: present' || echo 'AROS ROM: not fetched'
  [[ -f "$BASE_ISO" ]] && echo 'AROS ISO: present' || echo 'AROS ISO: not fetched'
  printf 'Engine: %s\n' "$ROOT/engine"
  [[ "$(uname -s)" == Darwin ]] && printf 'Native Metal/CoreAudio backend: available for build\n' || printf 'Native Metal/CoreAudio backend: macOS only\n'
}
build(){
  need cmake
  cmake -S "$ROOT/engine" -B "$ROOT/build-qrx68100" -DCMAKE_BUILD_TYPE=RelWithDebInfo
  cmake --build "$ROOT/build-qrx68100" --parallel
  say 'QRX68100 engine built (restricted ARM64 dual-worker fast loop + partial CPU; NOT AROS-compatible).'
}
native_run(){
  [[ "$(uname -s)" == Darwin ]] || die 'The Metal/Cocoa native window requires macOS. Linux has the headless MMIO tests.'
  [[ -x "$ROOT/build-qrx68100/armithlon_native" ]] || build
  exec "$ROOT/build-qrx68100/armithlon_native"
}
make_app(){
  [[ "$(uname -s)" == Darwin ]] || die 'App bundles can only be built on macOS.'
  build
  local app="$ROOT/ARMITHLON-Native.app" dest="$ROOT/ARMITHLON-Native.app/Contents/MacOS"
  mkdir -p "$dest"
  cp "$ROOT/build-qrx68100/armithlon_native" "$dest/armithlon_native"
  chmod +x "$dest/armithlon_native"
  cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>armithlon_native</string>
<key>CFBundleIdentifier</key><string>org.qrxosone.armithlon.nativepreview</string>
<key>CFBundleName</key><string>ARMITHLON Native</string>
<key>CFBundleDisplayName</key><string>ARMITHLON 1.2 Native</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>1.2.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSMinimumSystemVersion</key><string>12.0</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
  if command -v codesign >/dev/null 2>&1; then codesign --force --sign - "$app" || die 'Local app signing failed'; fi
  say "Finder application built: $app"
}
test_vm(){
  [[ -x "$ROOT/build-qrx68100/qrx68100_vm" ]] || build
  need ctest
  ctest --test-dir "$ROOT/build-qrx68100" --output-on-failure
  "$ROOT/build-qrx68100/qrx68100_vm" --jit
  python3 "$ROOT/tools/test-patch-qrx86-x11.py"
}
fetch_assets(){
  need git; need gh; need xz; need unzip
  gh auth status >/dev/null 2>&1 || die 'Private repository: run gh auth login first.'
  # gh auth setup-git configures git to use the already-authenticated gh account; no token bundled.
  gh auth setup-git >/dev/null
  mkdir -p "$DATA" "$DATA/images"
  if [[ ! -d "$REPO_DIR/.git" ]]; then
    say 'Creating sparse checkout of audited latest QRX branch cc2ba06a (source + AROS build artifacts).'
    git clone --no-checkout --depth 1 --filter=blob:none --single-branch \
      --branch "$QRX_BRANCH" "https://github.com/phoenixkonsole/qrxosone.git" "$REPO_DIR"
    git -C "$REPO_DIR" sparse-checkout init --cone
    git -C "$REPO_DIR" sparse-checkout set "$AROS_ASSETS" dist
    git -C "$REPO_DIR" checkout "$QRX_BRANCH"
  fi
  local got
  got="$(git -C "$REPO_DIR" rev-parse HEAD)"
  [[ "$got" == "$PINNED_SHA" ]] || die "QRX branch differs from audited version: $got != $PINNED_SHA; no unsigned auto-update."
  local a="$REPO_DIR/$AROS_ASSETS" d="$REPO_DIR/dist"
  verify_file "$a/aros-amiga-m68k-5b5fd4c.iso.xz" "$EXPECTED_XZ"
  verify_file "$a/aros-amiga-m68k-rom.bin" 21b58d6f28277df2609e6d9536d8a7150a4be628ea05de3b2c46a49847b7859b
  verify_file "$a/aros-amiga-m68k-ext.bin" 76ed0506c7e3af39b09aa7266423b05a379edc64f9710201731f8b625909c7b7
  verify_file "$a/bootdisk-amiga-m68k-3520.adf" f8bf71bc968f9774caefb9eae4aad078c2c304f2cb6bc459e1a569a665460e2a
  verify_file "$d/QRX-OS-One-22.5.11-m68k-HUNK-binaries.zip" "$EXPECTED_HUNK"
  verify_file "$d/QRX-OS-One-22.5.11-CUMULATIVE-SOURCE.zip" f10f4c699eba01e27c8e9eded4f1f0e47ff962a22254a7effb89b3b80434accf
  if [[ ! -f "$BASE_ISO" ]]; then
    say 'Decompressing verified AROS base LiveCD (not QRX release).'
    xz -dc "$a/aros-amiga-m68k-5b5fd4c.iso.xz" > "$BASE_ISO.tmp"
    mv "$BASE_ISO.tmp" "$BASE_ISO"
  fi
  verify_file "$BASE_ISO" "$EXPECTED_ISO"
  say 'Source, ROM/ADF and base AROS ISO validated. The full QRX ISO is NOT in the repository.'
}
config_fsuae(){
  local iso="$1" config="$DATA/config/armithlon.fs-uae"
  mkdir -p "$DATA/config" "$DATA/home" "$DATA/work"
  [[ -f "$ROM" && -f "$EXT" && -f "$ADF" && -f "$iso" ]] || die 'Missing ROM, floppy, or ISO; run fetch first.'
  cat > "$config" <<CONF
[fs-uae]
amiga_model = A4000/040
cpu = 68040
kickstart_file = $ROM
kickstart_ext_file = $EXT
chip_memory = 2048
motherboard_ram = 16384
zorro_iii_memory = 262144
graphics_card = uaegfx
graphics_memory = 131072
uae_gfxcard_size = 128
floppy_drive_0 = $ADF
floppy_drive_count = 1
cdrom_drive_0 = $iso
hard_drive_0 = $DATA/work
hard_drive_0_label = QRXDATA
hard_drive_0_priority = -128
$( if [[ -n "${QRX68_BRIDGE_DIR:-}" ]]; then
     [[ "$QRX68_BRIDGE_DIR" != *$'\n'* && "$QRX68_BRIDGE_DIR" != *$'\r'* ]] || die 'Invalid QRX68_BRIDGE_DIR newline'
     printf 'hard_drive_1 = %s\nhard_drive_1_label = QRXBRIDGE\nhard_drive_1_priority = -128\n' "$QRX68_BRIDGE_DIR"
   fi )
$( if [[ -n "${QRX68_AROS_SYS_DIR:-}" ]]; then
     [[ "$QRX68_AROS_SYS_DIR" != *$'\n'* && "$QRX68_AROS_SYS_DIR" != *$'\r'* ]] || die 'Invalid QRX68_AROS_SYS_DIR newline'
     printf 'hard_drive_2 = %s\nhard_drive_2_label = AROSSYS\nhard_drive_2_priority = 6\n' "$QRX68_AROS_SYS_DIR"
   fi )
jit_compiler = 0
sound_card = none
warp_mode = 0
automatic_input_grab = 0
fullscreen = 0
uae_mmu_model = 0
base_dir = $DATA/home
log_flush = 1
CONF
  printf '%s\n' "$config"
}
run_fsuae(){
  local iso="$1" cfg
  need fs-uae
  cfg="$(config_fsuae "$iso")"
  say 'Starting FS-UAE compatibility mode (AROS/68k; NO ARM64 JIT and NO chipsetless QRX68100).'
  fs-uae "$cfg"
}
preview(){
  [[ -f "$BASE_ISO" ]] || fetch_assets
  need xorriso; need unzip
  local archive="$REPO_DIR/dist/QRX-OS-One-22.5.11-m68k-HUNK-binaries.zip"
  verify_file "$archive" "$EXPECTED_HUNK"
  "$ROOT/tools/make-preview-iso.sh" "$BASE_ISO" "$archive" "$PREVIEW_ISO"
}
status(){
  printf 'Pinned source: %s @ %s\n' "$QRX_BRANCH" "$PINNED_SHA"
  for pair in "Engine:$ROOT/build-qrx68100/qrx68100_vm" "AROS base ISO:$BASE_ISO" "QRX tools preview ISO:$PREVIEW_ISO" "Actual QRX release ISO:$QRX_ISO"; do
    label="${pair%%:*}"; file="${pair#*:}"
    [[ -f "$file" ]] && printf 'PRESENT %s (%s bytes)\n' "$label" "$(wc -c < "$file" | tr -d ' ')" || printf 'ABSENT  %s\n' "$label"
  done
}
# Keep user data outside the extracted source folder so upgrading does not wipe it.
boot_disk_default(){
  if [[ -n "${QRX_BOOT_DISK:-}" ]]; then printf '%s\n' "$QRX_BOOT_DISK"; return; fi
  if [[ "$(uname -s)" == Darwin ]]; then
    printf '%s\n' "${HOME}/Library/Application Support/QRX OS One/qrxfs-1.img"
  else
    printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/qrxosone/qrxfs-1.img"
  fi
}
launch_boot(){
  local exe="$1";shift
  local disk
  disk="$(boot_disk_default)"
  mkdir -p "$(dirname "$disk")"
  export QRX_BOOT_DISK="$disk"
  if [[ ! -x "$exe" ]]; then
    if [[ "$exe" == *boot_shell_full ]]; then "$ROOT/armithlon" full68k-build
    else build; fi
  fi
  say "Starting CPU-executed QRX68100 firmware shell. Default persistent QRXFS: $disk"
  exec "$exe" "$@"
}
case "${1:-help}" in
  qrx68)
    shift
    [[ $# -ge 1 ]] || die 'Usage: ./armithlon qrx68 [--share DIR] [--share-rw] PROGRAM.HUNK'
    if [[ -x "$ROOT/build-qrx68100-full/qrx68-musashi-run" ]]; then
      exec "$ROOT/build-qrx68100-full/qrx68-musashi-run" "$@"
    fi
    [[ -x "$ROOT/build-qrx68100/qrx68-run" ]] || build
    say 'QRX68 fallback: portable 68k subset. Run full68k-setup, full68k-build for complete Musashi 68040.'
    exec "$ROOT/build-qrx68100/qrx68-run" "$@";;
  qrx68-musashi)
    shift
    [[ -x "$ROOT/build-qrx68100-full/qrx68-musashi-run" ]] || "$ROOT/armithlon" full68k-build
    exec "$ROOT/build-qrx68100-full/qrx68-musashi-run" "$@";;
  qrx68-compat-scan)
    shift
    [[ $# -ge 1 ]] || die 'Usage: ./armithlon qrx68-compat-scan FOLDER [--out JSON]'
    [[ -x "$ROOT/build-qrx68100/qrx68-run" ]] || build
    folder="$1";shift
    local_runtime="$ROOT/build-qrx68100/qrx68-run"
    [[ ! -x "$ROOT/build-qrx68100-full/qrx68-musashi-run" ]] || local_runtime="$ROOT/build-qrx68100-full/qrx68-musashi-run"
    exec python3 "$ROOT/tools/qrx68-compat-scan.py" "$folder" --runtime "$local_runtime" "$@";;
  qrx68-gui-demo)
    shift
    [[ -x "$ROOT/build-qrx68100/qrx68-run" ]] || build
    exe="$ROOT/build-qrx68100/qrx68-run"
    [[ ! -x "$ROOT/build-qrx68100-full/qrx68-musashi-run" ]] || exe="$ROOT/build-qrx68100-full/qrx68-musashi-run"
    target="${1:-$ROOT/qrx68-screen.ppm}"
    extra=()
    if [[ -n "${ARMITHLON_QRX86_SOCKET:-}" && -S "$ARMITHLON_QRX86_SOCKET" ]]; then
      extra=(--gpu-socket "$ARMITHLON_QRX86_SOCKET")
    fi
    "$exe" --experimental-gui --snapshot "$target" "${extra[@]}" "$ROOT/data/qrx68/QRX68-GUI.hunk" || exit $?
    say "QRX68 snapshot: $target";;
  qrx68-demo)
    [[ -x "$ROOT/build-qrx68100/qrx68-run" ]] || build
    exec "$ROOT/build-qrx68100/qrx68-run" "$ROOT/data/qrx68/QRX68-Hello.hunk";;
  qrx68-test)
    [[ -x "$ROOT/build-qrx68100/qrx68_hle_tests" ]] || build
    exec "$ROOT/build-qrx68100/qrx68_hle_tests";;
  help|--help|-h) usage;;
  amigaos3)
    shift
    need python3
    exec python3 "$ROOT/tools/amigaos3-profile.py" "$@";;
  workstation)
    shift
    mkdir -p "$HOME/QRX-Share"
    if [[ "$(uname -s)" == Darwin ]]; then
      export QRX_HOST_SHARE="$HOME/QRX-Share"
      exec "$ROOT/armithlon" gui "$@"
    else
      exec "$ROOT/armithlon" boot --share "$HOME/QRX-Share" "$@"
    fi;;
  gui)
    [[ "$(uname -s)" == Darwin ]] || die 'QRX firmware GUI is macOS-only (CLI: ./armithlon boot).'
    [[ -x "$ROOT/build-qrx68100/qrx68100_desktop_qrx" ]] || build
    exec "$ROOT/build-qrx68100/qrx68100_desktop_qrx";;
  build-qrx-app)
    [[ "$(uname -s)" == Darwin ]] || die 'AppKit .app build requires macOS.'
    [[ -x "$ROOT/build-qrx68100/qrx68100_desktop_qrx" ]] || build
    app="$ROOT/QRX OS One.app"; exe="$app/Contents/MacOS"
    mkdir -p "$exe"
    cp "$ROOT/build-qrx68100/qrx68100_desktop_qrx" "$exe/QRX OS One"
    cat > "$app/Contents/Info.plist" <<'QRXPLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>QRX OS One</string>
<key>CFBundleIdentifier</key><string>org.qrxosone.firmware</string>
<key>CFBundleName</key><string>QRX OS One</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>2.2.0</string>
<key>LSMinimumSystemVersion</key><string>12.0</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
QRXPLIST
