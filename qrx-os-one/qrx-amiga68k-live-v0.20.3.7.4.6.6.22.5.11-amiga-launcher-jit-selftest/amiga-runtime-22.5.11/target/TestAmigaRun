; QRX OS One 22.5.11 - target test for amigarun / amigacheck (QRXAmigaRun)
; Manual: Execute QRX:S/TestAmigaRun   (also run by the FS-UAE harness)
; Every line "QRXTEST <id> rc=<n>" is compared against the expected value by the
; host-side harness (emulator/check-results.py); nothing here needs a human.
FailAt 100
Echo "QRXTEST BEGIN 22.5.11"
MakeDir >NIL: "RAM:QRX Test Dir"
Copy >NIL: QRX:Tests/Amiga/QRXHunkTest "RAM:QRX Test Dir/QRX Hunk Test"
Protect >NIL: "RAM:QRX Test Dir/QRX Hunk Test" +rwed
Echo NOLINE "" >RAM:qrx-empty-file
QRX:C/amigacheck QRX:Tests/Amiga/QRXHunkTest
Echo "QRXTEST T01-check-valid rc=$RC"
QRX:C/amigarun QRX:Tests/Amiga/QRXHunkTest RC=7 "two words" plain
Echo "QRXTEST T02-run-rc7-args rc=$RC"
QRX:C/amigarun "RAM:QRX Test Dir/QRX Hunk Test" spaced
Echo "QRXTEST T03-run-path-with-spaces rc=$RC"
QRX:C/amigarun "RAM:QRX Test Dir/QRX Hunk Test" RC=5
Echo "QRXTEST T04-run-rc5-warn rc=$RC"
QRX:C/amigacheck QRX:Tests/Amiga/QRXHunkTestNeedLib
Echo "QRXTEST T05-check-missing-library rc=$RC"
QRX:C/amigarun QRX:Tests/Amiga/QRXHunkTestNeedLib
Echo "QRXTEST T06-run-missing-library rc=$RC"
QRX:C/amigarun STRICT QRX:Tests/Amiga/QRXHunkTestNeedLib
Echo "QRXTEST T07-strict-refuses rc=$RC"
QRX:C/amigacheck RAM:qrx-does-not-exist
Echo "QRXTEST T08-check-missing-path rc=$RC"
QRX:C/amigarun RAM:qrx-does-not-exist
Echo "QRXTEST T09-run-missing-path rc=$RC"
QRX:C/amigacheck S:Startup-Sequence
Echo "QRXTEST T10-check-script rc=$RC"
QRX:C/amigacheck RAM:qrx-empty-file
Echo "QRXTEST T11-check-empty rc=$RC"
QRX:C/amigacheck QRX:Tests/Amiga/QRXHunkTestTruncated
Echo "QRXTEST T12-check-truncated-hunk rc=$RC"
QRX:C/amigarun QRX:Tests/Amiga/QRXHunkTestTruncated
Echo "QRXTEST T13-run-truncated-refused rc=$RC"
QRX:C/amigacheck QRX:Tests/Amiga/ppc-os4-elf.fixture
Echo "QRXTEST T14-check-ppc-elf rc=$RC"
QRX:C/amigacheck QRX:Tests/Amiga/x86-pe.fixture
Echo "QRXTEST T15-check-x86-pe rc=$RC"
QRX:C/amigacheck C:Dir
Echo "QRXTEST T16-check-system-command rc=$RC"
QRX:C/amigarun C:Echo "QRX echo through amigarun"
Echo "QRXTEST T17-run-system-command rc=$RC"
QRX:C/amigarun ASYNC QUIET QRX:Tests/Amiga/QRXHunkTest async
Echo "QRXTEST T18-run-async rc=$RC"
QRX:C/amigarun "RAM:QRX Test Dir"
Echo "QRXTEST T19-run-directory rc=$RC"
QRX:C/amigarun "unterminated
Echo "QRXTEST T20-bad-quoting rc=$RC"
QRX:C/QRXAmigaRun CHECK QRX:Tests/Amiga/QRXHunkTest
Echo "QRXTEST T21-explicit-check-keyword rc=$RC"
QRX:C/amigarun STACK=65536 QRX:Tests/Amiga/QRXHunkTest RC=3
Echo "QRXTEST T22-run-stack-option rc=$RC"
QRX:C/qrx-jit-selftest
Echo "QRXTEST T23-jit-selftest-static rc=$RC"
Type T:QRX-AmigaRun.log
Echo "QRXTEST END"
